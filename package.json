{
  "name": "sim-portail",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "generate": "npm run generate --workspace=backend",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:deploy": "npm run migrate:deploy --workspace=backend",
    "seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
