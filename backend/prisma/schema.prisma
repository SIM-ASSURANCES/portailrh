// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SOCLE PORTAIL
// ============================================================

model User {
  id                     String    @id @default(cuid())
  fullName               String
  email                  String    @unique
  /// Nullable : un compte créé par invitation par lien (voir CLAUDE.md
  /// "Invitation par lien") n'a pas encore de mot de passe tant que la
  /// personne n'a pas finalisé son compte via `/invitation/[token]`. Un
  /// compte "en attente" se reconnaît à `invitationToken` non nul ET
  /// `passwordHash` nul. La création manuelle classique (admin/users,
  /// `createUserAction`) continue de renseigner ce champ immédiatement,
  /// comme avant.
  passwordHash           String?
  isActive               Boolean   @default(true)
  /// Incrémenté à chaque désactivation ou changement de rôle pour invalider le JWT (SEC-06)
  tokenVersion           Int       @default(0)
  /// Invitation par lien (complémentaire à la création manuelle) : jeton
  /// aléatoire sécurisé, unique, remis à `null` dès l'activation du compte
  /// (`activerInvitationAction`) — jamais réutilisable une fois consommé.
  invitationToken        String?   @unique
  /// Expire 7 jours après la génération du lien (voir `creerInvitationAction`).
  /// Un Admin peut régénérer un nouveau lien (nouveau token + nouvelle
  /// expiration) pour un compte encore en attente si l'ancien a expiré.
  invitationExpiresAt    DateTime?
  /// Jeton de réinitialisation de mot de passe (unique, sécurisé, remis à null après usage)
  resetPasswordToken     String?   @unique
  /// Expire 1 heure après la demande de réinitialisation
  resetPasswordExpiresAt DateTime?
  serviceId              String?
  service                Service?  @relation("ServiceMembres", fields: [serviceId], references: [id])
  /// Services dont ce compte est le responsable (étape « Service » du circuit de validation, 2026-10-06).
  servicesResponsable    Service[] @relation("ServiceResponsable")
  photoUrl               String?   @default("/default-avatar.svg")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  demandesCreees                Demande[]                  @relation("DemandeCreateur")
  demandesBeneficiees           Demande[]                  @relation("DemandeBeneficiaire")
  /// Demandes dont ce DG a approuvé la "validation complète" (verrou de clôture, Ticket 7).
  demandesApprouveesDG          Demande[]                  @relation("DgApprobateurValidationComplete")
  demandesDecideesFinance       Demande[]                  @relation("DemandeDecideurFinance")
  demandesReorienteesVersMoi    Demande[]                  @relation("DemandeResponsableEtapeService")
  /// Demandes clôturées de force par ce compte (lot C).
  demandesClotureesDeForce      Demande[]                  @relation("DemandeClotureForceePar")
  reglementsFaits               Reglement[]                @relation("ReglementAuteur")
  retoursDeclares               RetourCaisse[]             @relation("RetourDeclarant")
  retoursReceptionnes           RetourCaisse[]             @relation("RetourReceptionnaire")
  /// Lignes de dépense marquées "non justifiée" par cet utilisateur Finance
  /// (`marquerDepenseNonJustifieeAction`), avec motif obligatoire.
  depensesMarqueesNonJustifiees DepenseLigne[]             @relation("MotifNonJustifiePar")
  /// Lignes de demande décidées (validée OU rejetée) par cet utilisateur
  /// Finance — `validerLignesAction` (voir CLAUDE.md "Validation ligne par
  /// ligne").
  lignesDemandeDecidees         LigneDemande[]             @relation("LigneDemandeDecideur")
  lignesDemandeDecideesFinance  LigneDemande[]             @relation("LigneDemandeDecideurFinance")
  lignesSoumisesAuDG            LigneDemande[]             @relation("LigneDemandeSoumiseDGPar")
  lignesDecideesParDG           LigneDemande[]             @relation("LigneDemandeDecisionDGPar")
  /// Articles dont il est le bénéficiaire PROPRE (autonomie des articles, lot A).
  lignesBeneficiaire            LigneDemande[]             @relation("LigneDemandeBeneficiaire")
  /// Signalements d'erreur sur un retour de caisse — voir CLAUDE.md
  /// "Signalement d'erreur par le Collaborateur".
  signalementsRetourEmis        SignalementRetour[]        @relation("SignalementRetourSignalePar")
  signalementsRetourResolus     SignalementRetour[]        @relation("SignalementRetourResoluPar")
  /// Retours exceptionnels post-clôture saisis / validés par cet utilisateur.
  retoursExceptionnelsSaisis    RetourExceptionnel[]       @relation("RetourExceptionnelSaisiPar")
  retoursExternesCollaborateur  RetourExterne[]            @relation("RetourExterneCollaborateur")
  retoursExternesCrees          RetourExterne[]            @relation("RetourExterneCreePar")
  reinitialisationsSysteme      ReinitialisationSysteme[]
  reinitialisationsPointage     ReinitialisationPointage[]
  /// Lot L : signatures manuscrites enrôlées (une ligne par version) et actions signées.
  signatures                    SignatureUtilisateur[]     @relation("SignatureUtilisateur")
  actionsSignees                ActionSignee[]             @relation("ActionSigneeSignataire")
  actionsSigneesAuNomDe         ActionSignee[]             @relation("ActionSigneeAuNomDe")
  pointageMisEnService          PointageMiseEnService[]
  remboursementsRetourProposes  RemboursementRetour[]      @relation("RemboursementRetourProposePar")
  remboursementsRetourValides   RemboursementRetour[]      @relation("RemboursementRetourValidePar")
  retoursExceptionnelsValides   RetourExceptionnel[]       @relation("RetourExceptionnelValidePar")
  mouvementsBanqueCrees         JournalBanque[]            @relation("JournalBanqueCreePar")
  historique                    HistoriqueEntry[]
  /// Écritures JournalCaisse déclenchées par cet utilisateur (auteur du
  /// règlement pour une SORTIE, receptionneParId pour une ENTRÉE de retour,
  /// ou l'utilisateur ayant annulé un règlement pour une ENTRÉE
  /// compensatoire — section 13 du cahier des charges, traçabilité).
  ecrituresJournalCaisse        JournalCaisse[]            @relation("JournalCaisseUser")

  pointagesEffectues     Pointage[]              @relation("PointageEmploye")
  pointagesRealises      Pointage[]              @relation("PointageEffectuePar")
  correctionsEffectuees  CorrectionPointage[]    @relation("CorrectionEffectuePar")
  absencesDeclarees      Absence[]               @relation("AbsenceEmploye")
  absencesControlees     Absence[]               @relation("AbsenceControlePar")
  /// Justifications de retard / départ anticipé décidées (acceptées ou refusées) par ce compte (pointage V2).
  justificationsDecidees JustificationPointage[] @relation("JustificationPointageDecideur")
  notifications          Notification[]
  /// Tokens FCM (notifications push, voir CLAUDE.md côté Thierry) —
  /// plusieurs appareils/navigateurs possibles par utilisateur.
  fcmTokens              FcmToken[]
  plagesAbsenceAutorisee PlageAbsenceAutorisee[]

  /// Délégations individuelles de permission Trésorerie/Pointage RH que cet
  /// utilisateur a ACCORDÉES à d'autres comptes (voir CLAUDE.md "Délégation
  /// individuelle de permissions"). Toujours des permissions qu'il possède
  /// lui-même via son propre rôle.
  delegationsAccordees PermissionDelegation[] @relation("DelegationDonneur")
  /// Délégations que cet utilisateur a REÇUES d'un autre compte.
  delegationsRecues    PermissionDelegation[] @relation("DelegationBeneficiaire")
  /// Délégations que cet utilisateur a RÉVOQUÉES (en tant que donneur
  /// d'origine, ou en tant qu'Admin) — distinct de `delegationsAccordees` :
  /// un Admin peut révoquer une délégation accordée par quelqu'un d'autre.
  delegationsRevoquees PermissionDelegation[] @relation("DelegationRevoquePar")

  /// Messages FeedbackApp reçus par cet employé — jamais de relation
  /// inverse vers un "auteur" (voir CLAUDE.md "FeedbackApp : anonymat
  /// total", l'auteur n'est structurellement enregistré nulle part).
  feedbacksRecus   Feedback[] @relation("FeedbackRecipient")
  /// Messages FeedbackApp que cet utilisateur a modérés (action RH/DG,
  /// sans rapport avec l'auteur du message).
  feedbacksModeres Feedback[] @relation("FeedbackModeratedBy")

  /// Module Encaissements (docs/encaissements-conception.md §5.1) — toutes en `onDelete: Restrict`.
  encAudits                       EncAudit[]                  @relation("EncAuditUser")
  encMisesEnService               EncMiseEnService[]          @relation("EncMiseEnServiceActiveePar")
  encParametresMaj                EncParametre[]              @relation("EncParametreMajPar")
  /// Paramètres Trésorerie (lot I) : `SetNull` (le changement reste tracé dans `HistoriqueEntry`).
  parametresTresorerieMaj         ParametreTresorerie[]       @relation("ParametreTresorerieMajPar")
  budgetsSoumis                   BudgetParametrage[]         @relation("BudgetParametrageSoumisPar")
  budgetsDecides                  BudgetParametrage[]         @relation("BudgetParametrageDecidePar")
  depassementsDemandes            BudgetDepassement[]         @relation("BudgetDepassementDemandePar")
  depassementsConfirmes           BudgetDepassement[]         @relation("BudgetDepassementConfirmePar")
  encPiecesDeposees               EncPieceJointe[]            @relation("EncPieceJointeDeposeePar")
  /// Paramètres V2 (docs/encaissements-conception.md §5.2) — toutes en `onDelete: Restrict`, sauf les créateurs des
  /// deux référentiels dont la toute première ligne est posée par la migration (`creeParId` nul dans ce seul cas).
  encBranchesCreees               EncBranche[]                @relation("EncBrancheCreePar")
  encBeneficiairesHonorairesCrees EncBeneficiaireHonoraires[] @relation("EncBeneficiaireHonorairesCreePar")
  encPartenairesCrees             EncPartenaire[]             @relation("EncPartenaireCreePar")
  encPartenairesMajs              EncPartenaire[]             @relation("EncPartenaireMajPar")
  encTauxControleMajs             EncTauxControle[]           @relation("EncTauxControleMajPar")
  /// Import F1 (docs/encaissements-conception.md §5.3/§5.5) — toutes en `onDelete: Restrict`.
  encImportsFaits                 EncImport[]                 @relation("EncImportImportePar")
  encImportsValides               EncImport[]                 @relation("EncImportValidePar")
  encEncaissementsSaisis          EncEncaissement[]           @relation("EncEncaissementSaisiPar")
  encEncaissementsConfirmes       EncEncaissement[]           @relation("EncEncaissementConfirmePar")
  encEncaissementsNonRecus        EncEncaissement[]           @relation("EncEncaissementNonRecuPar")
  encSignalementsTraites          EncSignalement[]            @relation("EncSignalementTraitePar")

  // Congés
  congesDemandes  DemandeConge[] @relation("CongeDemandeur")
  congesCrees     DemandeConge[] @relation("CongeCreateur")
  congesApprouves DemandeConge[] @relation("CongeApprobateur")
  congesValides   DemandeConge[] @relation("CongeValidateur")
  congesAnnules   DemandeConge[] @relation("CongeAnnulateur")

  /// Module Gestion Compta (docs/compta-conception.md §5.2) — toutes en `onDelete: Restrict`.
  cptAudits             CptAudit[]            @relation("CptAuditUser")
  cptMisesEnService     CptMiseEnService[]    @relation("CptMiseEnServiceActiveePar")
  cptParametresMaj      CptParametre[]        @relation("CptParametreMajPar")
  cptPiecesDeposees     CptPieceJointe[]      @relation("CptPieceJointeDeposeePar")
  cptPeriodesCloturees  CptPeriode[]          @relation("CptPeriodeCloturePar")
  cptTauxTcaCrees       CptTauxTca[]          @relation("CptTauxTcaCreePar")
  cptConventionsCreees  CptConvention[]       @relation("CptConventionCreePar")
  cptContratsCrees      CptContrat[]          @relation("CptContratCreePar")
  cptActesCrees         CptActe[]             @relation("CptActeCreePar")
  cptImportsFaits       CptImport[]           @relation("CptImportCreePar")
  cptAnomaliesTraitees  CptAnomalie[]         @relation("CptAnomalieTraiteePar")
  cptEncaissementsCrees CptEncaissement[]     @relation("CptEncaissementCreePar")
  cptTransfertsCrees    CptTransfertInterne[] @relation("CptTransfertCreePar")
  cptChequesCrees       CptCheque[]           @relation("CptChequeCreePar")
  cptRattachementsProposes  CptRattachement[] @relation("CptRattachementProposePar")
  cptRattachementsConfirmes CptRattachement[] @relation("CptRattachementConfirmePar")
  cptRattachementsValides   CptRattachement[] @relation("CptRattachementValidePar")
  cptRattachementsRejetes   CptRattachement[] @relation("CptRattachementRejetePar")
  cptRelancesFaites         CptRelance[]      @relation("CptRelanceCreePar")
  cptPromessesCreees        CptPromesse[]     @relation("CptPromesseCreePar")
  cptLignesTaxeCreees       CptLigneTaxe[]       @relation("CptLigneTaxeCreePar")
  cptDeclarationsTcaFaites  CptDeclarationTca[]  @relation("CptDeclarationTcaDeclarePar")
  cptPaiementsTcaFaits      CptDeclarationTca[]  @relation("CptDeclarationTcaPayePar")
  cptLignesRemunerationCreees  CptLigneRemuneration[]        @relation("CptLigneRemunerationCreePar")
  cptDecisionsRemuneration     CptDecisionModeRemuneration[] @relation("CptDecisionModeRemunerationCreePar")
  cptReglementsPartenaireFaits CptReglementPartenaire[]      @relation("CptReglementPartenaireCreePar")
  cptCompensationsValidees     CptCompensation[]             @relation("CptCompensationValideePar")
  cptAnnulationsRemuneration   CptAnnulationRemuneration[]   @relation("CptAnnulationRemunerationCreePar")
}

model Role {
  id                             String           @id @default(cuid())
  name                           String           @unique
  description                    String?
  /// Accès à la console d'administration (`/admin/*`), voir `isAdmin()`
  /// dans `backend/src/permissions.ts`. Remplace l'ancienne comparaison
  /// littérale `role.name === "Admin"` — un rôle combiné (ex: "Admin /
  /// Collaborateur") peut désormais porter cet accès sans s'appeler
  /// "Admin". Indépendant du système de permissions par module
  /// (`RolePermission`) : cocher `estAdmin` ne donne AUCUNE permission
  /// métier (`treso.*`, `pointage.*`), exactement comme avant.
  estAdmin                       Boolean          @default(false)
  /// Éligibilité à être BÉNÉFICIAIRE d'une délégation individuelle de
  /// permission (voir CLAUDE.md "Délégation individuelle de permissions").
  /// Champ dédié plutôt qu'une comparaison sur le nom du rôle
  /// (`role.name === "Collaborateur"`) — même principe que `estAdmin`
  /// ci-dessus ("estAdmin remplace le nom de rôle") : un rôle combiné ou
  /// renommé peut porter cette éligibilité sans s'appeler littéralement
  /// "Collaborateur". Indépendant de `estAdmin` et de `RolePermission` :
  /// ne donne AUCUN droit, contrôle uniquement qui peut apparaître comme
  /// bénéficiaire sélectionnable sur `/delegations`.
  peutEtreBeneficiaireDelegation Boolean          @default(false)
  /// FeedbackApp (voir CLAUDE.md "FeedbackApp") — détermine si les User
  /// portant ce rôle apparaissent comme destinataires proposables sur
  /// `/feedback/nouveau`. Champ dédié plutôt qu'une comparaison sur le nom
  /// du rôle (`role.name === "Admin"`) — même principe que `estAdmin`/
  /// `peutEtreBeneficiaireDelegation` ci-dessus : un rôle combiné (ex:
  /// "Admin / Collaborateur", qui porte `estAdmin: true` mais représente un
  /// vrai employé) reste proposable, alors que le rôle "Admin" (compte
  /// technique, pas un employé à évaluer) ne l'est pas. `DEFAULT true` :
  /// n'importe quel rôle propose ses comptes par défaut, seul un rôle
  /// explicitement marqué `false` en est exclu — pas un invariant de
  /// sécurité critique comme `estAdmin` (figé à la création) : librement
  /// modifiable à tout moment depuis `/admin/roles`, même principe que
  /// `peutEtreBeneficiaireDelegation`.
  peutRecevoirFeedback           Boolean          @default(true)
  users                          User[]
  permissions                    RolePermission[]
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  label       String
  isActive    Boolean      @default(true)
  permissions Permission[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  roles       RolePermission[]
  delegations PermissionDelegation[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// Délégation individuelle d'une permission Trésorerie/Pointage RH à un
/// compte utilisateur DÉJÀ EXISTANT — aucune création de compte ici (voir
/// CLAUDE.md "Délégation individuelle de permissions"). Accordée par un
/// utilisateur qui possède lui-même cette permission via son propre rôle
/// (`session.rolePermissions`, jamais via une délégation qu'il aurait
/// lui-même reçue — interdit toute chaîne de délégation en cascade, vérifié
/// dans `accorderDelegationAction`).
///
/// **L'accès effectif du bénéficiaire est recalculé DYNAMIQUEMENT à chaque
/// session** (voir `getSession()`, `frontend/src/lib/auth.ts`) : une ligne
/// `estActive: true` ne suffit pas — le donneur doit ENCORE posséder cette
/// permission via son rôle au moment de la vérification. Si le rôle du
/// donneur change et perd cette permission, le bénéficiaire perd
/// automatiquement l'accès délégué correspondant, sans révocation manuelle.
///
/// **Jamais d'édition silencieuse** (même principe que `RetourCaisse.estAnnule`/
/// `Reglement.estAnnule`, voir "Règles métier impératives") : une révocation
/// ne supprime ni ne réécrit la ligne, elle la marque `estActive: false` avec
/// `revokedAt`/`revokedById`. Un nouvel octroi après révocation crée une
/// NOUVELLE ligne (jamais de réactivation de l'ancienne) : l'historique
/// complet de tous les octrois/révocations reste intégralement
/// reconstituable, jamais réécrit.
model PermissionDelegation {
  id             String     @id @default(cuid())
  beneficiaireId String
  beneficiaire   User       @relation("DelegationBeneficiaire", fields: [beneficiaireId], references: [id])
  donneurId      String
  donneur        User       @relation("DelegationDonneur", fields: [donneurId], references: [id])
  permissionId   String
  permission     Permission @relation(fields: [permissionId], references: [id])

  estActive   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("DelegationRevoquePar", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([beneficiaireId])
  @@index([donneurId])
  @@index([permissionId])
}

model HistoriqueEntry {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Lot L bis : action signée dont cette ligne est une conséquence (posée à la création, dans la même transaction que
  /// l'action). Vide pour une ligne qui n'est pas la suite d'une action signée, ou antérieure au lot L bis.
  actionSigneeId String?
  actionSignee   ActionSignee? @relation(fields: [actionSigneeId], references: [id], onDelete: SetNull)

  // PERF-06 : Index composé (entity + entityId) pour les requêtes
  // "tous les historiques d'une Demande/User/etc." qui filtrent sur les deux.
  // Index sur createdAt pour les tris chronologiques et les recherches par
  // période (ex: derniereActivations dans le CRON d'absences).
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@index([actionSigneeId])
}

/// Niveaux de priorité des notifications (routage des canaux)
enum NotificationPriority {
  CRITIQUE // Email + FCM Push + In-app
  IMPORTANT // FCM Push + In-app
  INFO // In-app uniquement
}

/// Catégories fonctionnelles des notifications
enum NotificationCategory {
  TRESORERIE
  POINTAGE
  RH
  ADMIN
  SYSTEME
}

model Notification {
  id        String               @id @default(cuid())
  titre     String
  message   String
  lien      String?
  estLue    Boolean              @default(false)
  priority  NotificationPriority @default(INFO)
  category  NotificationCategory @default(SYSTEME)
  pushSent  Boolean              @default(false)
  emailSent Boolean              @default(false)
  createdAt DateTime             @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, estLue, createdAt])
}

/// Tokens FCM d'un utilisateur (multi-navigateurs / multi-appareils)
model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// MODULE 1 — TRÉSORERIE
// ============================================================

/// Refonte V1 (cahier des charges réécrit) : remplace l'ancien enum à 5
/// valeurs. Les statuts intermédiaires (PARTIELLEMENT_VALIDEE,
/// VALIDEE_NON_REGLEE, PARTIELLEMENT_REGLEE, REGLEE, EN_ATTENTE_REGULARISATION,
/// REGULARISEE) ne sont pas encore produits par la logique applicative
/// actuelle (celle-ci reste, pour l'instant, mappée sur les anciennes
/// transitions EN_ATTENTE_VALIDATION -> VALIDEE -> CLOTUREE — voir CLAUDE.md,
/// section "Refonte V1 en cours") : ils sont posés ici en fondation pour les
/// phases B à H (validation partielle, règlement adapté, régularisation).
enum StatutDemande {
  BROUILLON
  EN_ATTENTE_VALIDATION
  VALIDEE
  PARTIELLEMENT_VALIDEE
  VALIDEE_NON_REGLEE
  PARTIELLEMENT_REGLEE
  REGLEE
  REJETEE
  EN_ATTENTE_REGULARISATION
  REGULARISEE
  CLOTUREE
  /// Abandonnée par le demandeur depuis « À corriger » (circuit de validation, 2026-10-06) : état terminal, comme
  /// REJETEE (qui ne reste que pour les anciennes demandes) et CLOTUREE.
  ABANDONNEE
}

/// Étape du circuit de validation (2026-10-06, moteur : backend/src/circuitDemande.ts). Distincte de `statut`, qui
/// reste piloté par `calculerStatutDemande` (montants validés et réglés) : une demande reste EN_ATTENTE_VALIDATION
/// pendant tout le circuit. TERMINEE = décision finale prise (puis cycle de règlement), et aussi toute demande
/// antérieure au circuit déjà décidée, rejetée ou clôturée.
enum EtapeCircuit {
  SERVICE
  FINANCE
  DG
  REJET_DG
  DECISION_FINALE
  TERMINEE
  A_CORRIGER
  ABANDONNEE
}

/// Étape DG d'une demande : jamais (demande du DG), possible si Finance soumet, ou imposée (demande de la Finance).
enum ModeEtapeDG {
  NON_REQUISE
  OPTIONNELLE
  OBLIGATOIRE
}

/// Niveau qui a rejeté une demande (renvoi en correction, ou rejet par le DG).
enum NiveauRejet {
  SERVICE
  FINANCE
  DG
}

/// Statut de validation d'une `LigneDemande` — Tâche "Validation ligne par
/// ligne" (voir CLAUDE.md) : remplace, pour toute demande ayant au moins
/// une ligne, la saisie manuelle d'un montant partiel par une décision
/// individuelle par ligne d'article. `EN_ATTENTE` par défaut, jamais
/// dévalidée une fois `VALIDEE`/`REJETEE` (même principe qu'ailleurs dans
/// le module : aucune fonction de "dévalidation" nulle part).
enum StatutLigneDemande {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

/// Décision du DG sur une ligne soumise par la Finance (2026-10-10). `null` sur la ligne = en attente du DG.
enum DecisionLigneDG {
  VALIDEE
  REFUSEE
}

/// Type de bénéficiaire d'une Demande — distinct du Demandeur (créateur).
/// Rempli uniquement pour COLLABORATEUR/STAGIAIRE ayant un compte
/// (`beneficiaireUserId`) ; sinon le nom est saisi librement
/// (`beneficiaireNom`), y compris pour ENTREPRISE ("SIM ASSURANCES CI").
enum BeneficiaireType {
  COLLABORATEUR
  STAGIAIRE
  FOURNISSEUR
  ENTREPRISE
}

/// Phase F (saisie directe, cahier des charges section 11) : une demande
/// STANDARD suit le circuit habituel (créée par le bénéficiaire ou pour son
/// compte) ; une DEPENSE_DIRECTE est saisie par un utilisateur habilité
/// (Finance, `treso.saisir_depense_directe`) sans intervention du
/// bénéficiaire — le créateur (`Demande.createur`) et le bénéficiaire
/// (`Demande.beneficiaireType`/`beneficiaireUserId`/`beneficiaireNom`,
/// Phase A) sont alors deux personnes distinctes par construction. Une fois
/// créée, une DEPENSE_DIRECTE suit EXACTEMENT le même circuit qu'une
/// demande STANDARD (validation, règlement, fonds remis, clôture) — ce
/// champ ne sert qu'à distinguer l'origine de la création, jamais à
/// dévier la logique des phases suivantes.
enum TypeDemande {
  STANDARD
  DEPENSE_DIRECTE
}

/// Nature d'une dépense saisie directement (Phase F, section 11) —
/// renseignée uniquement si `Demande.typeDemande = DEPENSE_DIRECTE`.
enum NatureDepenseDirecte {
  PRIME_STAGE
  DOTATION_CARBURANT
  DEPENSE_ENTREPRISE
  DEPENSE_COLLECTIVE
  AUTRE
}

enum ModeReglement {
  CAISSE
  BANQUE
}

enum TypeJustification {
  FACTURE
  RECU
  TICKET
  SANS_PIECE
}

model Categorie {
  id       String  @id @default(cuid())
  label    String  @unique
  /// Soft-delete : une catégorie désactivée n'apparaît plus dans les
  /// sélecteurs de nouvelle catégorisation ni les filtres de reporting,
  /// mais reste affichée normalement sur les demandes qui la référencent
  /// déjà (jamais de suppression définitive — Categorie/Objet sont
  /// potentiellement référencés par des Demande existantes).
  isActive Boolean @default(true)
  objets   Objet[]

  /// Budget partagé de la NATURE de dépense que représente cette catégorie
  /// (ex: "Informatique"), pas d'une demande ni d'un service précis — voir
  /// CLAUDE.md "Budget partagé par Catégorie". `null` = aucune limite
  /// définie, aucun contrôle appliqué pour cette catégorie. Décompté au
  /// RÈGLEMENT (pas à la validation) via `getMontantConsommeCategorie`
  /// (`src/lib/tresorerie.ts`) — depuis "Catégorisation par ligne" :
  /// somme des `ReglementCategorieAllocation.montant` de cette catégorie
  /// dont le `Reglement` est confirmé et non annulé (allocation EXPLICITE
  /// choisie par Finance à chaque règlement, jamais un apportionnement
  /// calculé). Aucun renouvellement automatique périodique : un montant
  /// total consommable jusqu'à épuisement, à réajuster manuellement par
  /// l'Admin (`admin/categories`).
  ///
  /// **Lot J (2026-10-19) — ANCIENNE valeur, plus lue.** Le budget d'une catégorie est désormais porté par
  /// `BudgetParametrage` (date d'effet, seuils, validation du DG) ; la migration a copié chaque `budgetAlloue` existant en
  /// paramétrage validé par le DG. Colonne conservée (historique, retour arrière), jamais écrite par l'application.
  budgetAlloue Decimal? @db.Decimal(14, 2)

  demandes             Demande[]                      @relation("DemandeCategorie")
  /// Lignes de demande catégorisées directement (voir CLAUDE.md
  /// "Catégorisation par ligne") — distinct de `demandes` ci-dessus, qui
  /// ne couvre que les `DEPENSE_DIRECTE` depuis cette tâche.
  lignesDemande        LigneDemande[]                 @relation("LigneDemandeCategorie")
  allocationsReglement ReglementCategorieAllocation[]
  /// Paramétrages de budget de cette catégorie (lot J) : seule source du budget EN VIGUEUR (`budgetAlloue` est l'ancienne valeur).
  budgetsParametres    BudgetParametrage[]
}

model Objet {
  id            String         @id @default(cuid())
  label         String
  /// Voir Categorie.isActive — même principe de soft-delete.
  isActive      Boolean        @default(true)
  categorieId   String
  categorie     Categorie      @relation(fields: [categorieId], references: [id])
  demandes      Demande[]
  /// Voir `Categorie.lignesDemande` (CLAUDE.md "Catégorisation par ligne").
  lignesDemande LigneDemande[]
}

model Demande {
  id                   String        @id @default(cuid())
  reference            String        @unique
  /// Montant demandé (nom de champ conservé pour limiter la casse — voir
  /// CLAUDE.md "Refonte V1"). Distinct de `montantValide` ci-dessous.
  montant              Decimal       @db.Decimal(14, 2)
  /// Motif d'en-tête (« Motif de l'achat »). Depuis le motif par ligne (2026-10-09), `null` pour une nouvelle demande
  /// standard : le motif est porté par chaque `LigneDemande.motif`. Conservé tel quel, en lecture seule, sur les
  /// anciennes demandes ; toujours renseigné pour une dépense directe (sa description).
  description          String?
  /// Version ORIGINALE de `description`, immuable une fois posée — voir
  /// CLAUDE.md "Libellé de demande modifiable avec traçabilité permanente".
  /// `null` tant que `description` n'a JAMAIS été modifiée depuis la
  /// création (dans ce cas `description` EST la version originale) ;
  /// renseignée UNE SEULE FOIS, à la toute première modification par
  /// Finance (copie de la valeur d'alors), jamais réécrite ensuite même si
  /// `description` est modifiée à nouveau — `description` porte donc
  /// toujours la version COURANTE, `descriptionOriginale` la version de
  /// départ. Le Collaborateur créateur voit toujours cette version
  /// (jamais `description` si elle diverge) ; Finance voit les deux côte à
  /// côte dès qu'elles divergent.
  descriptionOriginale String?
  commentaire          String?
  statut               StatutDemande @default(EN_ATTENTE_VALIDATION)

  /// Phase F (saisie directe) — voir le commentaire de l'enum
  /// `TypeDemande`. `natureDepenseDirecte` n'est renseignée que si
  /// `typeDemande = DEPENSE_DIRECTE`, jamais pour une demande STANDARD.
  typeDemande          TypeDemande           @default(STANDARD)
  natureDepenseDirecte NatureDepenseDirecte?

  /// Cumul du montant validé à date — nul tant qu'aucune validation
  /// (même partielle) n'a eu lieu. Peut être mis à jour par plusieurs
  /// validations successives (validation complémentaire sur le reliquat,
  /// phase B "validation partielle" — pas encore implémentée).
  montantValide Decimal? @db.Decimal(14, 2)

  /// Bénéficiaire de la dépense, distinct du Demandeur (`createur`) — peut
  /// être différent (ex: le collaborateur demande pour un stagiaire, un
  /// fournisseur, ou l'entreprise elle-même).
  beneficiaireType   BeneficiaireType
  /// Renseigné uniquement si `beneficiaireType` = COLLABORATEUR ou
  /// STAGIAIRE ET que la personne a un compte dans le système.
  beneficiaireUserId String?
  beneficiaireUser   User?            @relation("DemandeBeneficiaire", fields: [beneficiaireUserId], references: [id])
  /// Renseigné si le bénéficiaire n'est pas un utilisateur du système
  /// (nom du fournisseur/prestataire, ou "SIM ASSURANCES CI" pour ENTREPRISE).
  beneficiaireNom    String?

  /// Catégorie d'achat, choisie à la création dans le formulaire "Demande
  /// d'Achat" (réactivée : le cahier des charges V1 l'avait sortie du flux
  /// principal, elle y revient comme champ d'en-tête — voir CLAUDE.md
  /// "Formulaire Demande d'Achat"). C'est cette catégorie, PAS le
  /// demandeur ni son service, qui porte le budget partagé
  /// (`Categorie.budgetAlloue` — voir CLAUDE.md "Budget partagé par
  /// Catégorie") : deux demandeurs différents catégorisant leurs demandes
  /// dans la même Catégorie tapent dans la même enveloppe. `objetId` reste
  /// nullable, non utilisé par ce formulaire (toujours renseigné par
  /// l'ancien écran de catégorisation Finance, Ticket 2).
  categorieId String?
  categorie   Categorie? @relation("DemandeCategorie", fields: [categorieId], references: [id])
  objetId     String?
  objet       Objet?     @relation(fields: [objetId], references: [id])

  /// Champs d'en-tête du formulaire "Demande d'Achat".
  /// `devise` : code ISO (XOF par défaut, EUR, USD).
  dateLivraisonSouhaitee DateTime?
  devise                 String    @default("XOF")

  /// Lignes d'articles (Libellé / Nombre / Prix unitaire). `montant` ci-dessus
  /// est la somme des (quantite × prixUnitaire) — jamais saisi directement.
  lignes             LigneDemande[]
  /// Dépassements de budget (seuil rouge) demandés/confirmés pour cette demande (lot J).
  depassementsBudget BudgetDepassement[]

  /// Motif du dernier rejet : ancien rejet définitif, ou renvoi en correction / rejet DG du circuit (voir
  /// `niveauRejet`).
  motifRejet            String?
  motifCloture          String?
  /// Lot M : motif OBLIGATOIRE (10 à 300 caractères) de chaque échange Finance ↔ DG sur la demande entière — dernier envoi de la
  /// Finance au DG (`motifSoumissionDG`) et dernière réponse du DG à la Finance (`motifDecisionDG` : validation, rejet, approbation
  /// de clôture…). `null` pour les échanges antérieurs au lot M (affichés « Non renseigné ») ; l'historique garde chaque motif.
  motifSoumissionDG     String?
  motifDecisionDG       String?
  /// Lot C : demande clôturée de force (articles non régularisés), avec motif (`motifCloture`, 10 caractères minimum).
  /// Aucune écriture de caisse n'est touchée. `clotureForceeArticles` : instantané des articles non terminés (libellé,
  /// bénéficiaire, montants, solde restant) au moment de la clôture, relu par le reporting et l'affichage.
  clotureForcee         Boolean   @default(false)
  clotureForceeAt       DateTime?
  clotureForceeParId    String?
  clotureForceePar      User?     @relation("DemandeClotureForceePar", fields: [clotureForceeParId], references: [id])
  clotureForceeArticles Json?

  /// Circuit de validation (2026-10-06, voir backend/src/circuitDemande.ts). Pas de valeur par défaut pour
  /// `etapeCircuit` : toute création de demande choisit sa première étape.
  etapeCircuit                 EtapeCircuit
  /// Parcours figé à la soumission (recalculé à chaque resoumission après correction).
  etapeServiceRequise          Boolean      @default(false)
  etapeFinanceRequise          Boolean      @default(true)
  modeEtapeDG                  ModeEtapeDG  @default(OPTIONNELLE)
  /// Soumise au DG par la Finance pendant le tour en cours (étape DG passée ou en cours).
  soumiseAuDG                  Boolean      @default(false)
  /// Demande émise par le DG : l'approbation de clôture n'est pas demandée (mention dans l'historique). Lue
  /// seulement par `approbationClotureObtenue` (tresorerie.ts), avec `validationCompleteParDG`.
  approbationClotureNonRequise Boolean      @default(false)
  /// Niveau du dernier rejet (renvoi en correction ou rejet DG), avec `motifRejet`. `null` hors rejet.
  niveauRejet                  NiveauRejet?
  /// Numéro du tour : 1 à la création, +1 à chaque resoumission après correction (versions dans l'historique).
  tourCircuit                  Int          @default(1)
  /// Entrée dans l'étape courante (posée à chaque changement d'étape) : base des rappels à 48 h.
  etapeCircuitDepuis           DateTime     @default(now())
  /// Dernier rappel envoyé pour cette demande (au plus un par 24 h, voir `circuitNotifications.ts`).
  dernierRappelAt              DateTime?
  /// Compte qui a pris la décision Finance (lignes ou montant) : jamais le même que l'approbateur DG (étape DG ou
  /// approbation de clôture), voir `MESSAGE_DEUX_PERSONNES`. `null` tant qu'aucune décision Finance n'est prise.
  decideurFinanceId            String?
  decideurFinance              User?        @relation("DemandeDecideurFinance", fields: [decideurFinanceId], references: [id])
  /// Lot K : décideur de l'étape Service posé par une RÉORIENTATION (autre responsable de service disponible). `null` =
  /// le responsable ACTUEL du service du demandeur (règle d'origine). Remis à `null` à la resoumission après correction.
  /// Le service du demandeur ne change jamais. Voir `backend/src/circuitReorientation.ts`.
  responsableEtapeServiceId    String?
  responsableEtapeService      User?        @relation("DemandeResponsableEtapeService", fields: [responsableEtapeServiceId], references: [id])
  /// Dernière version de la description écrite par le DEMANDEUR lors d'une correction. `null` = jamais corrigée :
  /// sa version est alors `descriptionOriginale ?? description`. Le demandeur voit toujours sa dernière version.
  descriptionDemandeur         String?

  /// Rejet du reliquat non encore validé d'une demande `PARTIELLEMENT_VALIDEE`
  /// (Finance ou DG, `treso.valider_demande`) — voir CLAUDE.md "Rejet du
  /// reliquat". N'affecte JAMAIS `montantValide` ni le statut : la part déjà
  /// validée reste acquise et suit son cours normal (règlement, clôture).
  /// Bloque uniquement toute future `validerComplementaireAction` sur cette
  /// demande, une fois `true`.
  reliquatRejete     Boolean @default(false)
  motifRejetReliquat String?

  /// Verrou de clôture (Ticket 7, indépendant du circuit de validation
  /// partielle/complémentaire des Phases B/C — celui-ci reste inchangé et
  /// continue de débloquer le RÈGLEMENT via `montantValide` seul). Une
  /// demande ne peut être CLÔTURÉE (totale ou partielle) que si le DG a
  /// donné cette approbation, même si Finance a déjà tout réglé.
  validationCompleteParDG        Boolean   @default(false)
  dgApprobateurId                String?
  dgApprobateur                  User?     @relation("DgApprobateurValidationComplete", fields: [dgApprobateurId], references: [id])
  dgApprouveAt                   DateTime?
  /// `true` tant que le DG a REJETÉ la validation complète sans qu'elle ait
  /// été approuvée depuis : distingue "rejetée" de "jamais examinée"
  /// (`validationCompleteParDG` reste `false` dans les deux cas). Gèle la
  /// création/modification/confirmation de règlement (voir CLAUDE.md
  /// "Le rejet DG gèle le règlement"). Posé par `rejeterValidationCompleteAction`,
  /// remis à `false` uniquement par `approuverValidationCompleteAction`.
  validationCompleteRejeteeParDG Boolean   @default(false)

  createurId String
  createur   User   @relation("DemandeCreateur", fields: [createurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces               PieceJointe[]
  /// Retours exceptionnels post-clôture (voir CLAUDE.md), distincts de `RetourCaisse`.
  retoursExceptionnels RetourExceptionnel[]
  /// Retours externes rattachés à cette demande (lot G bis).
  retoursExternes      RetourExterne[]      @relation("RetourExterneDemande")
  reglements           Reglement[]
  journalCaisse        JournalCaisse[]

  @@index([createurId])
  @@index([statut])
  @@index([beneficiaireUserId])
  // PERF-06 : Index sur categorieId pour les agrégats budget par catégorie
  // (getMontantConsommeCategorie, très sollicité dans le reporting et
  // l'affichage des budgets sur le formulaire de demande).
  @@index([categorieId])
  // PERF-06 : Index sur validationCompleteParDG pour les compteurs DG du
  // dashboard Finance et le filtre "validations en attente DG".
  @@index([validationCompleteParDG, statut])
  @@index([etapeCircuit])
  @@index([responsableEtapeServiceId])
}

/// Stockage local sur disque (`./uploads/`, hors dépôt git — voir
/// `api/treso/pieces-jointes/upload/route.ts`). `url` est un nom de
/// fichier généré côté serveur (jamais dérivé d'une entrée utilisateur),
/// résolu par la route de téléchargement.
model PieceJointe {
  id                   String               @id @default(cuid())
  url                  String
  /// Renseigné pour toute pièce rattachée à une Demande (y compris quand
  /// elle est en réalité attachée à une seule ligne de dépense,
  /// `depenseLigneId` ci-dessous, plutôt qu'à la demande elle-même —
  /// dérivé du contexte au moment de l'upload via
  /// `retourCaisse.reglement.demandeId`). **Nullable depuis "Pièce jointe
  /// obligatoire sur le solde d'ouverture" (voir CLAUDE.md)** : une pièce
  /// rattachée à une écriture `JournalCaisse` du solde d'ouverture
  /// (`journalCaisseId` ci-dessous) n'a, par nature, aucune demande
  /// d'origine — même raisonnement que `JournalCaisse.demandeId`,
  /// assoupli pour la même raison.
  demandeId            String?
  demande              Demande?             @relation(fields: [demandeId], references: [id])
  /// Renseigné uniquement si cette pièce est attachée à une ligne de
  /// dépense précise d'un retour de caisse, plutôt qu'à la demande
  /// elle-même (formulaire de création / dépense directe). `@unique` : une
  /// seule pièce jointe par ligne. `onDelete: Cascade` : si la ligne est
  /// supprimée (modification d'un retour avant réception), sa pièce jointe
  /// disparaît avec elle plutôt que de rester orpheline en base (le
  /// fichier lui-même reste sur disque — V1 volontairement simple, pas de
  /// tâche de nettoyage des fichiers orphelins).
  depenseLigneId       String?              @unique
  depenseLigne         DepenseLigne?        @relation(fields: [depenseLigneId], references: [id], onDelete: SetNull)
  /// Renseigné uniquement pour une pièce jointe attachée à une écriture
  /// `JournalCaisse` du cycle "solde d'ouverture" (`definirSoldeOuvertureAction`/
  /// `corrigerSoldeOuvertureAction`) — le seul cas de pièce jointe sans
  /// Demande d'origine. `@unique` : une seule pièce par écriture.
  journalCaisseId      String?              @unique
  journalCaisse        JournalCaisse?       @relation(fields: [journalCaisseId], references: [id])
  /// Justificatif optionnel d'un retour exceptionnel post-clôture (une seule pièce).
  /// Bordereau de versement d'un retour sur règlement Banque.
  journalBanque        JournalBanque?
  retourExterne        RetourExterne?       @relation("RetourExternePieceRetour")
  retourExterneCheque  RetourExterne?       @relation("RetourExternePieceCheque")
  remboursementRetour  RemboursementRetour?
  retourExceptionnelId String?              @unique
  retourExceptionnel   RetourExceptionnel?  @relation(fields: [retourExceptionnelId], references: [id], onDelete: SetNull)
  /// Pièce jointe PROPRE à un article de la demande (lot A « autonomie des articles »). `demandeId` reste renseigné
  /// (droits d'accès calculés par demande). Vide : pièce de la demande entière, ou d'un autre objet (dépense…).
  /// Pas `@unique` : plusieurs pièces par article. `SetNull` : si l'article est supprimé (correction avant toute
  /// décision), la pièce redevient une pièce de la demande plutôt que de disparaître.
  ligneDemandeId       String?
  ligneDemande         LigneDemande?        @relation(fields: [ligneDemandeId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())

  @@index([ligneDemandeId])
}

/// Ligne d'article d'une Demande d'Achat ("Tableau des articles" du
/// formulaire de création). Le `montant` de la Demande est la somme des
/// (quantite × prixUnitaire) de ses lignes — recalculé côté serveur,
/// jamais saisi directement (même principe que le solde de caisse).
///
/// **Validation ligne par ligne** (voir CLAUDE.md "Validation ligne par
/// ligne") — pour toute demande ayant AU MOINS une ligne,
/// `validerLignesAction` est l'UNIQUE mécanisme de décision (remplace
/// entièrement `validerTotalementAction`/`validerPartiellementAction`/
/// `validerComplementaireAction`/`rejeterReliquatAction` pour ce cas —
/// ces quatre actions restent réservées aux demandes SANS ligne, ex:
/// `DEPENSE_DIRECTE`). Décision UNIQUE ET COMPLÈTE en un seul geste
/// (Option A2 du rapport de diagnostic) : jamais de notion de "reliquat"
/// à traiter plus tard une fois les lignes tranchées, jamais de
/// dévalidation.
model LigneDemande {
  id                    String  @id @default(cuid())
  libelle               String
  quantite              Int
  prixUnitaire          Decimal @db.Decimal(14, 2)
  /// Lot J : reste du budget global et de la catégorie APRÈS la validation de cet article (photo posée une seule fois, à la
  /// première validation — celle du DG ou de la Finance —, jamais recalculée). Gestion interne : jamais montrée au demandeur.
  budgetApresValidation Json?

  /// Version ORIGINALE de `libelle`, immuable une fois posée — même
  /// mécanique exacte que `Demande.descriptionOriginale` (voir CLAUDE.md
  /// "Description du besoin modifiable avec traçabilité permanente") :
  /// `null` tant que `libelle` n'a JAMAIS été modifié depuis la création
  /// (il fait alors office des deux versions à la fois) ; renseignée UNE
  /// SEULE FOIS, à la toute première modification par Finance, jamais
  /// réécrite ensuite. Le Collaborateur créateur voit toujours cette
  /// version (jamais `libelle` si elle diverge) ; Finance voit les deux
  /// côte à côte dès qu'elles divergent.
  libelleOriginal  String?
  /// Dernière version du libellé écrite par le DEMANDEUR lors d'une correction (même principe que
  /// `Demande.descriptionDemandeur`) ; `null` = jamais corrigé.
  libelleDemandeur String?

  /// Motif de la ligne (pourquoi cet article), obligatoire à la création et à la correction (2026-10-09). `null`
  /// seulement pour les lignes antérieures, dont le motif est l'ancien motif d'en-tête (`Demande.description`).
  /// Versions et droits d'édition identiques au libellé : `motifOriginal` (posé une seule fois, à la première
  /// modification par Finance ou par une correction), `motifDemandeur` (dernière version écrite par le demandeur).
  motif          String?
  motifOriginal  String?
  motifDemandeur String?

  /// `EN_ATTENTE` par défaut, posée UNE SEULE FOIS par
  /// `validerLignesAction` (décision unique et complète, jamais de
  /// dévalidation ensuite).
  statutValidation  StatutLigneDemande @default(EN_ATTENTE)
  /// Obligatoire si `statutValidation = REJETEE` (min 3 caractères,
  /// revérifié côté serveur), sinon toujours `null`.
  motifRejet        String?
  /// Auteur et date de la décision (validée OU rejetée) — `null` tant que
  /// `statutValidation = EN_ATTENTE`.
  decideParId       String?
  decidePar         User?              @relation("LigneDemandeDecideur", fields: [decideParId], references: [id])
  decideAt          DateTime?
  /// Compte qui a décidé l'article COMME FINANCE (lot B, 2026-10-15) : sert à la règle des deux personnes par
  /// article. Distinct de `decideParId`, qui garde l'auteur DG pour un article validé par le DG. `null` tant que
  /// l'article n'a pas été décidé par la Finance (ou décidé par le DG seul, cas où la Finance n'a rien décidé).
  decideurFinanceId String?
  decideurFinance   User?              @relation("LigneDemandeDecideurFinance", fields: [decideurFinanceId], references: [id])

  /// Soumission de la ligne au DG par la Finance (2026-10-10, `treso.soumettre_dg`) : seules les lignes soumises sont
  /// vues et décidées par le DG. Une ligne refusée par le DG revient à la Finance (resoumission ou refus définitif).
  /// La décision finale de la ligne reste `statutValidation`, posée à la décision finale de la Finance.
  soumiseAuDG       Boolean          @default(false)
  soumiseDGAt       DateTime?
  soumiseDGParId    String?
  soumiseDGPar      User?            @relation("LigneDemandeSoumiseDGPar", fields: [soumiseDGParId], references: [id])
  /// `null` tant que la ligne soumise attend le DG.
  decisionDG        DecisionLigneDG?
  decisionDGAt      DateTime?
  decisionDGParId   String?
  decisionDGPar     User?            @relation("LigneDemandeDecisionDGPar", fields: [decisionDGParId], references: [id])
  motifRefusDG      String?
  /// Lot M : motif OBLIGATOIRE (10 à 300 caractères) de la dernière soumission de cet article au DG par la Finance, et de la
  /// dernière réponse du DG (validation OU rejet ; `motifRefusDG` reste le motif du rejet, recopié ici). `null` avant le lot M.
  motifSoumissionDG String?
  motifDecisionDG   String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id])

  /// Catégorisation par ligne (voir CLAUDE.md "Catégorisation par ligne") —
  /// même mécanique exacte que `Demande.categorieId`/`objetId` (nullable,
  /// même relations), mais portée par CHAQUE ligne plutôt que par la
  /// demande entière : une demande à plusieurs lignes peut désormais avoir
  /// une catégorie différente par ligne (ex: "Transport" et "Matériel" sur
  /// la même demande). Réservé aux demandes `STANDARD` (qui ont des
  /// lignes) — `Demande.categorieId`/`objetId` restent, eux, l'unique
  /// mécanisme pour `DEPENSE_DIRECTE` (0 ligne, jamais concernée par ces
  /// deux champs). Modifiable uniquement tant que
  /// `statutValidation = EN_ATTENTE` (`categoriserLigneAction`) — même
  /// principe que "Catégorie/objet modifiables uniquement avant
  /// validation", relu à l'échelle de la ligne plutôt que de la demande.
  categorieId String?
  categorie   Categorie? @relation("LigneDemandeCategorie", fields: [categorieId], references: [id])
  objetId     String?
  objet       Objet?     @relation(fields: [objetId], references: [id])

  /// Bénéficiaire PROPRE à l'article (autonomie des articles, lot A, 2026-10-14). `beneficiaireType` vide = l'article
  /// HÉRITE du bénéficiaire par défaut de la demande (`Demande.beneficiaire*`) ; renseigné, les trois champs décrivent
  /// le bénéficiaire de cet article (même règle que la demande : un compte OU un nom libre, jamais les deux). À la
  /// création, un article dont le bénéficiaire égale la valeur commune n'a aucune valeur propre.
  beneficiaireType   BeneficiaireType?
  beneficiaireUserId String?
  beneficiaireUser   User?             @relation("LigneDemandeBeneficiaire", fields: [beneficiaireUserId], references: [id])
  beneficiaireNom    String?

  /// Date de livraison de CET article (lot G, 2026-10-14). Vide pour les articles antérieurs (affichée « — », aucune
  /// reprise) ; à la création, un article sans date propre reçoit la date commune de la demande
  /// (`Demande.dateLivraisonSouhaitee`), copiée telle quelle — jamais un héritage dynamique.
  dateLivraison DateTime? @db.Date

  /// Pièces jointes de CET article (plusieurs possibles). Une pièce de la demande entière (« pièce commune ») n'a
  /// pas de `ligneDemandeId`.
  pieces PieceJointe[]

  /// Règlements de CET article (autonomie des articles, lot D, 2026-10-16) : un règlement concerne un seul article.
  reglements Reglement[]

  /// Retours exceptionnels post-clôture rattachés à CET article (lot E).
  retoursExceptionnels RetourExceptionnel[]
  /// Retours externes (fonds versé par banque, rendu à la caisse) rattachés à CET article (lot G bis).
  retoursExternes      RetourExterne[]      @relation("RetourExterneLigne")

  createdAt DateTime @default(now())

  @@index([beneficiaireUserId])
  @@index([decideurFinanceId])
}

model Reglement {
  id              String        @id @default(cuid())
  montant         Decimal       @db.Decimal(14, 2)
  mode            ModeReglement
  estConfirme     Boolean       @default(false)
  estAnnule       Boolean       @default(false)
  motifAnnulation String?
  /// Motif / nature du règlement (lot I, 2026-10-19) : obligatoire (5 caractères minimum) pour tout NOUVEAU règlement,
  /// côté serveur et à l'écran, Caisse comme Banque. `null` pour les règlements antérieurs : jamais bloqués ni modifiés,
  /// affichés « Non renseigné ».
  motif           String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id])

  /// Article réglé (lot D, 2026-10-16) : un règlement = un article. `null` pour une demande sans article (dépense
  /// directe) et pour un règlement antérieur au lot D pas encore rattaché (cas ambigu : plusieurs articles validés,
  /// rattachement à faire à la main — voir `recalculer-reglements-articles.ts`). Clé `RESTRICT` : un article réglé ne
  /// peut pas disparaître sans emporter son règlement.
  ligneDemandeId String?
  ligneDemande   LigneDemande? @relation(fields: [ligneDemandeId], references: [id], onDelete: Restrict)

  auteurId String
  auteur   User   @relation("ReglementAuteur", fields: [auteurId], references: [id])

  retours          RetourCaisse[]
  /// Mouvements banque (SORTIE/ANNULATION/RETOUR) — voir `JournalBanque`.
  mouvementsBanque JournalBanque[]

  /// Allocation budgétaire explicite par Catégorie (voir CLAUDE.md
  /// "Catégorisation par ligne" / "Allocation budgétaire explicite par
  /// règlement") — Option 2 du diagnostic (PAS un apportionnement
  /// proportionnel calculé) : Finance répartit elle-même, de façon
  /// EXPLICITE, le montant de ce règlement entre chaque Catégorie
  /// concernée par la demande. Toujours au moins UNE allocation dès que le
  /// règlement porte sur une demande catégorisée (même une demande à une
  /// seule catégorie en crée une, à 100%, de façon transparente pour
  /// Finance) — jamais optionnel, jamais un calcul dérivé recalculé à la
  /// volée. La somme des `montant` de ces allocations doit TOUJOURS égaler
  /// exactement `Reglement.montant` (revérifié côté serveur à chaque
  /// écriture, jamais uniquement côté client).
  allocations ReglementCategorieAllocation[]

  createdAt  DateTime  @default(now())
  confirmeAt DateTime?

  // PERF-06 : Index sur demandeId, utilisé dans TOUS les agrégats de
  // règlement (groupBy par demandeId, getTotalRegle, getResteARegler,
  // générés sur chaque affichage Finance).
  @@index([demandeId])
  @@index([demandeId, estConfirme, estAnnule])
  @@index([ligneDemandeId])
}

/// Une ligne = la part explicite de `Reglement.montant` que Finance a
/// choisi d'attribuer à UNE Catégorie précise — voir le commentaire de
/// `Reglement.allocations` ci-dessus. `getMontantConsommeCategorie`
/// (`backend/src/tresorerie.ts`) est désormais l'UNIQUE fonction qui lit
/// cette table (somme des `montant` des allocations dont le `Reglement`
/// est confirmé et non annulé) — jamais une deuxième lecture parallèle.
model ReglementCategorieAllocation {
  id          String    @id @default(cuid())
  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id])
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  montant     Decimal   @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  /// Au plus une allocation par (règlement, catégorie) — jamais deux lignes
  /// pour la même catégorie sur le même règlement (la répartition
  /// additionne déjà tout ce qui revient à une catégorie dans UNE seule
  /// ligne).
  @@unique([reglementId, categorieId])
}

/// Fonds remis (cahier des charges sections 8-9, Phase D) : un retour de
/// caisse ne stocke plus un montant dépensé agrégé unique, mais une liste de
/// `DepenseLigne` détaillées.
model RetourCaisse {
  id                String         @id @default(cuid())
  /// CALCULÉ AUTOMATIQUEMENT, jamais saisi manuellement (voir
  /// `getMontantARetourner` dans src/lib/tresorerie.ts) : montant du
  /// règlement lié moins la somme des `DepenseLigne` déclarées. Choix
  /// documenté dans CLAUDE.md "Refonte V1 en cours" / Phase D — le cahier
  /// des charges (section 9.3 vs 9.5) est en tension entre "l'utilisateur
  /// enregistre un montant à retourner" et "le solde ne doit pas être
  /// modifiable manuellement" ; tranché en faveur du calcul automatique,
  /// cohérent avec le principe déjà appliqué au solde de caisse
  /// (`getSoldeCaisse`) qu'aucun solde financier ne se saisit à la main.
  montantARetourner Decimal        @db.Decimal(14, 2)
  estReceptionne    Boolean        @default(false)
  /// Ancien retour sur règlement Banque (avant le lot G, 2026-10-14) : versement à la banque justifié par un bordereau, écrit
  /// dans `JournalBanque` (RETOUR), JAMAIS en caisse. Posé par la migration pour ces seuls retours ; tout nouveau retour (Caisse
  /// ou Banque) est rendu en espèces à la caisse et écrit à la réception dans `JournalCaisse`. Une écriture déjà passée n'est
  /// jamais modifiée : ces anciens retours gardent leur traitement (non modifiables, réception sans écriture de caisse).
  versementBancaire Boolean        @default(false)
  depenses          DepenseLigne[]

  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id])

  declarantId String
  declarant   User   @relation("RetourDeclarant", fields: [declarantId], references: [id])

  receptionneParId String?
  receptionnePar   User?   @relation("RetourReceptionnaire", fields: [receptionneParId], references: [id])

  createdAt     DateTime  @default(now())
  receptionneAt DateTime?

  /// Date du retour physique de l'espèce, saisie par le collaborateur dans
  /// le formulaire SIMPLIFIÉ ("Retour simple : date + montant", voir
  /// CLAUDE.md "Retour de caisse optionnel — formulaire simplifié") —
  /// distincte de `createdAt` (horodatage de la déclaration elle-même, qui
  /// peut être postérieure de quelques jours au retour physique). Toujours
  /// `null` pour une déclaration via le formulaire détaillé (chaque
  /// `DepenseLigne` porte déjà sa propre date), même précédent que
  /// `Reglement.confirmeAt` (Ticket 9) pour la même distinction
  /// évènement-réel / horodatage-d'écriture.
  dateRetour DateTime?

  /// `true` uniquement pour un retour créé par l'Assistant Finance
  /// (`declarerRetourAssistantAction`, voir CLAUDE.md "L'Assistant Finance
  /// déclare les dépenses sur toute demande, retour ou pas") plutôt que par
  /// le collaborateur lui-même (`creerRetourCaisseAction`) — dans ce cas,
  /// `declarantId` porte l'id de l'Assistant, pas du collaborateur.
  /// Distingue les deux origines dans l'historique/l'affichage, jamais
  /// utilisé comme condition de calcul (`getDepensesDeclarees`/
  /// `getRetoursRecus`/etc. ne font aucune distinction).
  creeParAssistant Boolean @default(false)

  /// Renseigné UNIQUEMENT pour un retour créé par l'Assistant Finance sur
  /// une demande déjà `CLOTUREE` (Tâche "Réouverture exceptionnelle
  /// post-clôture pour retour de caisse oublié", voir CLAUDE.md) — motif
  /// obligatoire (min 10 caractères) justifiant cette correction
  /// exceptionnelle. `null` pour tout retour normal (déclaré par le
  /// collaborateur, ou par l'Assistant sur une demande NON clôturée). Sa
  /// seule présence autorise `receptionnerRetourAction` à s'exécuter
  /// malgré le statut `CLOTUREE` de la demande — aucune autre action
  /// (validation, règlement, catégorisation, clôture) n'est réactivée par
  /// ce champ.
  motifReouvertureExceptionnelle String?

  /// Signalements d'erreur soumis par le Collaborateur sur ce retour une
  /// fois détaillé — voir CLAUDE.md "Signalement d'erreur par le
  /// Collaborateur". Historique complet (jamais un seul champ figé sur
  /// `RetourCaisse` lui-même) : un même retour peut être signalé plusieurs
  /// fois au fil du temps (signalé, corrigé, signalé à nouveau...).
  signalements         SignalementRetour[]
  /// Remboursements (sortie de caisse) proposés suite à un signalement sur CE retour.
  remboursements       RemboursementRetour[]
  /// Retour COMPLÉMENTAIRE déclaré en réponse à un signalement (voir CLAUDE.md
  /// "Correction d'un retour signalé") : lien explicite, jamais une fusion.
  signalementOrigineId String?
  signalementOrigine   SignalementRetour?    @relation("RetourComplementaire", fields: [signalementOrigineId], references: [id])
  /// Mouvement banque `RETOUR` (règlement Banque uniquement).
  mouvementsBanque     JournalBanque[]

  // PERF-06 : Index sur reglementId pour les jointures fréquentes (un
  // règlement a au plus un retour, mais la jointure Reglement → RetourCaisse
  // est systématique dans le tableau de bord Finance et les listes de
  // règlements à compléter).
  @@index([reglementId])
  @@index([declarantId])
  @@index([estReceptionne])
}

/// Signalement d'erreur soumis par le Collaborateur créateur de la demande
/// sur le détail (réel) d'un retour de caisse — voir CLAUDE.md "Signalement
/// d'erreur par le Collaborateur". Modèle dédié plutôt qu'un simple champ
/// sur `RetourCaisse` (comme `motifReouvertureExceptionnelle`) : contrairement
/// à la réouverture post-clôture (un évènement rare, jamais répété sur le
/// même retour), un signalement peut légitimement se répéter dans le temps
/// (signalé → corrigé/résolu → signalé de nouveau) ; conserver l'historique
/// complet (qui a signalé, quand, avec quel commentaire, qui a résolu et
/// quand) nécessite plusieurs lignes possibles, pas un seul champ écrasé à
/// chaque cycle.
model SignalementRetour {
  id             String       @id @default(cuid())
  retourCaisseId String
  retourCaisse   RetourCaisse @relation(fields: [retourCaisseId], references: [id])

  /// Commentaire obligatoire (min 10 caractères, revérifié côté serveur)
  /// expliquant l'erreur ou l'oubli constaté par le Collaborateur.
  commentaire String

  signaleParId String
  signalePar   User     @relation("SignalementRetourSignalePar", fields: [signaleParId], references: [id])
  signaleAt    DateTime @default(now())

  /// `false` tant que l'Assistant Finance n'a pas corrigé le détail en
  /// réponse — voir CLAUDE.md : un signalement `estResolu: false` est ce
  /// qui autorise EXCEPTIONNELLEMENT `detaillerDepensesRetourAction` à
  /// s'exécuter sur un retour déjà réceptionné (même principe ciblé que
  /// `motifReouvertureExceptionnelle` pour la clôture). Un seul signalement
  /// actif à la fois par retour (refusé côté serveur si un autre est déjà
  /// `estResolu: false`).
  estResolu   Boolean   @default(false)
  resoluParId String?
  resoluPar   User?     @relation("SignalementRetourResoluPar", fields: [resoluParId], references: [id])
  resoluAt    DateTime?

  /// Montant total du retour selon le collaborateur — INFORMATIF, ne déclenche rien.
  montantPropose Decimal? @db.Decimal(14, 2)

  retoursComplementaires RetourCaisse[]        @relation("RetourComplementaire")
  remboursements         RemboursementRetour[]
}

enum StatutRemboursementRetour {
  EN_ATTENTE_VALIDATION
  VALIDE
  REJETE
}

/// Remboursement (SORTIE de caisse) au collaborateur qui a trop rendu, suite à un
/// signalement sur un retour déjà réceptionné. Proposé par l'Assistant Finance,
/// validé par le Responsable Finance ; écriture JournalCaisse SORTIE à la validation
/// uniquement. Le retour original n'est jamais modifié dans son écriture de caisse.
model RemboursementRetour {
  id             String                    @id @default(cuid())
  retourCaisseId String
  retourCaisse   RetourCaisse              @relation(fields: [retourCaisseId], references: [id])
  signalementId  String
  signalement    SignalementRetour         @relation(fields: [signalementId], references: [id])
  montant        Decimal                   @db.Decimal(14, 2)
  motif          String
  pieceJointeId  String                    @unique
  pieceJointe    PieceJointe               @relation(fields: [pieceJointeId], references: [id])
  statut         StatutRemboursementRetour @default(EN_ATTENTE_VALIDATION)
  proposeParId   String
  proposePar     User                      @relation("RemboursementRetourProposePar", fields: [proposeParId], references: [id])
  proposeAt      DateTime                  @default(now())
  valideParId    String?
  validePar      User?                     @relation("RemboursementRetourValidePar", fields: [valideParId], references: [id])
  valideAt       DateTime?
  motifRejet     String?

  @@index([retourCaisseId])
  @@index([statut])
}

/// Une ligne de dépense détaillée d'un `RetourCaisse` (cahier des charges
/// section 8-9) : remplace l'ancien montant dépensé agrégé unique du
/// Ticket 5 — une dépense réelle par ligne (montant, objet, date, nature,
/// justificatif, commentaire), pas un total.
model DepenseLigne {
  id            String            @id @default(cuid())
  montant       Decimal           @db.Decimal(14, 2)
  objet         String
  date          DateTime
  nature        String?
  justification TypeJustification
  commentaire   String?

  /// Motif obligatoire saisi par Finance quand ELLE marque cette ligne
  /// `SANS_PIECE` en traitant le retour (`marquerDepenseNonJustifieeAction`)
  /// — distinct de `commentaire`, qui reste la justification donnée par le
  /// collaborateur déclarant (obligatoire de son côté si SANS_PIECE dès la
  /// déclaration). `null` tant que Finance n'est jamais intervenue sur
  /// cette ligne, y compris si le collaborateur l'a lui-même déclarée
  /// SANS_PIECE. Jamais réinitialisé automatiquement : voir
  /// `marquerDepenseNonJustifieeAction` pour la seule écriture possible.
  motifNonJustifie      String?
  motifNonJustifiePar   User?     @relation("MotifNonJustifiePar", fields: [motifNonJustifieParId], references: [id])
  motifNonJustifieParId String?
  motifNonJustifieAt    DateTime?

  retourCaisseId String
  retourCaisse   RetourCaisse @relation(fields: [retourCaisseId], references: [id])

  /// Pièce jointe optionnelle (une par ligne — voir `PieceJointe.depenseLigneId`,
  /// côté 1:1 unique). Champ virtuel (aucune colonne ici) : la relation
  /// inverse de `PieceJointe.depenseLigne`.
  pieceJointe PieceJointe?

  createdAt DateTime @default(now())
}

/// Section 13 du cahier des charges (traçabilité) : chaque écriture doit
/// pouvoir répondre à "quelle demande concernée" et "quel utilisateur" —
/// `demandeId` remonte depuis le `Reglement`/`RetourCaisse` d'origine
/// (via `refId`) au moment de la création de l'écriture (jamais recalculé
/// après coup), `userId` est l'utilisateur qui a déclenché l'opération
/// précise (auteur du règlement pour une SORTIE, `receptionneParId` pour
/// une ENTRÉE de retour, l'utilisateur ayant annulé pour une ENTRÉE
/// compensatoire d'annulation).
model JournalCaisse {
  id        String   @id @default(cuid())
  type      String
  montant   Decimal  @db.Decimal(14, 2)
  source    String
  refId     String
  createdAt DateTime @default(now())

  /// Date RÉELLE de l'opération, quand elle diverge de `createdAt` (date de
  /// saisie dans le portail) — voir CLAUDE.md "Nouvelle alimentation de
  /// caisse". `null` pour toutes les autres sources (règlement, retour,
  /// solde d'ouverture), où `createdAt` fait foi.
  dateOperation DateTime?

  /// Nullable depuis "Solde d'ouverture de caisse" (voir CLAUDE.md) :
  /// toutes les écritures avant cette phase portaient une demande réelle
  /// (règlement/retour), mais une écriture `source = "solde_ouverture"` /
  /// "correction_solde_ouverture" / "annulation_solde_ouverture" ne se
  /// rattache à AUCUNE demande — le seul cas de mouvement de caisse sans
  /// demande d'origine.
  demandeId String?
  demande   Demande? @relation(fields: [demandeId], references: [id])

  userId String
  user   User   @relation("JournalCaisseUser", fields: [userId], references: [id])

  /// Pièce jointe obligatoire pour une écriture du cycle "solde
  /// d'ouverture" (voir CLAUDE.md "Pièce jointe obligatoire sur le solde
  /// d'ouverture") — champ virtuel (aucune colonne ici), relation inverse
  /// de `PieceJointe.journalCaisse`. Jamais renseigné pour les autres
  /// sources (règlement, retour) : ce grand livre reste par ailleurs
  /// immuable, aucune écriture n'est jamais éditée pour y ajouter une
  /// pièce a posteriori.
  pieceJointe PieceJointe?
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]  @relation("ServiceMembres")
  /// Responsable du service : valide l'étape « Service » des demandes de ses membres. Facultatif en base (comptes
  /// créés après la migration) ; exigé par l'écran d'administration ; création de demande refusée sans lui.
  responsableId String?
  responsable   User?   @relation("ServiceResponsable", fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([responsableId])
  @@map("Service")
}

// ============================================================
// MODULE 2 — POINTAGE RH
// ============================================================

enum TypePointage {
  ARRIVEE
  DEPART
}

enum SourcePointage {
  QR_CODE
  ORDINATEUR
  RH_EXCEPTIONNEL
  /// Pointage validé par géolocalisation GPS (fallback hors réseau Wi-Fi)
  GEOLOCALISATION
}

enum StatutAbsence {
  A_CONTROLER
  CONFIRMEE
  JUSTIFIEE
}

model ParametrageHoraire {
  id                                    String   @id @default(cuid())
  heureDebutMatin                       String
  heureFinMatin                         String
  heureDebutApresMidi                   String
  heureFinApresMidi                     String
  isActive                              Boolean  @default(true)
  /// Délai d'attente en minutes après l'heure de fin avant d'envoyer l'alerte d'oubli de départ (défaut: 30)
  delaiAlerteOubliDepartMinutes         Int      @default(30)
  /// Activer le pointage par géolocalisation GPS comme fallback réseau
  geolocalisationActive                 Boolean  @default(false)
  /// Latitude GPS du bureau (point de référence pour le calcul de distance)
  bureauLatitude                        Float?   @default(5.3628189)
  /// Longitude GPS du bureau
  bureauLongitude                       Float?   @default(-3.9374753)
  /// Rayon autorisé en mètres autour du bureau (min: 30, max: 200, défaut: 50)
  rayonAutorise                         Int      @default(50)
  /// Tolérance d'arrivée en minutes (pointage V2, 2026-10-08) : une arrivée jusqu'à `heureDebutMatin` + tolérance
  /// n'est pas un retard ; au-delà, le retard se compte depuis `heureDebutMatin` (la tolérance est un seuil, jamais
  /// un décalage de l'horaire). Paramétrable par la RH (`/pointage/rh/horaires`).
  toleranceRetardMinutes                Int      @default(15)
  /// Délai entre un pointage en retard (ou un départ anticipé) et la demande de justification (premier envoi).
  delaiDemandeJustificationMinutes      Int      @default(15)
  /// Écart entre deux envois de la demande de justification.
  intervalleRelanceJustificationMinutes Int      @default(30)
  /// Nombre TOTAL d'envois de la demande de justification, premier envoi compris (email + push + interne pour le
  /// premier, push + interne pour les suivants).
  nombreMaxRelancesJustification        Int      @default(3)
  updatedAt                             DateTime @updatedAt
}

model Pointage {
  id                String         @id @default(cuid())
  type              TypePointage
  source            SourcePointage
  heure             DateTime
  heurePrevue       String?
  estRetard         Boolean        @default(false)
  minutesRetard     Int?
  estDepartAnticipe Boolean        @default(false)
  motif             String?
  ipAddress         String?

  /// Latitude GPS du collaborateur au moment du pointage (mode géoloc)
  geoLatitude  Float?
  /// Longitude GPS du collaborateur au moment du pointage (mode géoloc)
  geoLongitude Float?
  /// Précision GPS en mètres fournie par le navigateur
  geoPrecision Float?
  /// Distance calculée en mètres entre le collaborateur et le bureau
  geoDistance  Int?

  userId String
  user   User   @relation("PointageEmploye", fields: [userId], references: [id])

  effectueParId String?
  effectuePar   User?   @relation("PointageEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())

  corrections   CorrectionPointage[]
  /// Justification demandée après coup pour un retard ou un départ anticipé (pointage V2) : absente pour un pointage
  /// à l'heure. Le motif du retard n'est plus saisi au pointage (`motif` ci-dessus reste pour l'historique et les
  /// pointages RH exceptionnels).
  justification JustificationPointage?

  @@index([userId, heure])
}

/// Cycle de la justification d'un retard ou d'un départ anticipé (pointage V2, 2026-10-08).
enum StatutJustificationPointage {
  /// Demandée (ou à demander) au collaborateur ; les envois et relances partent tant qu'elle reste dans cet état.
  EN_ATTENTE
  /// Motif envoyé par le collaborateur, en attente de la décision de son responsable (ou de la RH).
  SOUMISE
  ACCEPTEE
  REFUSEE
  /// Fin de journée atteinte sans motif : le décideur en est averti, le collaborateur peut encore justifier.
  NON_JUSTIFIEE
}

/// Justification d'un pointage en retard (arrivée) ou anticipé (départ), une seule par pointage. Décidée par le
/// responsable du service du collaborateur, ou par la RH (`pointage.corriger_pointage`) quand il n'y a pas de
/// responsable, qu'il est inactif ou que le collaborateur est lui-même ce responsable. Registre séparé du pointage,
/// comme `CorrectionPointage` : rien n'est écrasé.
model JustificationPointage {
  id        String                      @id @default(cuid())
  statut    StatutJustificationPointage @default(EN_ATTENTE)
  /// Motif saisi par le collaborateur (obligatoire pour passer à SOUMISE).
  motif     String?
  soumiseAt DateTime?

  /// Envois de la demande de justification (premier envoi compris) et date du dernier : pilotent les relances.
  nombreEnvois   Int       @default(0)
  dernierEnvoiAt DateTime?
  /// Passage à NON_JUSTIFIEE (fin de journée sans motif).
  clotureeAt     DateTime?

  decideurId String?
  decideur   User?     @relation("JustificationPointageDecideur", fields: [decideurId], references: [id], onDelete: Restrict)
  decisionAt DateTime?
  /// Motif du refus, obligatoire pour REFUSEE.
  motifRefus String?

  pointageId String   @unique
  pointage   Pointage @relation(fields: [pointageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

model CorrectionPointage {
  id             String @id @default(cuid())
  ancienneValeur String
  nouvelleValeur String
  motif          String

  pointageId String
  pointage   Pointage @relation(fields: [pointageId], references: [id])

  effectueParId String
  effectuePar   User   @relation("CorrectionEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())
}

model Absence {
  id     String        @id @default(cuid())
  date   DateTime
  statut StatutAbsence @default(A_CONTROLER)
  motif  String?

  userId String
  user   User   @relation("AbsenceEmploye", fields: [userId], references: [id])

  controleParId String?
  controlePar   User?   @relation("AbsenceControlePar", fields: [controleParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model JourFerie {
  id        String   @id @default(cuid())
  date      DateTime @unique
  libelle   String
  createdAt DateTime @default(now())
}

enum SourceAbsenceAutorisee {
  PERMISSION
  CONGE
}

/// V2: Permissions et Congés créent une plage d'absence autorisée.
/// Le calcul de retard et le CRON tiendront compte de ces plages.
model PlageAbsenceAutorisee {
  id          String                 @id @default(cuid())
  date        DateTime
  heureDebut  String // ex: "08:00"
  heureFin    String // ex: "12:00"
  source      SourceAbsenceAutorisee
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Demande de congé qui a créé la plage : l'annulation supprime par cette clé, jamais par plage de dates ni par le texte de la
  /// description. Nulle pour une plage créée autrement.
  demandeCongeId String?
  demandeConge   DemandeConge? @relation(fields: [demandeCongeId], references: [id], onDelete: Cascade)

  /// Plage posée dès la soumission, avant décision : la journée n'est pas comptée absente, mais le congé n'est pas encore validé.
  provisoire Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([demandeCongeId])
}

// ============================================================
// CONGÉS (module simplifié, 2026-10-19)
// ============================================================
//
// Circuit : responsable du service d'abord (Service.responsableId, aucune permission), puis la RH (rôle porteur de
// `conges.valider_rh`) ; repli DG si la RH est le demandeur (moteur pur backend/src/circuitConge.ts). Seul point de
// contact avec le Pointage : `PlageAbsenceAutorisee`.

/// Nature d'une demande : un congé, ou une permission exceptionnelle (mariage, décès, naissance…). Même circuit.
enum NatureConge {
  CONGE
  PERMISSION_EXCEPTIONNELLE
}

enum StatutDemandeConge {
  EN_ATTENTE_RESPONSABLE
  EN_ATTENTE_RH
  VALIDEE
  REJETEE
  ANNULEE
  MODIFICATION_DEMANDEE
}

/// Demande de congé (module simplifié, 2026-10-19) : aucun solde, aucun type, aucune pièce jointe. Circuit : responsable du
/// service puis RH (backend/src/circuitConge.ts). Les jours demandés sont couverts par des plages d'absence autorisée.
model DemandeConge {
  id                        String             @id @default(cuid())
  /// CNG-AAAAMM-NNNN, calculée sous verrou consultatif dans la transaction de création.
  reference                 String             @unique
  nature                    NatureConge
  motif                     String
  dateDebut                 DateTime           @db.Date
  dateFin                   DateTime           @db.Date
  /// Jours du lundi au vendredi hors `JourFerie` : information seulement.
  nbJoursOuvres             Int
  statut                    StatutDemandeConge @default(EN_ATTENTE_RESPONSABLE)
  /// Étape du responsable requise, fixée à la soumission (affichage « non requise » dans la frise).
  etapeResponsableRequise   Boolean            @default(true)
  /// Congé enregistré par la RH pour le salarié (statut VALIDEE d'emblée).
  saisieParRH               Boolean            @default(false)
  motifRejet                String?
  motifModification         String?
  motifAnnulation           String?
  /// Observation facultative de la RH, jointe à sa décision.
  observationRH             String?
  /// Refus après la date de début : les jours déjà passés et non pointés ont-ils été comptés comme absences ? (`null` : sans objet)
  joursPassesComptesAbsents Boolean?

  userId        String
  user          User      @relation("CongeDemandeur", fields: [userId], references: [id])
  /// = userId, sauf saisie par la RH.
  creeParId     String
  creePar       User      @relation("CongeCreateur", fields: [creeParId], references: [id])
  approuveParId String?
  approuvePar   User?     @relation("CongeApprobateur", fields: [approuveParId], references: [id])
  approuveAt    DateTime?
  /// Auteur de la décision RH (validation ou refus à l'étape RH).
  valideParId   String?
  validePar     User?     @relation("CongeValidateur", fields: [valideParId], references: [id])
  valideAt      DateTime?
  annuleParId   String?
  annulePar     User?     @relation("CongeAnnulateur", fields: [annuleParId], references: [id])
  annuleAt      DateTime?

  /// Début de l'étape en cours et dernier rappel envoyé (rappel quotidien, planificateur).
  etapeDepuis     DateTime  @default(now())
  dernierRappelAt DateTime?

  plages PlageAbsenceAutorisee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([statut])
  @@index([dateDebut, dateFin])
}

// ============================================================
// FEEDBACKAPP — messages constructifs anonymes sur un employé
// ============================================================
//
// RÈGLE ABSOLUE, PRIORITAIRE SUR TOUT LE RESTE (voir CLAUDE.md "FeedbackApp
// : anonymat total") : AUCUNE colonne ne doit JAMAIS être ajoutée à
// `Feedback` pour identifier l'auteur d'un message, sous quelque forme que
// ce soit — ni id, ni IP, ni session, ni empreinte navigateur, ni horodatage
// précis. Toute évolution future de ce modèle doit être relue au regard de
// cette règle avant d'être ajoutée.

enum FeedbackSource {
  /// Soumis depuis la page publique, sans compte (n'importe qui).
  PUBLIC
  /// Soumis par un employé connecté au portail (Tranche B, pas encore
  /// implémentée à ce stade — la colonne existe déjà pour éviter une
  /// migration supplémentaire plus tard).
  INTERNAL
}

/// Nature de l'avis — détermine sa visibilité (voir CLAUDE.md "FeedbackApp
/// — notation structurée") : `COLLABORATION` est toujours PRIVÉ (visible
/// uniquement du destinataire et des comptes `feedback.moderer`),
/// `CONDITIONS_TRAVAIL` est toujours PUBLIC. Orthogonal à `FeedbackSource`
/// (qui distingue QUI a soumis — anonyme ou employé connecté), jamais
/// confondu : la visibilité dépend de `type`, jamais de `source`.
enum FeedbackType {
  /// Avis sur un collaborateur nommé (`recipientId` obligatoire) — lu par le destinataire et la modération.
  COLLABORATION
  /// Avis sur les conditions de travail générales de l'entreprise
  /// (`recipientId` toujours `null`, aucun destinataire) — lu avec `feedback.voir_details` seulement (RH, DG).
  CONDITIONS_TRAVAIL
}

model Feedback {
  id String @id @default(uuid())

  /// 20 à 500 caractères, revalidé côté serveur (zod) à chaque écriture —
  /// aucune contrainte de longueur au niveau de la colonne elle-même,
  /// cohérent avec le reste du projet (toute validation de format/longueur
  /// vit en zod, jamais dans une contrainte SQL). Depuis l'introduction de
  /// la notation structurée, ce texte n'est JAMAIS tapé librement par
  /// l'utilisateur : généré côté serveur à partir de `ratings` (voir
  /// `generateFeedbackComment`, `backend/src/feedback-comment.ts`) —
  /// défense supplémentaire contre l'identification par style d'écriture.
  content String

  /// Nullable : obligatoire pour `type: COLLABORATION`, toujours `null`
  /// pour `type: CONDITIONS_TRAVAIL` (avis sur l'entreprise en général,
  /// aucun destinataire) — revalidé côté serveur selon `type` à chaque
  /// écriture, jamais une simple convention.
  recipientId String?
  /// Réutilise le `User` existant du portail — AUCUNE nouvelle table
  /// "employees" séparée (voir CLAUDE.md).
  recipient   User?   @relation("FeedbackRecipient", fields: [recipientId], references: [id])

  source FeedbackSource

  /// `@default(COLLABORATION)` : préserve la validité des lignes déjà
  /// existantes (toutes des avis sur un collaborateur nommé, avant
  /// l'introduction de `CONDITIONS_TRAVAIL`) sans migration de données —
  /// voir CLAUDE.md "FeedbackApp — notation structurée".
  type FeedbackType @default(COLLABORATION)

  /// Réponses brutes structurées (clé de question → valeur), pour
  /// permettre des statistiques agrégées plus tard — en complément de
  /// `content` (le texte assemblé), jamais en remplacement. Nullable :
  /// `null` pour toute ligne antérieure à la notation structurée. RÈGLE
  /// ABSOLUE inchangée (voir plus haut) : ces clés/valeurs ne portent
  /// jamais, même indirectement, de donnée permettant de reconstituer
  /// l'auteur (uniquement des notes/choix sur des questions fixes,
  /// jamais un identifiant, une IP, un texte libre saisi par l'auteur).
  ratings Json?

  /// DATE SEULE — colonne SQL `DATE` (`@db.Date`), jamais `TIMESTAMP` :
  /// aucune heure/minute/seconde n'est physiquement stockable, contrainte
  /// posée au niveau du SCHÉMA plutôt que par simple convention
  /// applicative (défense en profondeur pour la règle d'anonymat — voir
  /// CLAUDE.md). Valeur du jour au moment de l'écriture (`DEFAULT
  /// CURRENT_DATE`), jamais recalculée ni modifiable après coup.
  submittedAt DateTime @default(now()) @db.Date

  isModerated     Boolean @default(false)
  /// Motif de la modération (ex: message retiré) — nullable, jamais
  /// obligatoire tant qu'`isModerated` est `false`.
  motifModeration String?

  /// Traçabilité de l'ACTION DE MODÉRATION elle-même (qui côté RH/DG a
  /// modéré, quand) — SANS RAPPORT avec l'auteur du message, dont
  /// l'anonymat reste total. Nullable : `null` tant que le message n'a
  /// jamais été modéré.
  moderatedById String?
  moderatedBy   User?     @relation("FeedbackModeratedBy", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?

  @@index([recipientId])
  @@index([source])
  @@index([isModerated])
  @@index([type])
}

/// FeedbackApp — limite « un avis par collègue et par jour ». Trace TEMPORAIRE : empreinte HMAC-SHA256 de
/// « auteur|cible|jour » (voir `backend/src/feedbackQuota.ts`) et le jour, RIEN d'autre : ni auteur, ni heure, ni
/// relation vers `Feedback` ou `User`. Les jours passés sont effacés par la purge quotidienne. Ne jamais ajouter de colonne.
model FeedbackQuota {
  cle  String   @unique
  jour DateTime @db.Date
}

enum StatutRetourExceptionnel {
  EN_ATTENTE_VALIDATION
  VALIDE
  REJETE
}

/// Retour de caisse EXCEPTIONNEL sur une demande déjà `CLOTUREE` (voir CLAUDE.md
/// "Retour de caisse exceptionnel post-clôture") : saisi par l'Assistant
/// Finance (ou le Responsable), validé par le Responsable Finance. Aucune
/// écriture `JournalCaisse` avant validation — le solde de caisse n'est
/// jamais affecté par un retour en attente ou rejeté. Distinct de
/// `RetourCaisse` pour ne pas compliquer les requêtes des retours normaux.
model RetourExceptionnel {
  id             String                   @id @default(cuid())
  demandeId      String
  demande        Demande                  @relation(fields: [demandeId], references: [id])
  /// Article concerné (lot E, 2026-10-17). Vide pour une demande sans article (dépense directe) et pour un retour
  /// antérieur au lot E sur une demande à plusieurs articles validés (cas ambigu : jamais attribué au hasard).
  ligneDemandeId String?
  ligneDemande   LigneDemande?            @relation(fields: [ligneDemandeId], references: [id], onDelete: Restrict)
  montant        Decimal                  @db.Decimal(14, 2)
  motif          String
  statut         StatutRetourExceptionnel @default(EN_ATTENTE_VALIDATION)

  saisiParId String
  saisiPar   User     @relation("RetourExceptionnelSaisiPar", fields: [saisiParId], references: [id])
  saisiAt    DateTime @default(now())

  valideParId String?
  validePar   User?     @relation("RetourExceptionnelValidePar", fields: [valideParId], references: [id])
  /// Date de la validation OU du rejet (décision du Responsable).
  valideAt    DateTime?
  motifRejet  String?

  pieceJointe PieceJointe?

  @@index([demandeId])
  @@index([statut])
  @@index([ligneDemandeId])
}

/// Retour EXTERNE (voir CLAUDE.md "Retour externe") : argent revenu en caisse
/// suite à un règlement fait hors système (ex: chèque). Totalement autonome :
/// aucun lien avec Demande/Reglement/RetourCaisse/RetourExceptionnel.
/// Contrainte applicative : `collaborateurId` XOR `nomExterne`.
/// `montantChequeInitial` est purement déclaratif (non vérifiable).
/// Écrit immédiatement dans `JournalCaisse` (ENTREE, source "retour_externe").
model RetourExterne {
  id                   String        @id @default(cuid())
  collaborateurId      String?
  collaborateur        User?         @relation("RetourExterneCollaborateur", fields: [collaborateurId], references: [id])
  nomExterne           String?
  montantChequeInitial Decimal       @db.Decimal(14, 2)
  montantRetourne      Decimal       @db.Decimal(14, 2)
  motif                String
  pieceJointeId        String        @unique
  pieceJointe          PieceJointe   @relation("RetourExternePieceRetour", fields: [pieceJointeId], references: [id])
  /// Justificatif du chèque initial (preuve du règlement d'origine). Obligatoire
  /// côté applicatif ; nullable en base uniquement pour les lignes antérieures.
  pieceJointeChequeId  String?       @unique
  pieceJointeCheque    PieceJointe?  @relation("RetourExternePieceCheque", fields: [pieceJointeChequeId], references: [id])
  /// Rattachement FACULTATIF à une demande et à son article (lot G bis, 2026-10-19) : retour d'un fonds versé par
  /// BANQUE, rendu en espèces à la caisse. Rattaché, il compte comme retour reçu de l'article (solde à régulariser) ;
  /// non rattaché, il reste totalement autonome (cas du chèque hors système). Vide pour une demande sans article.
  demandeId            String?
  demande              Demande?      @relation("RetourExterneDemande", fields: [demandeId], references: [id], onDelete: Restrict)
  ligneDemandeId       String?
  ligneDemande         LigneDemande? @relation("RetourExterneLigne", fields: [ligneDemandeId], references: [id], onDelete: Restrict)
  creeParId            String
  creePar              User          @relation("RetourExterneCreePar", fields: [creeParId], references: [id])
  creeAt               DateTime      @default(now())

  @@index([creeAt])
  @@index([demandeId])
  @@index([ligneDemandeId])
}

/// Réinitialisation à USAGE UNIQUE avant mise en production (voir CLAUDE.md "Réinitialisation avant mise en
/// production") : purge des données de test Trésorerie + Pointage RH/FeedbackApp. Cette table n'est JAMAIS
/// purgée : une ligne = "déjà exécutée" (flag définitif) ET journal d'audit hors des tables purgées.
/// `verrou` est constant + unique : deux exécutions concurrentes ne peuvent pas réussir toutes les deux.
model ReinitialisationSysteme {
  id                String   @id @default(cuid())
  verrou            String   @unique @default("REINITIALISATION")
  effectueeAt       DateTime @default(now())
  effectueeParId    String
  effectueePar      User     @relation(fields: [effectueeParId], references: [id])
  /// Nombre de lignes supprimées par table.
  decompte          Json
  /// Empreinte SHA-256 de la sauvegarde JSON téléchargée juste avant la purge.
  sauvegardeSha256  String
  /// Fichiers de uploads/ supprimés du disque après le commit (mis à jour après coup).
  fichiersSupprimes Int      @default(0)
  fichiersEchecs    Int      @default(0)
}

enum TypeMouvementBanque {
  SORTIE
  RETOUR
  ANNULATION
}

/// Historique des mouvements BANQUE (voir CLAUDE.md "Retour sur règlement
/// Banque") — table de traçabilité UNIQUEMENT : il n'existe volontairement
/// AUCUN solde banque, ni fonction de calcul, ni contrôle de disponibilité
/// (contrairement à `JournalCaisse`). `SORTIE` écrite à la confirmation d'un
/// règlement Banque, `ANNULATION` à son annulation, `RETOUR` à la déclaration
/// d'un retour (avec bordereau de versement obligatoire, `pieceJointeId`).
model JournalBanque {
  id             String              @id @default(cuid())
  type           TypeMouvementBanque
  montant        Decimal             @db.Decimal(14, 2)
  reglementId    String
  reglement      Reglement           @relation(fields: [reglementId], references: [id])
  /// Retour de caisse associé, pour un mouvement `RETOUR`.
  retourCaisseId String?
  retourCaisse   RetourCaisse?       @relation(fields: [retourCaisseId], references: [id])
  /// Bordereau de versement — obligatoire pour un `RETOUR` (revérifié côté serveur).
  pieceJointeId  String?             @unique
  pieceJointe    PieceJointe?        @relation(fields: [pieceJointeId], references: [id])
  creeParId      String
  creePar        User                @relation("JournalBanqueCreePar", fields: [creeParId], references: [id])
  creeAt         DateTime            @default(now())

  @@index([reglementId])
}

// =====================================================================================================================
// Module Encaissements, taxes et commissions — socle technique (docs/encaissements-conception.md §5.1 et §6).
// Toutes les relations vers User sont en onDelete: Restrict : une trace d'audit ou d'auteur ne doit jamais
// disparaître ni devenir anonyme par la suppression d'un compte.
// =====================================================================================================================

/// Mise en service du module : une seule ligne possible (id = 1, contrainte CHECK en SQL). Sa présence verrouille
/// l'audit (plus aucun DELETE sur EncAudit) et les séquences. UPDATE/DELETE/TRUNCATE toujours interdits par trigger.
model EncMiseEnService {
  id               Int      @id @default(1)
  activeeAt        DateTime @default(now())
  activeeParId     String
  activeePar       User     @relation("EncMiseEnServiceActiveePar", fields: [activeeParId], references: [id], onDelete: Restrict)
  /// Empreinte SHA-256 de la sauvegarde JSON téléchargée juste avant la remise à zéro (section 6).
  sauvegardeSha256 String
}

/// Compteurs de numérotation (PAI-AAAA, SUS-AAAA, RGS-AAAA, BRD-AAAA-MM). Incrément atomique uniquement
/// (backend/src/encSequence.ts), jamais count()+1. Après mise en service : DELETE et baisse de valeur interdits.
model EncSequence {
  cle    String @id
  valeur Int    @default(0)
}

/// Paramètres du module (clé → valeur texte typée par backend/src/encParametres.ts). Défauts posés par la migration
/// ET par le seed ; majParId nul = valeur par défaut jamais modifiée.
model EncParametre {
  cle      String   @id
  valeur   String
  majParId String?
  majPar   User?    @relation("EncParametreMajPar", fields: [majParId], references: [id], onDelete: Restrict)
  majAt    DateTime @default(now())
}

/// Journal d'audit du module, en ajout seul : UPDATE toujours interdit, DELETE/TRUNCATE interdits dès qu'une ligne
/// EncMiseEnService existe (triggers SQL). Écriture uniquement via backend/src/encAudit.ts.
model EncAudit {
  id       BigInt    @id @default(autoincrement())
  entite   String
  entiteId String
  action   String
  avant    Json?
  apres    Json?
  motif    String?
  /// Mois de rattachement (1er du mois) pour le rapport « changements depuis la clôture » (F11.4).
  mois     DateTime? @db.Date
  userId   String
  user     User      @relation("EncAuditUser", fields: [userId], references: [id], onDelete: Restrict)
  ip       String?
  at       DateTime  @default(now())

  @@index([entite, entiteId])
  @@index([mois, at])
  @@index([at])
}

/// Pièce jointe du module, séparée de PieceJointe (que la purge globale vide sans filtre). Fichier déposé par la route
/// d'upload commune (uploads/), métadonnées recalculées côté serveur depuis le fichier (encPieceJointe.ts).
model EncPieceJointe {
  id           String   @id @default(cuid())
  url          String   @unique
  nomOrigine   String?
  mime         String
  taille       Int
  sha256       String
  deposeeParId String
  deposeePar   User     @relation("EncPieceJointeDeposeePar", fields: [deposeeParId], references: [id], onDelete: Restrict)
  deposeeAt    DateTime @default(now())

  /// Import F1 (§5.3, commit 4c) — champ virtuel (le fichier importé, conservé comme preuve, D6), aucune colonne ici.
  encImport EncImport?

  @@index([sha256])
}

// =====================================================================================================================
// Paramètres V2 (docs/encaissements-conception.md §5.2, CDC V2.6 §3.6/F9) — pas d'écran (Lot 3) : modèle, migration et
// actions serveur seulement. Aucun contrat ni encaissement n'existe encore (Lot 1) : `EncContrat.partAccessoiresPartenaire`
// (l'exception par police du §5.4) est réservée dans le modèle du Lot 1, pas ici.
// =====================================================================================================================

/// Liste des branches (CDC principe 6, "tout se suit par branche") — arbitrage PROVISOIRE (P1, 2026-09-28) : paramétrée
/// par la Finance, en l'absence de réponse écrite du client. Jamais supprimée (seulement désactivée) : une branche
/// désactivée reste la valeur exacte de toute donnée déjà rattachée.
model EncBranche {
  id        String   @id @default(cuid())
  code      String   @unique
  libelle   String
  actif     Boolean  @default(true)
  creeParId String
  creePar   User     @relation("EncBrancheCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt    DateTime @default(now())
  majAt     DateTime @updatedAt

  /// Import F1 (§5.3/§5.5, commit 4c) — champs virtuels (aucune colonne ici), déclarés pour résoudre les relations
  /// nommées côté `EncContrat`/`EncEncaissement`/`EncImport`/`EncSignalement`.
  encContrats         EncContrat[]
  encEncaissements    EncEncaissement[]
  encImportsParDefaut EncImport[]       @relation("EncImportBrancheParDefaut")
  encSignalements     EncSignalement[]
}

/// Bénéficiaire des honoraires, DATÉ (CDC §3.6) : jamais une ligne modifiée, toujours une nouvelle ligne à une nouvelle
/// `dateDebut` — l'historique complet reste lisible. Le bénéficiaire en vigueur pour un encaissement est celui dont la
/// `dateDebut` est la plus récente sans dépasser sa date de prise en compte (`encReferentiels.ts`, Lot 1). `creeParId`
/// nul UNIQUEMENT pour la ligne « NOVELIA » posée par la migration (aucun utilisateur réel à cet instant).
model EncBeneficiaireHonoraires {
  id        String   @id @default(cuid())
  nom       String
  dateDebut DateTime @unique @db.Date
  creeParId String?
  creePar   User?    @relation("EncBeneficiaireHonorairesCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt    DateTime @default(now())
}

/// Partenaires (CDC §3.6, F9) : partage des accessoires par partenaire. `cleNom` = nom normalisé
/// (`encReferentiels.ts`), clé de rapprochement pour l'import de production (Lot 1, où la création automatique et
/// l'usage réel commencent) ; ici, seule la création manuelle existe (F9 le permet aussi). `partAccessoiresPartenaire`
/// nul = taux par défaut (`EncParametre` `accessoires.part_partenaire_defaut`) ; jamais un second calcul du complément
/// SIM stocké : toujours 1 − ce taux, calculé à l'usage (`encCalcul.partagerAccessoires`).
model EncPartenaire {
  id                        String            @id @default(cuid())
  cleNom                    String            @unique
  nom                       String
  partAccessoiresPartenaire Decimal?          @db.Decimal(7, 6)
  creeParId                 String
  creePar                   User              @relation("EncPartenaireCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt                    DateTime          @default(now())
  majParId                  String?
  majPar                    User?             @relation("EncPartenaireMajPar", fields: [majParId], references: [id], onDelete: Restrict)
  majAt                     DateTime          @updatedAt
  tauxControle              EncTauxControle[]
  /// Import F1 (§5.3, commit 4c) — champ virtuel, aucune colonne ici.
  encContrats               EncContrat[]
}

/// Taux de contrôle FACULTATIFS (CDC §3.6, F9) : signalent un écart à l'import (Lot 1), ne modifient JAMAIS un montant.
/// Clé (produitCode, partenaireId), l'un des deux pouvant être nul (contrôle valable pour tous les produits d'un
/// partenaire, ou pour un produit quel que soit le partenaire) — jamais les deux nuls à la fois (CHECK en SQL, aucun
/// contrôle "global" décrit par le cahier). `produitCode` reste un simple texte : aucun référentiel produit n'existe
/// (les produits viennent du fichier de production, Lot 1), rapproché à l'import sur cette même valeur.
/// `@@unique` : n'empêche que le doublon (produit, partenaire) EXACT — la sémantique NULL de Postgres (NULL ≠ NULL)
/// ne bloque jamais deux lignes "produit seul" ou "partenaire seul" par ailleurs identiques ; laissé tel quel (aucune
/// contrainte NULLS NOT DISTINCT ici), l'écran F9 (Lot 3) devra vérifier ce cas lui-même avant insertion.
model EncTauxControle {
  id              String         @id @default(cuid())
  produitCode     String?
  partenaireId    String?
  partenaire      EncPartenaire? @relation(fields: [partenaireId], references: [id], onDelete: Restrict)
  tauxTaxe        Decimal?       @db.Decimal(7, 6)
  tauxCommission  Decimal?       @db.Decimal(7, 6)
  tauxAccessoires Decimal?       @db.Decimal(7, 6)
  tauxHonoraires  Decimal?       @db.Decimal(7, 6)
  majParId        String
  majPar          User           @relation("EncTauxControleMajPar", fields: [majParId], references: [id], onDelete: Restrict)
  majAt           DateTime       @updatedAt

  @@unique([produitCode, partenaireId])
  @@index([produitCode])
  @@index([partenaireId])
}

// =====================================================================================================================
// Contrats et encaissements (docs/encaissements-conception.md §5.3, CDC V2.6 F1/F3) — commit 4c (2026-09-30) : import
// (F1) seulement. Confirmation (F5), correction/contre-passation (F3.5), argent non identifié (F6), relevés (F5),
// annulation (F8) et reprise (F1.5) restent des commits ultérieurs — les colonnes qu'ils rempliront existent déjà
// (schéma stable), mais restent toutes `null` tant que ces commits n'existent pas.
// =====================================================================================================================

enum EncSourceEncaissement {
  FICHIER
  SAISIE
}

enum EncStatutEncaissement {
  A_CONFIRMER
  CONFIRME
  NON_RECU
}

enum EncTypeImport {
  PRODUCTION
  RELEVE
  REPRISE
}

enum EncStatutImport {
  APERCU
  VALIDE
  ABANDONNE
}

enum EncAnalyseSignalement {
  DEJA_PRESENT
  DOUBLON_POSSIBLE
  A_COMPLETER
  REFERENCE_MANQUANTE
  REF_WAVE_NON_CONFORME
  AJOUTE
  SANS_PAIEMENT
  PRIME_MODIFIEE
  INCOHERENCE
  ECART_TAUX
  LIGNE_ANNULEE_REJETEE
  ANNULATION_EN_ATTENTE_L4
  BRANCHE_INCONNUE
}

enum EncNiveauSignalement {
  A_TRAITER
  INFO
}

enum EncStatutSignalement {
  A_TRAITER
  INFO
  TRAITE
}

/// Contrat (CDC §3.1, F1) — UNIQUEMENT issu du fichier de production, jamais créé à l'écran. Toutes les informations
/// sont en lecture seule pour l'utilisateur, toujours RÉÉCRITES depuis le fichier à chaque import touchant cette
/// police (y compris un avenant, D8 — signalé `PRIME_MODIFIEE`, jamais bloqué) — SAUF `partAccessoiresPartenaire`
/// (exception par police, §3.1/§5.4 : "passe avant le taux du partenaire", saisie facultative à l'écran F2, jamais
/// présente dans le fichier, jamais touchée par un import). Changement de branche/partenaire sur avenant : autorisé
/// (le fichier fait foi), question ouverte V2-A5 non tranchée par ce commit.
model EncContrat {
  id                        String         @id @default(cuid())
  numPolice                 String         @unique
  brancheId                 String
  branche                   EncBranche     @relation(fields: [brancheId], references: [id], onDelete: Restrict)
  typeContrat               String?
  produitLibelle            String?
  produitCode               String?
  typeOperation             String?
  clientId                  String?
  clientNom                 String?
  partenaireId              String?
  partenaire                EncPartenaire? @relation(fields: [partenaireId], references: [id], onDelete: Restrict)
  dateEffet                 DateTime       @db.Date
  dateEcheance              DateTime?      @db.Date
  typePolice                String?
  /// Montants du contrat (CDC §3.1), mêmes noms que `MontantsContrat` (encCalcul.ts) : S prime TTC, T prime nette,
  /// U accessoires, V taxes, W commission, X honoraires — jamais recalculés, toujours ceux du fichier.
  S                         Decimal        @db.Decimal(14, 2)
  T                         Decimal        @db.Decimal(14, 2)
  U                         Decimal        @db.Decimal(14, 2)
  V                         Decimal        @db.Decimal(14, 2)
  W                         Decimal        @db.Decimal(14, 2)
  X                         Decimal        @db.Decimal(14, 2)
  partAccessoiresPartenaire Decimal?       @db.Decimal(7, 6)
  creeParImportId           String
  creeParImport             EncImport      @relation("EncContratCreeParImport", fields: [creeParImportId], references: [id], onDelete: Restrict)
  majParImportId            String?
  majParImport              EncImport?     @relation("EncContratMajParImport", fields: [majParImportId], references: [id], onDelete: Restrict)
  creeAt                    DateTime       @default(now())
  majAt                     DateTime       @updatedAt

  encaissements EncEncaissement[]
  signalements  EncSignalement[]
  /// Index de recherche par début de mot (F2, commit 5a-bis) — tenu à jour par l'import, voir `encRecherche.ts`.
  mots          EncContratMot[]

  @@index([brancheId])
  @@index([partenaireId])
  @@index([clientNom])
  @@index([produitCode])
}

/// Index de recherche par DÉBUT DE MOT (F2, commit 5a-bis, option B, sans extension PostgreSQL) : un mot normalisé
/// (minuscules, sans accents, apostrophes/tirets retirés, plus les parties d'un mot composé) par ligne, tiré du n° de
/// police, du client (nom, ID), du partenaire, du produit, de la branche et des références de paiement du contrat.
/// Réécrit par l'import dans la même transaction que le contrat (`indexerMotsContrat`), rempli pour l'existant par
/// la migration. Colonne `mot` en collation "C" (posée par la migration, non modélisée par Prisma) : le btree
/// ordinaire ci-dessous sert alors un `LIKE 'x%'`, impossible sous la collation de la base (`en_US.utf8`).
model EncContratMot {
  contratId String
  contrat   EncContrat @relation(fields: [contratId], references: [id], onDelete: Cascade)
  mot       String

  @@id([contratId, mot])
  @@index([mot, contratId])
}

/// Encaissement / versement (CDC §3.2, F1/F3) — un seul modèle pour toutes les voies de saisie ; seule F1 (source
/// `FICHIER`, statut `A_CONFIRMER`) écrit dans ce commit. Montants figés à la CONFIRMATION (AA à AD, commission,
/// honoraires, parts d'accessoires, exigibilité) : colonnes déjà présentes (schéma stable pour F5, commit ultérieur)
/// mais TOUJOURS `null` ici, jamais renseignées par l'import.
model EncEncaissement {
  id                        String                @id @default(cuid())
  /// NOTRE numéro (PAI-AAAA-NNNNNN, `encSequence.ts`) — attribué à la création, jamais réutilisé (D7).
  paiementId                String                @unique
  /// PaiementID DU FICHIER, s'il existe : anti-doublon SEULEMENT (D7/A1b), jamais notre identifiant. `@unique` sur
  /// une colonne nullable = unique seulement quand renseignée (sémantique Postgres native).
  paiementIdFichier         String?               @unique
  contratId                 String
  contrat                   EncContrat            @relation(fields: [contratId], references: [id], onDelete: Restrict)
  brancheId                 String
  branche                   EncBranche            @relation(fields: [brancheId], references: [id], onDelete: Restrict)
  source                    EncSourceEncaissement
  statut                    EncStatutEncaissement @default(A_CONFIRMER)
  datePaiement              DateTime              @db.Date
  mode                      String
  /// `null` UNIQUEMENT pour le cas « référence manquante » (F1.4, décision du 2026-09-30) — un encaissement SAISI
  /// (F3, hors de ce commit) l'exige toujours (CDC §3.2).
  reference                 String?
  Z                         Decimal               @db.Decimal(14, 2)
  dateSaisie                DateTime
  saisiParId                String
  saisiPar                  User                  @relation("EncEncaissementSaisiPar", fields: [saisiParId], references: [id], onDelete: Restrict)
  dateConfirmation          DateTime?
  confirmeParId             String?
  confirmePar               User?                 @relation("EncEncaissementConfirmePar", fields: [confirmeParId], references: [id], onDelete: Restrict)
  datePriseEnCompte         DateTime?             @db.Date
  ordrePriseEnCompte        Int?
  motifNonReception         String?
  nonRecuParId              String?
  nonRecuPar                User?                 @relation("EncEncaissementNonRecuPar", fields: [nonRecuParId], references: [id], onDelete: Restrict)
  nonRecuAt                 DateTime?
  referenceGroupe           String?
  groupeId                  String?
  nonIdentifieId            String?
  importId                  String?
  import                    EncImport?            @relation(fields: [importId], references: [id], onDelete: Restrict)
  importLigne               Int?
  releveLigneId             String?
  contrePasseId             String?               @unique
  contrePasse               EncEncaissement?      @relation("EncEncaissementContrepassation", fields: [contrePasseId], references: [id], onDelete: Restrict)
  contrePassePar            EncEncaissement?      @relation("EncEncaissementContrepassation")
  motifContrePassation      String?
  /// Figés à la confirmation (D9, F5 — commit ultérieur) : jamais renseignés par ce commit.
  AA                        Decimal?              @db.Decimal(14, 2)
  AB                        Decimal?              @db.Decimal(14, 2)
  AC                        Decimal?              @db.Decimal(14, 2)
  AD                        Decimal?              @db.Decimal(14, 2)
  commission                Decimal?              @db.Decimal(14, 2)
  honoraires                Decimal?              @db.Decimal(14, 2)
  partAccessoiresTaux       Decimal?              @db.Decimal(7, 6)
  partAccessoiresPartenaire Decimal?              @db.Decimal(14, 2)
  partAccessoiresSim        Decimal?              @db.Decimal(14, 2)
  moisExigibilite           DateTime?             @db.Date
  dateLimiteReversement     DateTime?             @db.Date
  estRegularisation         Boolean               @default(false)
  beneficiaireHonorairesId  String?
  /// Marquages « payé » hors application (F7, commit ultérieur) : date + référence par nature, jamais renseignés ici.
  taxePayeeDate             DateTime?
  taxePayeeReference        String?
  commissionPayeeDate       DateTime?
  commissionPayeeReference  String?
  honorairesPayesDate       DateTime?
  honorairesPayesReference  String?
  accessoiresPayesDate      DateTime?
  accessoiresPayesReference String?
  aRegulariser              Boolean               @default(false)
  observations              String?

  signalementsExistant EncSignalement[] @relation("EncSignalementEncaissementExistant")
  signalementsCree     EncSignalement[] @relation("EncSignalementEncaissementCree")

  @@index([contratId, statut, ordrePriseEnCompte])
  @@index([statut, datePaiement])
  @@index([reference])
  @@index([moisExigibilite])
  @@index([datePriseEnCompte])
  @@index([importId])
}

/// Import d'un fichier (CDC F1/F1.5/F5, §3.4 partiel) — un seul modèle pour les 3 types ; seul `PRODUCTION` est écrit
/// par ce commit (`RELEVE` = F5, `REPRISE` = F1.5, hors périmètre). Le fichier est conservé comme preuve (D6) via
/// `EncPieceJointe` (`fichierId`) — jamais dans le dépôt ni dans un test (données clients).
model EncImport {
  id                    String          @id @default(cuid())
  type                  EncTypeImport
  statut                EncStatutImport
  nomFichier            String
  sha256                String
  fichierId             String?         @unique
  fichier               EncPieceJointe? @relation(fields: [fichierId], references: [id], onDelete: Restrict)
  brancheParDefautId    String?
  brancheParDefaut      EncBranche?     @relation("EncImportBrancheParDefaut", fields: [brancheParDefautId], references: [id], onDelete: Restrict)
  operateur             String?
  /// Codes `EncBranche` lus dans la colonne « Branche » du fichier (tableau JSON trié, sans doublon), enregistrés au
  /// moment de l'import (commit 4e). `null` : aucune branche lue dans le fichier (branche par défaut choisie à l'écran),
  /// ou import antérieur à cette colonne — l'historique se rabat alors sur une reconstitution.
  branchesFichier       Json?
  /// Reprise (D10, F1.5, hors périmètre de ce commit) : jamais renseignées pour un import `PRODUCTION`.
  basculeTaxe           DateTime?       @db.Date
  basculeCommission     DateTime?       @db.Date
  basculeHonoraires     DateTime?       @db.Date
  basculeAccessoires    DateTime?       @db.Date
  nbLignes              Int
  totalPrimesTtc        Decimal?        @db.Decimal(14, 2)
  nbContratsCrees       Int             @default(0)
  nbContratsMaj         Int             @default(0)
  nbPaiementsAConfirmer Int             @default(0)
  nbATraiter            Int             @default(0)
  importeParId          String
  importePar            User            @relation("EncImportImportePar", fields: [importeParId], references: [id], onDelete: Restrict)
  importeAt             DateTime
  valideParId           String?
  validePar             User?           @relation("EncImportValidePar", fields: [valideParId], references: [id], onDelete: Restrict)
  valideAt              DateTime?

  contratsCrees EncContrat[]      @relation("EncContratCreeParImport")
  contratsMajs  EncContrat[]      @relation("EncContratMajParImport")
  encaissements EncEncaissement[]
  signalements  EncSignalement[]
}

/// Signalement (CDC §3.4, F1.4) — trace de chaque cas à traiter ou pour information levé par un import. `niveau`
/// (sévérité, posée à la création) et `statut` (cycle de vie : démarre égal à `niveau`, `TRAITE` par un futur écran)
/// sont deux champs DISTINCTS.
model EncSignalement {
  id                     String                @id @default(cuid())
  importId               String
  import                 EncImport             @relation(fields: [importId], references: [id], onDelete: Restrict)
  contratId              String?
  contrat                EncContrat?           @relation(fields: [contratId], references: [id], onDelete: Restrict)
  /// `null` UNIQUEMENT si la ligne du fichier n'avait aucun numéro de police (cas hors tableau F1.4, ne bloque pas le
  /// reste de l'import — décision du commit 4c).
  numPolice              String?
  brancheId              String?
  branche                EncBranche?           @relation(fields: [brancheId], references: [id], onDelete: Restrict)
  analyse                EncAnalyseSignalement
  niveau                 EncNiveauSignalement
  statut                 EncStatutSignalement
  /// Paiement tel qu'indiqué dans le fichier (date/mode/référence/montant), pour les cas sans `EncEncaissement` créé.
  paiementIndique        Json?
  encaissementExistantId String?
  encaissementExistant   EncEncaissement?      @relation("EncSignalementEncaissementExistant", fields: [encaissementExistantId], references: [id], onDelete: Restrict)
  encaissementCreeId     String?
  encaissementCree       EncEncaissement?      @relation("EncSignalementEncaissementCree", fields: [encaissementCreeId], references: [id], onDelete: Restrict)
  primeAvant             Json?
  primeApres             Json?
  detail                 String
  traiteParId            String?
  traitePar              User?                 @relation("EncSignalementTraitePar", fields: [traiteParId], references: [id], onDelete: Restrict)
  traiteAt               DateTime?
  resolution             String?
  creeAt                 DateTime              @default(now())

  @@index([importId])
  @@index([contratId])
  @@index([statut])
  /// Onglet « À vérifier » : signalements à traiter, plus anciens d'abord (commit 6-0).
  @@index([statut, creeAt])
  /// Fiche police : signalements d'une ligne rejetée, retrouvés par n° de police (commit 6-0).
  @@index([numPolice])
}

// ---------------------------------------------------------------------------
// Planificateur intégré (fiabilisation du pointage, phase 2, 2026-10-14)
// ---------------------------------------------------------------------------

enum TacheNom {
  RELANCES_JUSTIFICATION
  ABSENCES
  PURGE
  RAPPELS_CONGES
  COMPTA_CONTROLE_HEBDO
  COMPTA_RELANCES
  COMPTA_RAPPEL_TCA
}

enum DeclenchementTache {
  PLANIFICATEUR
  MANUEL
}

enum StatutExecutionTache {
  SUCCES
  ECHEC
  IGNOREE
}

/// Paramètres du module Trésorerie modifiables par la Finance (lot I, 2026-10-19). Une ligne par paramètre, jamais
/// supprimée ; chaque changement est historisé dans `HistoriqueEntry` (entité `ParametreTresorerie`, entityId = `cle`).
/// `categorisation.obligatoire_a_partir_du` : `valeurDate` nul = la catégorisation n'est jamais obligatoire pour valider ;
/// sinon elle l'est à partir de ce jour (inclus). Posé à NUL par la migration : rien n'est bloqué au déploiement.
model ParametreTresorerie {
  cle        String    @id
  valeurDate DateTime? @db.Date
  majAt      DateTime  @default(now())
  majParId   String?
  majPar     User?     @relation("ParametreTresorerieMajPar", fields: [majParId], references: [id], onDelete: SetNull)
}

enum PorteeBudget {
  GLOBAL
  CATEGORIE
}

enum ModeSeuilBudget {
  POURCENTAGE
  MONTANT
}

enum StatutParametrageBudget {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum StatutDepassementBudget {
  /// Demandé par la Finance, en attente du DG.
  DEMANDE
  /// Confirmé par le DG (motif obligatoire), pas encore utilisé par une validation.
  CONFIRME
  /// Utilisé par la validation qu'il autorisait (à usage unique).
  UTILISE
}

/// Paramétrage de budget (lot J, 2026-10-19) : budget GLOBAL ou d'une CATÉGORIE, avec date d'effet (début, fin facultative) et
/// seuils d'alerte facultatifs. Soumis par la Finance, utilisable seulement une fois VALIDÉ par le DG ; jamais modifié en
/// place : un nouveau paramétrage remplace l'ancien à sa date d'effet (`budgetEnVigueur`, `backend/src/budgets.ts`), l'historique
/// reste. `categorieId` renseignée pour CATEGORIE seulement. Seuil : `modeSeuil` nul = aucune alerte ; sinon `seuilOrange` >
/// `seuilRouge` ≥ 0 (pourcentage restant ou montant restant). Les budgets existants avant le lot J sont repris par la migration
/// (`repris`, validés, début 2000-01-01, sans fin, seuil 20 % / 0 %) ; leur `soumisParId` est nul.
model BudgetParametrage {
  id              String                  @id @default(cuid())
  portee          PorteeBudget
  categorieId     String?
  categorie       Categorie?              @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  /// Budget d'une CATÉGORIE (saisi par la Finance). `null` pour le budget GLOBAL (lot J ter) : c'est le solde de caisse réel,
  /// jamais saisi — le paramétrage global ne porte que les seuils d'alerte (en montant).
  montant         Decimal?                @db.Decimal(14, 2)
  dateDebut       DateTime                @db.Date
  dateFin         DateTime?               @db.Date
  modeSeuil       ModeSeuilBudget?
  seuilOrange     Decimal?                @db.Decimal(14, 2)
  seuilRouge      Decimal?                @db.Decimal(14, 2)
  statut          StatutParametrageBudget @default(EN_ATTENTE)
  repris          Boolean                 @default(false)
  soumisParId     String?
  soumisPar       User?                   @relation("BudgetParametrageSoumisPar", fields: [soumisParId], references: [id])
  soumisAt        DateTime                @default(now())
  decideParId     String?
  decidePar       User?                   @relation("BudgetParametrageDecidePar", fields: [decideParId], references: [id])
  decideAt        DateTime?
  /// Obligatoire (10 caractères minimum depuis le lot M) quand le DG rejette ; `statut = REFUSE` reste la valeur interne (« Rejeté »).
  motifRefus      String?
  /// Lot M : motif OBLIGATOIRE (10 à 300 caractères) de l'envoi au DG par la Finance, et de la réponse du DG (validation comme
  /// rejet). `null` pour les paramétrages antérieurs au lot M (affichés « Non renseigné »).
  motifSoumission String?
  motifDecision   String?

  @@index([portee, categorieId, statut])
  @@index([statut, soumisAt])
}

/// Dépassement du seuil rouge d'un budget (lot J) : la validation d'une demande est bloquée tant que le DG n'a pas confirmé le
/// dépassement avec un motif. La Finance le DEMANDE (statut DEMANDE, `resume` = photo des périmètres en alerte) ; le DG le
/// CONFIRME (motif obligatoire) ; la validation qui s'en sert le fait passer à UTILISE (usage unique). Quand c'est le DG qui
/// valide, il confirme dans le même geste : la ligne est créée directement UTILISE (demandeur = confirmateur).
model BudgetDepassement {
  id            String                  @id @default(cuid())
  demandeId     String
  demande       Demande                 @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  statut        StatutDepassementBudget
  resume        String
  demandeParId  String
  demandePar    User                    @relation("BudgetDepassementDemandePar", fields: [demandeParId], references: [id])
  demandeAt     DateTime                @default(now())
  confirmeParId String?
  confirmePar   User?                   @relation("BudgetDepassementConfirmePar", fields: [confirmeParId], references: [id])
  confirmeAt    DateTime?
  motif         String?
  /// Lot M : motif OBLIGATOIRE (10 à 300 caractères) de la demande de confirmation faite au DG par la Finance (`motif` = celui du DG).
  motifDemande  String?
  utiliseAt     DateTime?
  /// Lot J bis : montants que cette confirmation couvre, par article (ou dépense directe) et par catégorie
  /// (`[{ ligneId, categorieId, montant }]`), posés à l'utilisation — le règlement de l'article peut les dépasser du reste du budget.
  couverture    Json?

  @@index([demandeId, statut])
  @@index([statut, demandeAt])
}

/// Une ligne par exécution d'une tâche planifiée, planifiée ou manuelle (moniteur de `/admin/journal-technique`).
/// `erreur` : texte court, sans donnée personnelle. `bilan` : chiffres de l'exécution (JSON).
model ExecutionTache {
  id            String               @id @default(cuid())
  tache         TacheNom
  declenchement DeclenchementTache
  debut         DateTime
  fin           DateTime
  statut        StatutExecutionTache
  bilan         Json?
  erreur        String?

  @@index([tache, debut])
}

// ---------------------------------------------------------------------------
// Journal technique (fiabilisation du pointage, phase 3, 2026-10-14)
// ---------------------------------------------------------------------------

enum NiveauJournal {
  ERREUR
  AVERTISSEMENT
}

enum SourceJournal {
  EMAIL
  PUSH
  TACHE
  IMPORT
  AUTRE
}

/// Incidents techniques (envoi d'e-mail ou de push en échec, tâche en échec, configuration absente) visibles dans
/// `/admin/journal-technique`. `contexte` : identifiants seulement (jamais de contenu d'e-mail, mot de passe ni jeton).
model JournalTechnique {
  id        String        @id @default(cuid())
  niveau    NiveauJournal
  source    SourceJournal
  /// Code court et stable (SMTP_ECHEC, FCM_ECHEC, TACHE_ECHEC…).
  code      String
  message   String
  contexte  Json?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

// ---------------------------------------------------------------------------
// Clôture initiale et réinitialisation du Pointage seul (2026-10-14)
// ---------------------------------------------------------------------------

/// Marqueurs « une seule fois » (ex : clôture initiale des justifications et absences en attente au premier passage du
/// planificateur en production). Jamais purgé : la clé est unique, l'insertion fait office de verrou.
model MarqueurUnique {
  cle    String   @id
  creeAt DateTime @default(now())
  bilan  Json?
}

/// Journal d'audit PERMANENT des purges du Pointage seul (jamais purgé) : une ligne par purge.
model ReinitialisationPointage {
  id               String   @id @default(cuid())
  effectueeAt      DateTime @default(now())
  effectueeParId   String
  effectueePar     User     @relation(fields: [effectueeParId], references: [id])
  /// Nombre de lignes supprimées par table.
  decompte         Json
  /// Empreinte SHA-256 de la sauvegarde JSON téléchargée juste avant la purge.
  sauvegardeSha256 String
}

/// Marqueur DÉFINITIF « le Pointage est en service » : posé une fois (`verrou` unique), il interdit toute nouvelle purge.
model PointageMiseEnService {
  id             String   @id @default(cuid())
  verrou         String   @unique @default("MISE_EN_SERVICE")
  misEnServiceAt DateTime @default(now())
  parId          String
  par            User     @relation(fields: [parId], references: [id])
}

/// Lot L (2026-10-27) — signature manuscrite (dessinée au curseur ou au doigt), enrôlée UNE fois dans le profil. Une ligne par
/// VERSION : une nouvelle signature ajoute une version, l'ancienne n'est jamais modifiée ni supprimée (les actions déjà signées
/// gardent celle qu'elles ont utilisée). La version courante d'un compte est la plus élevée. Traçabilité interne, PAS une
/// signature électronique qualifiée.
model SignatureUtilisateur {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation("SignatureUtilisateur", fields: [userId], references: [id])
  version   Int
  /// PNG validé et reconstruit côté serveur (IHDR + IDAT + IEND seulement).
  image     Bytes
  largeur   Int
  hauteur   Int
  /// SHA-256 (hexadécimal) de `image`.
  empreinte String
  creeAt    DateTime       @default(now())
  actions   ActionSignee[]

  @@unique([userId, version])
  @@index([userId])
}

/// Lot L — une action sensible signée : qui (signataire), avec quelle version de signature, quand, depuis quelle adresse IP.
/// Table à ajout seul. Aucune clé vers la demande (comme `HistoriqueEntry`) : `demandeId`/`ligneDemandeId` sont des repères.
/// `auNomDeId` : titulaire de la permission quand le signataire agit par délégation.
model ActionSignee {
  id             String               @id @default(cuid())
  signatureId    String
  signature      SignatureUtilisateur @relation(fields: [signatureId], references: [id])
  signataireId   String
  signataire     User                 @relation("ActionSigneeSignataire", fields: [signataireId], references: [id])
  auNomDeId      String?
  auNomDe        User?                @relation("ActionSigneeAuNomDe", fields: [auNomDeId], references: [id], onDelete: SetNull)
  action         String
  demandeId      String?
  ligneDemandeId String?
  entite         String?
  entiteId       String?
  ip             String
  creeAt         DateTime             @default(now())

  /// Lot L bis : les lignes d'historique que cette action a produites (lien par identifiant, plus de fenêtre de temps).
  historique HistoriqueEntry[]

  @@index([demandeId, creeAt])
  @@index([signataireId, creeAt])
  @@index([signatureId])
  @@index([auNomDeId])
}

// =====================================================================================================================
// Module « Gestion Compta » (docs/compta-conception.md §5) — préfixe `Cpt`, INDÉPENDANT des autres modules (décision V1).
// Socle COPIÉ du patron d'Encaissements (aucun lien de données avec les tables `Enc*`). Toutes les clés étrangères vers
// `User` sont en `Restrict`. Fonctions et triggers SQL `cpt_*` (ajouts manuels) : migration
// `20261101090000_compta_socle_technique`.
// =====================================================================================================================

enum CptStatutPeriode {
  OUVERTE
  CLOTUREE
}

/// Types de fichier importables (docs/compta-conception.md §7). Chaque type a ses formats paramétrables (`CptFormatImport`).
enum CptTypeImport {
  PRODUCTION
  RELEVE_WAVE_BUSINESS
  RELEVE_WAVE_HORS_BUSINESS
  RELEVE_BANQUE
  RELEVE_MICROFINANCE
  RELEVE_PEYAPAY
  BORDEREAU_PARTENAIRE
}

/// Mise en service du module : une seule ligne possible (CHECK id = 1), jamais modifiée ni supprimée (triggers).
model CptMiseEnService {
  id               Int      @id @default(1)
  activeeAt        DateTime @default(now())
  activeeParId     String
  activeePar       User     @relation("CptMiseEnServiceActiveePar", fields: [activeeParId], references: [id], onDelete: Restrict)
  /// Empreinte SHA-256 de la sauvegarde JSON téléchargée juste avant la remise à zéro.
  sauvegardeSha256 String
}

/// Compteurs de numérotation (CPE-AAAA, CPR-AAAA, CPD-AAAA). Incrément atomique uniquement (backend/src/cptSequence.ts),
/// jamais count()+1. Après mise en service : DELETE, baisse de valeur et renommage interdits (trigger).
model CptSequence {
  cle    String @id
  valeur Int    @default(0)
}

/// Paramètres du module (clé → valeur texte typée par backend/src/cptParametres.ts). `majParId` nul = valeur par défaut
/// jamais modifiée.
model CptParametre {
  cle      String   @id
  valeur   String
  majParId String?
  majPar   User?    @relation("CptParametreMajPar", fields: [majParId], references: [id], onDelete: Restrict)
  majAt    DateTime @default(now())
}

/// Journal d'audit du module, en ajout seul : UPDATE toujours interdit, DELETE/TRUNCATE interdits dès qu'une ligne
/// CptMiseEnService existe (triggers SQL). Écriture uniquement via backend/src/cptAudit.ts.
model CptAudit {
  id       BigInt    @id @default(autoincrement())
  entite   String
  entiteId String
  action   String
  avant    Json?
  apres    Json?
  motif    String?
  /// Mois de rattachement (1er du mois) pour le rapport « changements depuis la clôture ».
  mois     DateTime? @db.Date
  userId   String
  user     User      @relation("CptAuditUser", fields: [userId], references: [id], onDelete: Restrict)
  ip       String?
  at       DateTime  @default(now())

  @@index([entite, entiteId])
  @@index([mois, at])
  @@index([at])
}

/// Pièce jointe du module, séparée de PieceJointe et d'EncPieceJointe. Fichier déposé par une route d'upload propre au
/// module (uploads/), métadonnées recalculées côté serveur depuis le fichier.
model CptPieceJointe {
  id           String   @id @default(cuid())
  url          String   @unique
  nomOrigine   String?
  mime         String
  taille       Int
  sha256       String
  deposeeParId String
  deposeePar   User     @relation("CptPieceJointeDeposeePar", fields: [deposeeParId], references: [id], onDelete: Restrict)
  deposeeAt    DateTime @default(now())

  import CptImport?
  /// Rattachements dont cette pièce est le reçu de confirmation du commercial (GC-5).
  recusRattachements CptRattachement[] @relation("CptRattachementRecu")
  /// Déclarations de TCA dont cette pièce est la quittance (GC-8).
  quittancesTca CptDeclarationTca[] @relation("CptDeclarationTcaQuittance")

  @@index([sha256])
}

/// Période comptable (un mois). Une période CLOTUREE n'est plus modifiable : elle ne se rouvre pas et ne se supprime pas
/// (trigger, RG-08). Le contrôle des écritures datées dans une période clôturée viendra avec les tables de faits (GC-10).
model CptPeriode {
  id            String           @id @default(cuid())
  /// Premier jour du mois (contrainte CHECK en base).
  mois          DateTime         @unique @db.Date
  statut        CptStatutPeriode @default(OUVERTE)
  clotureeParId String?
  clotureePar   User?            @relation("CptPeriodeCloturePar", fields: [clotureeParId], references: [id], onDelete: Restrict)
  clotureeAt    DateTime?
  creeAt        DateTime         @default(now())

  @@index([statut])
}

/// Format d'un fichier à importer : correspondance « en-tête du fichier → champ interne », avec le type de chaque champ
/// (texte, date, montant) et le format des dates. Un changement de format de relevé = une modification de cette ligne,
/// jamais du code (docs/compta-conception.md §7). `colonnes` est validé par backend/src/cptFormatImport.ts.
/// Un seul format `parDefaut` par type (index unique partiel posé par la migration). Jamais lié à `User` : la trace de
/// qui a modifié un format est dans `CptAudit`.
model CptFormatImport {
  id          String        @id @default(cuid())
  type        CptTypeImport
  nom         String
  /// Ligne (à partir de 1) qui porte les en-têtes : certains relevés ont des lignes de titre avant. Borné 1 à 50 (CHECK).
  ligneEntete Int           @default(1)
  colonnes    Json
  parDefaut   Boolean       @default(false)
  actif       Boolean       @default(true)
  creeAt      DateTime      @default(now())
  majAt       DateTime      @updatedAt

  imports CptImport[]

  @@unique([type, nom])
}

// ---------------------------------------------------------------------------------------------------------------------
// GC-2 — Référentiels (docs/compta-conception.md §5.3). Migration `20261101140000_compta_referentiels`.
// ---------------------------------------------------------------------------------------------------------------------

/// Branche d'un produit (C-14 : quatre valeurs fixes, comme dans le cahier).
enum CptBranche {
  ACCIDENTS
  SANTE
  INCENDIE
  DECES
}

enum CptNatureContrat {
  INDIVIDUEL
  GROUPE
}

enum CptTypeCompte {
  WAVE_BUSINESS
  WAVE_HORS_BUSINESS
  BANQUE
  MICROFINANCE
  AGREGATEUR
  CAISSE
}

/// Ce qu'une convention rémunère.
enum CptNatureRemuneration {
  COMMISSION
  ACCESSOIRES
  HONORAIRES
}

/// Sur quel montant porte le taux d'une convention.
enum CptBaseConvention {
  PRIME_NETTE
  NETTE_PLUS_ACCESSOIRES
  TTC
}

/// Quand la rémunération devient exigible (C-4 : émission, ou encaissement au prorata).
enum CptFaitGenerateur {
  EMISSION
  ENCAISSEMENT
}

enum CptModeReglement {
  EN_UNE_FOIS
  AU_PRORATA
}

/// Partenaire (apporteur, bénéficiaire de rémunération, gestionnaire, client) : rôles multiples (booléens). Jamais supprimé :
/// on le désactive, la trace est dans `CptAudit`.
model CptPartenaire {
  id              String   @id @default(cuid())
  nom             String   @unique
  estApporteur    Boolean  @default(false)
  estBeneficiaire Boolean  @default(false)
  estGestionnaire Boolean  @default(false)
  estClient       Boolean  @default(false)
  coordonnees     String?
  tiersOdoo       String?
  actif           Boolean  @default(true)
  creeAt          DateTime @default(now())
  majAt           DateTime @updatedAt

  clientsOrigine          CptClient[]     @relation("CptClientPartenaireOrigine")
  conventions             CptConvention[] @relation("CptConventionPartenaire")
  conventionsApporteur    CptConvention[] @relation("CptConventionApporteur")
  conventionsBeneficiaire CptConvention[] @relation("CptConventionBeneficiaire")
  contratsApportes        CptContrat[]    @relation("CptContratApporteur")
  lignesRemuneration      CptLigneRemuneration[]        @relation("CptLigneRemunerationBeneficiaire")
  decisionsRemuneration   CptDecisionModeRemuneration[] @relation("CptDecisionModeRemunerationPartenaire")
  reglementsRecus         CptReglementPartenaire[]      @relation("CptReglementPartenaireDestinataire")
  compensations           CptCompensation[]             @relation("CptCompensationPartenaire")
}

model CptClient {
  id                  String         @id @default(cuid())
  nom                 String
  telephone           String?
  pieceIdentite       String?
  partenaireOrigineId String?
  partenaireOrigine   CptPartenaire? @relation("CptClientPartenaireOrigine", fields: [partenaireOrigineId], references: [id], onDelete: Restrict)
  tiersOdoo           String?
  creeAt              DateTime       @default(now())
  majAt               DateTime       @updatedAt

  contrats  CptContrat[]
  relances  CptRelance[]
  promesses CptPromesse[]

  @@index([nom])
  @@index([telephone])
  @@index([partenaireOrigineId])
}

/// Produit d'assurance. `code` est la clé métier (référencée par les taux de TCA et les conventions) : il ne change pas.
model CptProduit {
  id             String     @id @default(cuid())
  code           String     @unique
  libelle        String
  branche        CptBranche
  tarifReference Decimal?   @db.Decimal(14, 2)
  compteOdoo     String?
  actif          Boolean    @default(true)
  creeAt         DateTime   @default(now())
  majAt          DateTime   @updatedAt

  tauxTca     CptTauxTca[]
  conventions CptConvention[]
  contrats    CptContrat[]
}

/// Taux de TCA daté, en fraction (0,0725 = 7,25 %). JAMAIS MODIFIÉ : un changement de taux est une NOUVELLE ligne datée,
/// l'ancienne reste intacte (trigger SQL ; suppression interdite après la mise en service). Unicité (branche, produit,
/// nature, date d'effet) posée par la migration avec `NULLS NOT DISTINCT` (Prisma ne sait pas la modéliser, sans écart
/// signalé par `migrate diff`). Choix du taux applicable : backend/src/cptReferentiels.ts (`tauxTcaEnVigueur`).
model CptTauxTca {
  id            String            @id @default(cuid())
  branche       CptBranche
  produitCode   String?
  produit       CptProduit?       @relation(fields: [produitCode], references: [code], onDelete: Restrict)
  natureContrat CptNatureContrat?
  taux          Decimal           @db.Decimal(7, 6)
  dateEffet     DateTime          @db.Date
  creeParId     String
  creePar       User              @relation("CptTauxTcaCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt        DateTime          @default(now())

  /// Même nom que l'index de la migration, qui ajoute `NULLS NOT DISTINCT` (non modélisable) : sans cette déclaration,
  /// `migrate diff` réclamerait sa suppression.
  @@unique([branche, produitCode, natureContrat, dateEffet], map: "CptTauxTca_unique_portee_date")
  @@index([dateEffet])
  @@index([branche, dateEffet])
}

/// Compte d'encaissement (Wave, banque, microfinance, caisse…).
model CptCompte {
  id          String        @id @default(cuid())
  libelle     String
  type        CptTypeCompte
  journalOdoo String?
  compteOdoo  String?
  actif       Boolean       @default(true)
  creeAt      DateTime      @default(now())
  majAt       DateTime      @updatedAt

  imports            CptImport[]
  encaissements      CptEncaissement[]
  releves            CptReleve[]
  transfertsSortants CptTransfertInterne[] @relation("CptTransfertSource")
  transfertsEntrants CptTransfertInterne[] @relation("CptTransfertCible")

  @@index([type])
}

/// Convention de rémunération d'un partenaire. Seule `dateFin` peut changer après la création (clôture de la convention,
/// trigger SQL) ; le reste se corrige en créant une nouvelle convention. Pas de chevauchement pour (partenaire, produit,
/// nature, apporteur) : contrôlé par backend/src/cptReferentiels.ts sous verrou (pas de contrainte d'exclusion en base,
/// elle exigerait une extension). `produitCode` nul = tous les produits ; `apporteurId` nul = tout apporteur.
model CptConvention {
  id             String                @id @default(cuid())
  partenaireId   String
  partenaire     CptPartenaire         @relation("CptConventionPartenaire", fields: [partenaireId], references: [id], onDelete: Restrict)
  produitCode    String?
  produit        CptProduit?           @relation(fields: [produitCode], references: [code], onDelete: Restrict)
  nature         CptNatureRemuneration
  taux           Decimal               @db.Decimal(7, 6)
  base           CptBaseConvention
  faitGenerateur CptFaitGenerateur
  apporteurId    String?
  apporteur      CptPartenaire?        @relation("CptConventionApporteur", fields: [apporteurId], references: [id], onDelete: Restrict)
  beneficiaireId String?
  beneficiaire   CptPartenaire?        @relation("CptConventionBeneficiaire", fields: [beneficiaireId], references: [id], onDelete: Restrict)
  modeReglement  CptModeReglement
  dateEffet      DateTime              @db.Date
  dateFin        DateTime?             @db.Date
  creeParId      String
  creePar        User                  @relation("CptConventionCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt         DateTime              @default(now())

  lignesRemuneration CptLigneRemuneration[]

  @@index([partenaireId, nature, dateEffet])
}

/// Index de recherche par début de mot des fiches de Gestion Compta (lot GC-2d) : un mot normalisé par ligne (minuscules, sans
/// accents). `entite` = CLIENT, PARTENAIRE, PRODUIT (puis CONTRAT au lot GC-3) ; pas de clé étrangère : l'entrée est
/// réécrite par la même transaction que la fiche (backend/src/cptRecherche.ts). La colonne `mot` est créée en collation « C »
/// par la migration (Prisma ne la modélise pas, `migrate diff` ne la voit pas) : c'est ce qui permet à un btree ordinaire de
/// servir `LIKE 'x%'`, comme `EncContratMot`.
model CptMot {
  entite   String
  entiteId String
  mot      String

  @@id([entite, entiteId, mot])
  @@index([mot, entite, entiteId])
}

// ---------------------------------------------------------------------------------------------------------------------
// GC-3 — Production, actes, échéancier (docs/compta-conception.md §5.4). Migration `20261101160000_compta_production`.
// ---------------------------------------------------------------------------------------------------------------------

enum CptStatutContrat {
  EN_COURS
  ECHU
  ANNULE
  RESILIE
}

/// Acte de gestion d'un contrat. Les montants d'un acte sont SIGNÉS : un retrait, une ristourne ou une annulation les
/// portent en négatif (la prime du contrat n'est jamais réécrite, c'est la somme des actes qui la fait évoluer).
enum CptTypeActe {
  AFFAIRE_NOUVELLE
  RENOUVELLEMENT
  TRANCHE
  AVENANT_INCORPORATION
  RETRAIT
  RISTOURNE
  ANNULATION
}

enum CptFractionnement {
  COMPTANT
  MENSUEL
  TRIMESTRIEL
  SEMESTRIEL
  LIBRE
}

enum CptEtatEcheance {
  OUVERTE
  SOLDEE
  ANNULEE
}

enum CptStatutImport {
  VALIDE
  ANNULE
}

enum CptStatutAnomalie {
  A_TRAITER
  TRAITEE
}

/// Contrat (une police). `numPolice` est la clé métier unique : le même contrat réimporté est mis à jour, jamais dupliqué.
/// Les montants sont ceux du contrat initial ; les évolutions (avenants, retraits) sont des `CptActe`. `declarePaye` et les
/// champs `*Declare*` sont ce que le TECHNIQUE déclare : jamais une preuve d'encaissement (RG-01, seul un rattachement VALIDE
/// rend une prime payée). Aucune règle de cohérence TTC = HT + accessoires + taxe en base : un écart est une anomalie de
/// saisie signalée à l'import (lecture permissive, docs/compta-conception.md §7).
model CptContrat {
  id                        String            @id @default(cuid())
  numPolice                 String            @unique
  produitId                 String
  produit                   CptProduit        @relation(fields: [produitId], references: [id], onDelete: Restrict)
  natureContrat             CptNatureContrat
  clientId                  String
  client                    CptClient         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  partenaireApporteurId     String?
  partenaireApporteur       CptPartenaire?    @relation("CptContratApporteur", fields: [partenaireApporteurId], references: [id], onDelete: Restrict)
  dateEffet                 DateTime          @db.Date
  dateEcheance              DateTime          @db.Date
  statut                    CptStatutContrat  @default(EN_COURS)
  fractionnement            CptFractionnement @default(COMPTANT)
  /// Taux de TCA propre au contrat (SECURPRO, Q7 ouverte) ; nul = taux du référentiel à la date d'effet.
  tauxTcaContrat            Decimal?          @db.Decimal(7, 6)
  primeNetteHt              Decimal           @db.Decimal(14, 2)
  accessoiresHt             Decimal           @default(0) @db.Decimal(14, 2)
  taxe                      Decimal           @default(0) @db.Decimal(14, 2)
  primeTtc                  Decimal           @db.Decimal(14, 2)
  declarePaye               Boolean           @default(false)
  modePaiementDeclare       String?
  referencePaiementDeclaree String?
  datePaiementDeclaree      DateTime?         @db.Date
  /// Montants lus dans le bordereau à la création du contrat (C-39) ; nul = colonne absente ou vide, ou import antérieur.
  commissionDeclaree        Decimal?          @db.Decimal(14, 2)
  gestionDeclaree           Decimal?          @db.Decimal(14, 2)
  contratOrigineId          String?
  contratOrigine            CptContrat?       @relation("CptContratOrigine", fields: [contratOrigineId], references: [id], onDelete: Restrict)
  contratsSuivants          CptContrat[]      @relation("CptContratOrigine")
  importId                  String?
  import                    CptImport?        @relation("CptContratImport", fields: [importId], references: [id], onDelete: Restrict)
  creeParId                 String
  creePar                   User              @relation("CptContratCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt                    DateTime          @default(now())
  majAt                     DateTime          @updatedAt

  actes     CptActe[]
  echeances CptEcheance[]

  lignesRemuneration    CptLigneRemuneration[]
  decisionsRemuneration CptDecisionModeRemuneration[]

  @@index([clientId])
  @@index([partenaireApporteurId])
  @@index([produitId])
  @@index([statut])
  @@index([referencePaiementDeclaree])
  @@index([importId])
}

/// Acte sur un contrat (conception §5.4). Ajout seul : une erreur se corrige par un acte inverse, jamais par une modification.
model CptActe {
  id            String      @id @default(cuid())
  contratId     String
  contrat       CptContrat  @relation(fields: [contratId], references: [id], onDelete: Restrict)
  type          CptTypeActe
  date          DateTime    @db.Date
  /// Montants SIGNÉS de l'acte (négatifs pour un retrait, une ristourne ou une annulation).
  primeNetteHt  Decimal     @default(0) @db.Decimal(14, 2)
  accessoiresHt Decimal     @default(0) @db.Decimal(14, 2)
  taxe          Decimal     @default(0) @db.Decimal(14, 2)
  primeTtc      Decimal     @default(0) @db.Decimal(14, 2)
  /// Acte annulé ou corrigé par celui-ci (retrait qui annule une tranche, par exemple).
  acteOrigineId String?
  acteOrigine   CptActe?    @relation("CptActeOrigine", fields: [acteOrigineId], references: [id], onDelete: Restrict)
  actesLies     CptActe[]   @relation("CptActeOrigine")
  motif         String?
  importId      String?
  import        CptImport?  @relation("CptActeImport", fields: [importId], references: [id], onDelete: Restrict)
  creeParId     String
  creePar       User        @relation("CptActeCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt        DateTime    @default(now())

  @@index([contratId, date])
  @@index([importId])
}

/// Échéance d'un contrat. `montantRegle` est DÉNORMALISÉ : il n'est mis à jour que dans la transaction qui valide un
/// rattachement (GC-5), jamais ailleurs. Σ des échéances non annulées = prime du contrat (contrôlé par
/// backend/src/cptEcheancier.ts, reliquat sur la dernière).
model CptEcheance {
  id           String          @id @default(cuid())
  contratId    String
  contrat      CptContrat      @relation(fields: [contratId], references: [id], onDelete: Restrict)
  rang         Int
  periodeDebut DateTime        @db.Date
  periodeFin   DateTime        @db.Date
  datePrevue   DateTime        @db.Date
  primeTtc     Decimal         @db.Decimal(14, 2)
  primeHt      Decimal         @db.Decimal(14, 2)
  accessoires  Decimal         @default(0) @db.Decimal(14, 2)
  taxe         Decimal         @default(0) @db.Decimal(14, 2)
  montantDu    Decimal         @db.Decimal(14, 2)
  montantRegle Decimal         @default(0) @db.Decimal(14, 2)
  etat         CptEtatEcheance @default(OUVERTE)
  creeAt       DateTime        @default(now())
  majAt        DateTime        @updatedAt

  rattachements CptRattachement[]
  lignesTaxeImputees CptLigneTaxe[] @relation("CptLigneTaxeImputeeSur")
  lignesTaxe         CptLigneTaxe[] @relation("CptLigneTaxeEcheance")

  lignesRemuneration CptLigneRemuneration[]

  @@unique([contratId, rang])
  @@index([contratId, etat])
  @@index([etat, datePrevue])
}

/// Import d'un fichier (production, relevé, bordereau). Un même fichier ne s'importe qu'une fois : `empreinte` (SHA-256 du
/// contenu) ET `fichierId` sont uniques (T9). `bilan` : décompte (lignes lues, créées, modifiées, rejetées, anomalies).
model CptImport {
  id        String           @id @default(cuid())
  type      CptTypeImport
  formatId  String?
  format    CptFormatImport? @relation(fields: [formatId], references: [id], onDelete: Restrict)
  fichierId String           @unique
  fichier   CptPieceJointe   @relation(fields: [fichierId], references: [id], onDelete: Restrict)
  empreinte String           @unique
  /// Compte et mois concernés (relevés, GC-4) ; nuls pour un bordereau de production.
  compteId  String?
  compte    CptCompte?       @relation(fields: [compteId], references: [id], onDelete: Restrict)
  periode   DateTime?        @db.Date
  statut    CptStatutImport  @default(VALIDE)
  bilan     Json?
  creeParId String
  creePar   User             @relation("CptImportCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt    DateTime         @default(now())

  contrats  CptContrat[]  @relation("CptContratImport")
  actes     CptActe[]     @relation("CptActeImport")
  anomalies CptAnomalie[]
  /// Relevé produit par cet import (types RELEVE_*, GC-4) ; nul pour un bordereau de production.
  releve    CptReleve?

  @@index([type, creeAt])
}

/// Anomalie à traiter (import, contrôle de saisie, écart…). `objetEntite` + `objetId` désignent la fiche concernée, sans clé
/// étrangère : une anomalie survit à la correction de sa cible. Traitée = `statut` TRAITEE avec `traiteePar` et `resolution`.
model CptAnomalie {
  id           String            @id @default(cuid())
  type         String
  objetEntite  String
  objetId      String
  detail       Json?
  statut       CptStatutAnomalie @default(A_TRAITER)
  importId     String?
  import       CptImport?        @relation(fields: [importId], references: [id], onDelete: Restrict)
  traiteeParId String?
  traiteePar   User?             @relation("CptAnomalieTraiteePar", fields: [traiteeParId], references: [id], onDelete: Restrict)
  traiteeAt    DateTime?
  resolution   String?
  creeAt       DateTime          @default(now())

  @@index([statut, creeAt])
  @@index([objetEntite, objetId])
  @@index([importId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Gestion Compta, lot GC-4a : encaissements et relevés (docs/compta-conception.md §5.5). Le rattachement d'un encaissement
// à des échéances (CptRattachement) arrive au lot GC-5a.
// ---------------------------------------------------------------------------------------------------------------------

/// Nature d'une ligne de relevé. Seul `ENCAISSEMENT` est un crédit à rattacher à des primes ; les autres lignes sont
/// reconnues à l'import (remboursement, transaction test, frais, virement entre deux comptes du groupe) et ne sont jamais
/// comptées comme des primes. Le sens (entrée / sortie) est porté par le type : `montant` est toujours positif.
enum CptTypeFlux {
  ENCAISSEMENT
  VIREMENT_INTERNE_ENTRANT
  VIREMENT_INTERNE_SORTANT
  REMBOURSEMENT
  TEST
  FRAIS
  AUTRE_DEBIT
}

/// État de traitement d'un encaissement : à rattacher (il reste de l'argent sans destination), soldé (tout est rattaché ou
/// classé « pas une prime »), sans objet (ligne qui n'est pas un encaissement de prime : aucun rattachement à faire).
enum CptStatutEncaissement {
  A_RATTACHER
  SOLDE
  SANS_OBJET
}

enum CptStatutCheque {
  RECU
  REMIS_EN_BANQUE
  IMPAYE
}

/// Une ligne d'un compte d'encaissement (relevé importé, ou saisie de chèque / d'espèces). Identité = (compte, référence du
/// relevé) : la même ligne importée deux fois ne crée rien (RG-04, T9). Les champs qui décrivent la ligne ne changent jamais
/// (trigger SQL) ; seuls l'avancement du rattachement, le classement « pas une prime » et les champs comptables Odoo changent.
/// Invariant maintenu par le moteur de rattachement (GC-5) : Σ rattachements validés + `montantPasUnePrime` + `resteARattacher`
/// = `montant` pour un encaissement.
model CptEncaissement {
  id                   String                @id @default(cuid())
  /// Identifiant métier CPE-AAAA-NNNNNN (séquence atomique).
  reference            String                @unique
  compteId             String
  compte               CptCompte             @relation(fields: [compteId], references: [id], onDelete: Restrict)
  /// Identifiant de la ligne chez l'opérateur (T_…, référence bancaire, « CHQ-… », reçu de caisse).
  referenceReleve      String
  dateValeur           DateTime              @db.Date
  /// Montant brut, toujours positif ; le sens vient de `typeFlux`.
  montant              Decimal               @db.Decimal(14, 2)
  /// Frais retenus par l'opérateur (relevés Wave) ; le net reçu est `montant - frais`.
  frais                Decimal               @default(0) @db.Decimal(14, 2)
  typeFlux             CptTypeFlux
  /// Type d'origine chez l'opérateur (merchant_payment, api_checkout, refund…), conservé tel quel.
  typeSource           String?
  payeur               String?
  telephone            String?
  /// Référence saisie par le payeur (souvent un numéro de police) : base du rattachement par référence.
  referenceClient      String?
  libelle              String?
  /// Session de paiement (cos-…, Wave Business).
  sessionPaiement      String?
  statut               CptStatutEncaissement @default(A_RATTACHER)
  /// Part de l'encaissement qui n'est encore rattachée à aucune échéance ni classée.
  resteARattacher      Decimal               @db.Decimal(14, 2)
  /// Part classée « pas une prime » (frais de carte santé, remboursement reçu…) : motif écrit obligatoire (RG-03).
  montantPasUnePrime   Decimal               @default(0) @db.Decimal(14, 2)
  motifPasUnePrime     String?
  releveId             String?
  releve               CptReleve?            @relation(fields: [releveId], references: [id], onDelete: Restrict)
  /// Rang de la ligne dans le relevé (à partir de 1).
  ligneReleve          Int?
  pieceOdoo            String?
  dateComptabilisation DateTime?             @db.Date
  /// Repris de l'ancien classeur à la mise en service (GC-11).
  reprise              Boolean               @default(false)
  creeParId            String
  creePar              User                  @relation("CptEncaissementCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt               DateTime              @default(now())
  majAt                DateTime              @updatedAt

  lignesTaxe       CptLigneTaxe[]

  transfertSortant CptTransfertInterne? @relation("CptTransfertSortant")
  transfertEntrant CptTransfertInterne? @relation("CptTransfertEntrant")
  cheque           CptCheque?
  rattachements    CptRattachement[]

  @@unique([compteId, referenceReleve])
  @@index([statut, dateValeur])
  @@index([compteId, dateValeur])
  @@index([releveId])
  @@index([referenceClient])
  @@index([telephone])
}

enum CptMethodeRattachement {
  REFERENCE_EXACTE
  REFERENCE_INCOMPLETE
  MONTANT_DATE
  GROUPE
  PROBABLE
  MANUELLE
}

enum CptNiveauPreuve {
  PREUVE
  DEDUCTION
  A_CONFIRMER
}

enum CptStatutRattachement {
  PROPOSE
  CONFIRME
  VALIDE
  REJETE
}

/// Objet d'un palier du contrôle hebdomadaire (lot GC-6b) : un encaissement sans contrat ou un contrat déclaré payé sans encaissement.
enum CptObjetControle {
  ENCAISSEMENT
  CONTRAT
  ECART_REMUNERATION
}

/// Palier d'ancienneté : relance (7 jours), alerte (30), escalade (60), seuils lus dans `CptParametre`.
enum CptPalierControle {
  RELANCE
  ALERTE
  ESCALADE
}

/// Réservation d'un palier du contrôle hebdomadaire pour une ligne (conception §9, GC-6b). Une ligne par (objet, identifiant, palier) :
/// la contrainte d'unicité est le verrou d'idempotence — le palier est réservé AVANT tout envoi, une seconde exécution ne peut pas
/// le réserver à son tour, donc ne l'envoie pas. `envoyeeAt` nul = palier réservé SANS envoi (arriéré d'avant la mise en service,
/// paliers inférieurs franchis d'un coup) : il n'est jamais notifié plus tard. Référence polymorphe (`objetId` sans clé étrangère).
model CptAlerteControle {
  id        String            @id @default(cuid())
  objet     CptObjetControle
  objetId   String
  palier    CptPalierControle
  envoyeeAt DateTime?
  creeAt    DateTime          @default(now())
  /// Montants d'une alerte d'écart de rémunération (C-39) ; nul pour les paliers de relance.
  detail    Json?

  @@unique([objet, objetId, palier])
  @@index([objet, palier])
}

/// Rattachement d'une part d'un encaissement à une échéance (conception §5.5 et §6.2). Deux étapes : le commercial CONFIRME avec le
/// reçu (niveaux déduction et à confirmer, identifications manuelles), puis le RFCRH VALIDE (jamais automatique, RG-02). Seul un
/// rattachement VALIDE rend la prime payée (RG-01). Les champs qui décrivent la proposition ne changent jamais (trigger SQL), le statut
/// n'avance que dans un sens, et la validation est contrôlée EN BASE (Σ validés ≤ encaissement et ≤ montant dû, sous verrou).
model CptRattachement {
  id                 String                 @id @default(cuid())
  encaissementId     String
  encaissement       CptEncaissement        @relation(fields: [encaissementId], references: [id], onDelete: Restrict)
  echeanceId         String
  echeance           CptEcheance            @relation(fields: [echeanceId], references: [id], onDelete: Restrict)
  montant            Decimal                @db.Decimal(14, 2)
  methode            CptMethodeRattachement
  niveauPreuve       CptNiveauPreuve
  statut             CptStatutRattachement  @default(PROPOSE)
  /// Propositions d'un même groupe (méthode 4) : elles se valident ensemble.
  groupe             String?
  /// Phrase du moteur (ou du commercial pour une identification manuelle) qui explique la proposition.
  justification      String
  /// Nul = proposé par le moteur.
  proposeParId       String?
  proposePar         User?                  @relation("CptRattachementProposePar", fields: [proposeParId], references: [id], onDelete: Restrict)
  confirmeParId      String?
  confirmePar        User?                  @relation("CptRattachementConfirmePar", fields: [confirmeParId], references: [id], onDelete: Restrict)
  confirmeAt         DateTime?
  /// Reçu de la confirmation : référence saisie et/ou pièce jointe (l'un des deux au moins).
  recuReference      String?
  recuPieceId        String?
  recuPiece          CptPieceJointe?        @relation("CptRattachementRecu", fields: [recuPieceId], references: [id], onDelete: Restrict)
  commentaireConfirmation String?
  valideParId        String?
  validePar          User?                  @relation("CptRattachementValidePar", fields: [valideParId], references: [id], onDelete: Restrict)
  valideAt           DateTime?
  rejeteParId        String?
  rejetePar          User?                  @relation("CptRattachementRejetePar", fields: [rejeteParId], references: [id], onDelete: Restrict)
  rejeteAt           DateTime?
  motifRejet         String?
  /// Repris de l'ancien classeur à la mise en service (GC-11) : pas d'étape de confirmation.
  reprise            Boolean                @default(false)
  creeAt             DateTime               @default(now())
  majAt              DateTime               @updatedAt

  lignesTaxe CptLigneTaxe[]

  @@index([encaissementId, statut])
  @@index([echeanceId, statut])
  @@index([statut, niveauPreuve])
  @@index([groupe])
}

/// Relevé importé d'un compte pour un mois. Un relevé par import (`importId` unique) ; plusieurs relevés d'un même mois sont
/// possibles (exports partiels) : le contrôle mensuel les additionne. Jamais modifié après sa création.
model CptReleve {
  id           String    @id @default(cuid())
  importId     String    @unique
  import       CptImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  compteId     String
  compte       CptCompte @relation(fields: [compteId], references: [id], onDelete: Restrict)
  /// Premier jour du mois couvert.
  periode      DateTime  @db.Date
  nbLignes     Int
  totalCredits Decimal   @db.Decimal(14, 2)
  totalFrais   Decimal   @default(0) @db.Decimal(14, 2)
  creeAt       DateTime  @default(now())

  encaissements CptEncaissement[]

  @@index([compteId, periode])
}

/// Virement entre deux comptes du groupe (Wave → banque…) : une ligne sortante et une ligne entrante rapprochées. Jamais
/// compté comme un encaissement de prime. Jamais modifié (une erreur se défait avant la mise en service, ou par un nouveau
/// rapprochement après).
model CptTransfertInterne {
  id                    String          @id @default(cuid())
  encaissementSortantId String          @unique
  encaissementSortant   CptEncaissement @relation("CptTransfertSortant", fields: [encaissementSortantId], references: [id], onDelete: Restrict)
  encaissementEntrantId String          @unique
  encaissementEntrant   CptEncaissement @relation("CptTransfertEntrant", fields: [encaissementEntrantId], references: [id], onDelete: Restrict)
  compteSourceId        String
  compteSource          CptCompte       @relation("CptTransfertSource", fields: [compteSourceId], references: [id], onDelete: Restrict)
  compteCibleId         String
  compteCible           CptCompte       @relation("CptTransfertCible", fields: [compteCibleId], references: [id], onDelete: Restrict)
  creeParId             String
  creePar               User            @relation("CptTransfertCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt                DateTime        @default(now())
}

/// Chèque reçu : de la réception à la remise en banque. L'encaissement n'existe qu'une fois le chèque remis sur un compte
/// bancaire (`encaissementId` nul tant que le chèque est seulement reçu). Les espèces n'ont pas de table : un reçu de caisse
/// est un encaissement du compte de type CAISSE.
model CptCheque {
  id               String           @id @default(cuid())
  encaissementId   String?          @unique
  encaissement     CptEncaissement? @relation(fields: [encaissementId], references: [id], onDelete: Restrict)
  dateReception    DateTime         @db.Date
  numero           String
  tireur           String
  montant          Decimal          @db.Decimal(14, 2)
  dateRemiseBanque DateTime?        @db.Date
  statut           CptStatutCheque  @default(RECU)
  creeParId        String
  creePar          User             @relation("CptChequeCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt           DateTime         @default(now())
  majAt            DateTime         @updatedAt

  @@index([statut])
  @@index([numero])
}

// ---------------------------------------------------------------------------------------------------------------------
// GC-7d — relances faites hors de l'application et promesses de paiement (Q10, option A, provisoire : aucun envoi).
// ---------------------------------------------------------------------------------------------------------------------

enum CptCanalRelance {
  TELEPHONE
  SMS
  VISITE
  EMAIL
}

/// Qui a écrit la relance : une personne (MANUELLE) ou un futur envoi automatique (AUTOMATIQUE, Q10 option B), sans changer le modèle.
enum CptOrigineRelance {
  MANUELLE
  AUTOMATIQUE
}

enum CptStatutPromesse {
  EN_COURS
  TENUE
  NON_TENUE
}

/// Relance d'un client, faite hors de l'application (ajout seul : une erreur se signale par une nouvelle ligne, jamais une modification).
model CptRelance {
  id          String            @id @default(cuid())
  clientId    String
  client      CptClient         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  canal       CptCanalRelance
  origine     CptOrigineRelance @default(MANUELLE)
  faiteLe     DateTime          @db.Date
  commentaire String?
  creeParId   String
  creePar     User              @relation("CptRelanceCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt      DateTime          @default(now())

  promesses CptPromesse[]

  @@index([clientId, faiteLe])
}

/// Promesse de paiement d'un client. Son statut ne se choisit jamais : il passe de EN_COURS à TENUE ou NON_TENUE par la règle de
/// `backend/src/cptRelances.ts` (encaissé prouvé), une seule fois (trigger), avec le montant prouvé constaté et la date d'évaluation.
model CptPromesse {
  id            String            @id @default(cuid())
  clientId      String
  client        CptClient         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  relanceId     String?
  relance       CptRelance?       @relation(fields: [relanceId], references: [id], onDelete: Restrict)
  montant       Decimal           @db.Decimal(14, 2)
  datePromise   DateTime          @db.Date
  statut        CptStatutPromesse @default(EN_COURS)
  evalueAt      DateTime?
  montantProuve Decimal?          @db.Decimal(14, 2)
  creeParId     String
  creePar       User              @relation("CptPromesseCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt        DateTime          @default(now())

  @@index([clientId, statut])
  @@index([statut, datePromise])
}


// ---------------------------------------------------------------------------------------------------------------------
// GC-8 : taxe sur les contrats (TCA). Moteur : backend/src/cptTaxe.ts ; écritures : backend/src/cptTaxeDb.ts.
// ---------------------------------------------------------------------------------------------------------------------

/// AVANCE : taxe estimée sur un encaissement pas (encore) rattaché (produit ou contrat connu : cas 2 et 3 du plan 7.1).
/// RATTACHEMENT : taxe du contrat au prorata d'un rattachement VALIDÉ. IMPUTATION : ligne NÉGATIVE qui annule la part d'une avance
/// couverte par un rattachement validé (la taxe déjà payée n'est jamais redemandée).
enum CptOrigineLigneTaxe {
  AVANCE
  RATTACHEMENT
  IMPUTATION
}

enum CptStatutDeclarationTca {
  DECLAREE
  PAYEE
}

enum CptOrigineCreditTaxe {
  TROP_PAYE
  CORRECTION_TAUX
}

enum CptStatutCreditTaxe {
  A_RECUPERER
  RECUPERE
}

/// Ligne de taxe. Ajout seul : seule l'affectation à une déclaration (`declarationId`, de nul à une valeur) est permise, puis la
/// ligne est VERROUILLÉE (trigger). `montant` est signé (une imputation est négative). Mois = 1er du mois (CHECK).
model CptLigneTaxe {
  id                   String              @id @default(cuid())
  origine              CptOrigineLigneTaxe
  moisDeclaration      DateTime            @db.Date
  encaissementId       String?
  encaissement         CptEncaissement?    @relation(fields: [encaissementId], references: [id], onDelete: Restrict)
  rattachementId       String?
  rattachement         CptRattachement?    @relation(fields: [rattachementId], references: [id], onDelete: Restrict)
  echeanceId           String?
  echeance             CptEcheance?        @relation("CptLigneTaxeEcheance", fields: [echeanceId], references: [id], onDelete: Restrict)
  contratId            String?
  produitCode          String?
  branche              CptBranche?
  /// Montant TTC sur lequel la taxe contenue est calculée (signé pour une imputation).
  base                 Decimal             @db.Decimal(14, 2)
  /// Primes et accessoires hors taxe de la base (pour l'état par taux).
  primeHt              Decimal             @default(0) @db.Decimal(14, 2)
  accessoiresHt        Decimal             @default(0) @db.Decimal(14, 2)
  taux                 Decimal             @db.Decimal(7, 6)
  montant              Decimal             @db.Decimal(14, 2)
  /// Imputation : l'avance dont une part est annulée, et l'échéance sur laquelle elle est imputée.
  ligneAvanceId        String?
  ligneAvance          CptLigneTaxe?       @relation("CptLigneTaxeAvance", fields: [ligneAvanceId], references: [id], onDelete: Restrict)
  imputations          CptLigneTaxe[]      @relation("CptLigneTaxeAvance")
  imputeeSurEcheanceId String?
  imputeeSurEcheance   CptEcheance?        @relation("CptLigneTaxeImputeeSur", fields: [imputeeSurEcheanceId], references: [id], onDelete: Restrict)
  declarationId        String?
  declaration          CptDeclarationTca?  @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  creeParId            String
  creePar              User                @relation("CptLigneTaxeCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt               DateTime            @default(now())

  @@index([moisDeclaration])
  @@index([declarationId])
  @@index([encaissementId])
  @@index([rattachementId])
  @@index([ligneAvanceId])
  @@index([contratId])
}

/// Déclaration de TCA d'un mois (`CPD-AAAA-NN`, une seule par mois). Montants figés à la déclaration ; seul le paiement
/// (quittance) s'ajoute ensuite, une fois (trigger).
model CptDeclarationTca {
  id               String                  @id @default(cuid())
  reference        String                  @unique
  mois             DateTime                @unique @db.Date
  statut           CptStatutDeclarationTca @default(DECLAREE)
  /// Taxe due cumulée jusqu'à ce mois (corrections comprises).
  montantDu        Decimal                 @db.Decimal(14, 2)
  /// Taxe déjà engagée par les déclarations précédentes (quittance si payée, sinon montant à payer).
  montantDejaPaye  Decimal                 @db.Decimal(14, 2)
  /// Part des corrections (imputations) dans `montantDu`, pour information.
  corrections      Decimal                 @default(0) @db.Decimal(14, 2)
  montantAPayer    Decimal                 @db.Decimal(14, 2)
  nbLignes         Int
  declareParId     String
  declarePar       User                    @relation("CptDeclarationTcaDeclarePar", fields: [declareParId], references: [id], onDelete: Restrict)
  declareAt        DateTime                @default(now())
  quittanceNumero  String?
  quittanceDate    DateTime?               @db.Date
  quittanceMontant Decimal?                @db.Decimal(14, 2)
  datePaiement     DateTime?               @db.Date
  quittancePieceId String?
  quittancePiece   CptPieceJointe?         @relation("CptDeclarationTcaQuittance", fields: [quittancePieceId], references: [id], onDelete: Restrict)
  pieceOdoo        String?
  payeParId        String?
  payePar          User?                   @relation("CptDeclarationTcaPayePar", fields: [payeParId], references: [id], onDelete: Restrict)
  payeAt           DateTime?

  lignes  CptLigneTaxe[]
  credits CptCreditTaxe[] @relation("CptCreditTaxeNe")
  creditsRecuperes CptCreditTaxe[] @relation("CptCreditTaxeRecupere")

  @@index([statut])
}

/// Crédit de taxe : trop-payé reporté. Né d'une déclaration (montant à payer négatif) ou d'un paiement supérieur au dû ;
/// récupéré (une fois) à la déclaration qui l'absorbe.
model CptCreditTaxe {
  id             String               @id @default(cuid())
  origine        CptOrigineCreditTaxe
  declarationId  String
  declaration    CptDeclarationTca    @relation("CptCreditTaxeNe", fields: [declarationId], references: [id], onDelete: Restrict)
  montant        Decimal              @db.Decimal(14, 2)
  statut         CptStatutCreditTaxe  @default(A_RECUPERER)
  recupereDansId String?
  recupereDans   CptDeclarationTca?   @relation("CptCreditTaxeRecupere", fields: [recupereDansId], references: [id], onDelete: Restrict)
  creeAt         DateTime             @default(now())
  recupereAt     DateTime?

  @@index([statut])
  @@index([declarationId])
}

// ---------------------------------------------------------------------------------------------------------------------
// GC-9 — Rémunération des partenaires (docs/compta-conception.md §5.7, §6.4). Migration `20261128090000_compta_remuneration`.
// Les bordereaux des partenaires (GC-9d : `CptBordereauPartenaire`, `CptBordereauLigne`) ne sont PAS créés ici : en attente des
// modèles de fichiers.
// ---------------------------------------------------------------------------------------------------------------------

/// Moyen de paiement d'un règlement versé à un partenaire.
enum CptModePaiementPartenaire {
  VIREMENT
  CHEQUE
  ESPECES
  MOBILE_MONEY
  AUTRE
}

/// Ligne de rémunération (contrat, échéance, bénéficiaire, nature), FIGÉE à sa création : elle est l'ancre des affectations de
/// règlements et de compensations. Seul le montant dû (`du`) y est enregistré ; exigible, payable, payé et restes ne sont JAMAIS
/// stockés (calculés par backend/src/cptRemuneration.ts depuis les rattachements VALIDÉS et les affectations). Toutes les
/// échéances d'un même (contrat, bénéficiaire, nature) sont créées ensemble, avec la même convention (reliquat exact). Jamais
/// modifiée (trigger).
model CptLigneRemuneration {
  id                       String                @id @default(cuid())
  contratId                String
  contrat                  CptContrat            @relation(fields: [contratId], references: [id], onDelete: Restrict)
  echeanceId               String
  echeance                 CptEcheance           @relation(fields: [echeanceId], references: [id], onDelete: Restrict)
  partenaireBeneficiaireId String
  partenaireBeneficiaire   CptPartenaire         @relation("CptLigneRemunerationBeneficiaire", fields: [partenaireBeneficiaireId], references: [id], onDelete: Restrict)
  nature                   CptNatureRemuneration
  conventionId             String
  convention               CptConvention         @relation(fields: [conventionId], references: [id], onDelete: Restrict)
  du                       Decimal               @db.Decimal(14, 2)
  creeParId                String
  creePar                  User                  @relation("CptLigneRemunerationCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt                   DateTime              @default(now())

  affectationsReglement    CptAffectationReglement[]
  affectationsCompensation CptAffectationCompensation[]

  @@unique([contratId, echeanceId, partenaireBeneficiaireId, nature])
  @@index([partenaireBeneficiaireId, nature])
  @@index([echeanceId])
  @@index([conventionId])
}

/// Décision du RFCRH sur le mode de règlement (« en une fois » ou « au prorata ») d'un contrat, pour un bénéficiaire et une
/// nature, avec motif. Ajout seul (trigger) : la décision la plus récente l'emporte sur la convention.
model CptDecisionModeRemuneration {
  id           String                @id @default(cuid())
  contratId    String
  contrat      CptContrat            @relation(fields: [contratId], references: [id], onDelete: Restrict)
  partenaireId String
  partenaire   CptPartenaire         @relation("CptDecisionModeRemunerationPartenaire", fields: [partenaireId], references: [id], onDelete: Restrict)
  nature       CptNatureRemuneration
  mode         CptModeReglement
  motif        String
  creeParId    String
  creePar      User                  @relation("CptDecisionModeRemunerationCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt       DateTime              @default(now())

  @@index([partenaireId, nature])
  @@index([contratId])
}

/// Règlement versé à un partenaire (`CPR-AAAA-NNNNNN`, C-11) : nature obligatoire, montant > 0, entièrement affecté à des lignes
/// de la même nature (Σ des affectations = montant, contrôlé en base à la validation de la transaction). Jamais modifié (seules la
/// pièce Odoo et sa date, d'abord vides, peuvent être renseignées une fois). `montantAvance` = part versée au-delà du payable,
/// acceptée explicitement avec motif.
model CptReglementPartenaire {
  id                   String                    @id @default(cuid())
  reference            String                    @unique
  partenaireId         String
  partenaire           CptPartenaire             @relation("CptReglementPartenaireDestinataire", fields: [partenaireId], references: [id], onDelete: Restrict)
  nature               CptNatureRemuneration
  montant              Decimal                   @db.Decimal(14, 2)
  date                 DateTime                  @db.Date
  mode                 CptModePaiementPartenaire
  referenceReglement   String
  pieceOdoo            String?
  dateComptabilisation DateTime?                 @db.Date
  /// Choix « en une fois / au prorata » décidé pour CE règlement (motif obligatoire) ; nul = règle de chaque ligne.
  modeDerogation       CptModeReglement?
  montantAvance        Decimal                   @default(0) @db.Decimal(14, 2)
  motif                String?
  creeParId            String
  creePar              User                      @relation("CptReglementPartenaireCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt               DateTime                  @default(now())

  affectations CptAffectationReglement[]
  annulation   CptAnnulationRemuneration?

  @@index([partenaireId, nature])
  @@index([date])
}

/// Part d'un règlement affectée à une ligne (les montants exigibles les plus anciens d'abord). Jamais modifiée (trigger).
model CptAffectationReglement {
  id                  String                 @id @default(cuid())
  reglementId         String
  reglement           CptReglementPartenaire @relation(fields: [reglementId], references: [id], onDelete: Restrict)
  ligneRemunerationId String
  ligneRemuneration   CptLigneRemuneration   @relation(fields: [ligneRemunerationId], references: [id], onDelete: Restrict)
  montant             Decimal                @db.Decimal(14, 2)

  @@unique([reglementId, ligneRemunerationId])
  @@index([ligneRemunerationId])
}

/// Compensation EXPLICITE entre deux natures d'un même partenaire : la seule voie de passage d'une nature à l'autre. Jamais
/// automatique, motif obligatoire (10 caractères au moins). Jamais modifiée (trigger).
model CptCompensation {
  id           String                @id @default(cuid())
  partenaireId String
  partenaire   CptPartenaire         @relation("CptCompensationPartenaire", fields: [partenaireId], references: [id], onDelete: Restrict)
  natureSource CptNatureRemuneration
  natureCible  CptNatureRemuneration
  montant      Decimal               @db.Decimal(14, 2)
  motif        String
  valideeParId String
  valideePar   User                  @relation("CptCompensationValideePar", fields: [valideeParId], references: [id], onDelete: Restrict)
  creeAt       DateTime              @default(now())

  affectations CptAffectationCompensation[]
  annulation   CptAnnulationRemuneration?

  @@index([partenaireId])
}

/// Effet d'une compensation sur les lignes : montant NÉGATIF sur les lignes de la nature source (l'avance reprise), POSITIF sur
/// celles de la nature cible. Σ des positifs = Σ des négatifs = montant de la compensation (contrôlé en base).
model CptAffectationCompensation {
  id                  String               @id @default(cuid())
  compensationId      String
  compensation        CptCompensation      @relation(fields: [compensationId], references: [id], onDelete: Restrict)
  ligneRemunerationId String
  ligneRemuneration   CptLigneRemuneration @relation(fields: [ligneRemunerationId], references: [id], onDelete: Restrict)
  montant             Decimal              @db.Decimal(14, 2)

  @@unique([compensationId, ligneRemunerationId])
  @@index([ligneRemunerationId])
}

/// Annulation tracée d'un règlement OU d'une compensation (Q22, C-38) : ajout seul, une seule par opération. Une seule table pour
/// les deux types : mêmes champs, mêmes gardes, une seule relation vers l'auteur. L'opération annulée ne compte plus dans le payé.
model CptAnnulationRemuneration {
  id                   String                  @id @default(cuid())
  reglementId          String?                 @unique
  reglement            CptReglementPartenaire? @relation(fields: [reglementId], references: [id], onDelete: Restrict)
  compensationId       String?                 @unique
  compensation         CptCompensation?        @relation(fields: [compensationId], references: [id], onDelete: Restrict)
  date                 DateTime                @db.Date
  motif                String
  /// « Aucun versement n'a eu lieu, ou il a été rejeté par la banque » : exigé pour un règlement.
  sansVersement        Boolean                 @default(false)
  pieceOdoo            String?
  dateComptabilisation DateTime?               @db.Date
  creeParId            String
  creePar              User                    @relation("CptAnnulationRemunerationCreePar", fields: [creeParId], references: [id], onDelete: Restrict)
  creeAt               DateTime                @default(now())
}
