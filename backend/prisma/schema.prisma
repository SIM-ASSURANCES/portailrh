// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SOCLE PORTAIL
// ============================================================

model User {
  id                     String    @id @default(cuid())
  fullName               String
  email                  String    @unique
  /// Nullable : un compte créé par invitation par lien (voir CLAUDE.md
  /// "Invitation par lien") n'a pas encore de mot de passe tant que la
  /// personne n'a pas finalisé son compte via `/invitation/[token]`. Un
  /// compte "en attente" se reconnaît à `invitationToken` non nul ET
  /// `passwordHash` nul. La création manuelle classique (admin/users,
  /// `createUserAction`) continue de renseigner ce champ immédiatement,
  /// comme avant.
  passwordHash           String?
  isActive               Boolean   @default(true)
  /// Incrémenté à chaque désactivation ou changement de rôle pour invalider le JWT (SEC-06)
  tokenVersion           Int       @default(0)
  /// Invitation par lien (complémentaire à la création manuelle) : jeton
  /// aléatoire sécurisé, unique, remis à `null` dès l'activation du compte
  /// (`activerInvitationAction`) — jamais réutilisable une fois consommé.
  invitationToken        String?   @unique
  /// Expire 7 jours après la génération du lien (voir `creerInvitationAction`).
  /// Un Admin peut régénérer un nouveau lien (nouveau token + nouvelle
  /// expiration) pour un compte encore en attente si l'ancien a expiré.
  invitationExpiresAt    DateTime?
  /// Jeton de réinitialisation de mot de passe (unique, sécurisé, remis à null après usage)
  resetPasswordToken     String?   @unique
  /// Expire 1 heure après la demande de réinitialisation
  resetPasswordExpiresAt DateTime?
  serviceId              String?
  service                Service?  @relation(fields: [serviceId], references: [id])
  photoUrl               String?   @default("/default-avatar.svg")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  demandesCreees                Demande[]         @relation("DemandeCreateur")
  demandesBeneficiees           Demande[]         @relation("DemandeBeneficiaire")
  /// Demandes dont ce DG a approuvé la "validation complète" (verrou de clôture, Ticket 7).
  demandesApprouveesDG          Demande[]         @relation("DgApprobateurValidationComplete")
  reglementsFaits               Reglement[]       @relation("ReglementAuteur")
  retoursDeclares               RetourCaisse[]    @relation("RetourDeclarant")
  retoursReceptionnes           RetourCaisse[]    @relation("RetourReceptionnaire")
  /// Lignes de dépense marquées "non justifiée" par cet utilisateur Finance
  /// (`marquerDepenseNonJustifieeAction`), avec motif obligatoire.
  depensesMarqueesNonJustifiees DepenseLigne[]    @relation("MotifNonJustifiePar")
  /// Lignes de demande décidées (validée OU rejetée) par cet utilisateur
  /// Finance — `validerLignesAction` (voir CLAUDE.md "Validation ligne par
  /// ligne").
  lignesDemandeDecidees         LigneDemande[]    @relation("LigneDemandeDecideur")
  historique                    HistoriqueEntry[]
  /// Écritures JournalCaisse déclenchées par cet utilisateur (auteur du
  /// règlement pour une SORTIE, receptionneParId pour une ENTRÉE de retour,
  /// ou l'utilisateur ayant annulé un règlement pour une ENTRÉE
  /// compensatoire — section 13 du cahier des charges, traçabilité).
  ecrituresJournalCaisse        JournalCaisse[]   @relation("JournalCaisseUser")

  pointagesEffectues     Pointage[]              @relation("PointageEmploye")
  pointagesRealises      Pointage[]              @relation("PointageEffectuePar")
  correctionsEffectuees  CorrectionPointage[]    @relation("CorrectionEffectuePar")
  absencesDeclarees      Absence[]               @relation("AbsenceEmploye")
  absencesControlees     Absence[]               @relation("AbsenceControlePar")
  notifications          Notification[]
  plagesAbsenceAutorisee PlageAbsenceAutorisee[]

  /// Délégations individuelles de permission Trésorerie/Pointage RH que cet
  /// utilisateur a ACCORDÉES à d'autres comptes (voir CLAUDE.md "Délégation
  /// individuelle de permissions"). Toujours des permissions qu'il possède
  /// lui-même via son propre rôle.
  delegationsAccordees PermissionDelegation[] @relation("DelegationDonneur")
  /// Délégations que cet utilisateur a REÇUES d'un autre compte.
  delegationsRecues    PermissionDelegation[] @relation("DelegationBeneficiaire")
  /// Délégations que cet utilisateur a RÉVOQUÉES (en tant que donneur
  /// d'origine, ou en tant qu'Admin) — distinct de `delegationsAccordees` :
  /// un Admin peut révoquer une délégation accordée par quelqu'un d'autre.
  delegationsRevoquees PermissionDelegation[] @relation("DelegationRevoquePar")

  /// Messages FeedbackApp reçus par cet employé — jamais de relation
  /// inverse vers un "auteur" (voir CLAUDE.md "FeedbackApp : anonymat
  /// total", l'auteur n'est structurellement enregistré nulle part).
  feedbacksRecus   Feedback[] @relation("FeedbackRecipient")
  /// Messages FeedbackApp que cet utilisateur a modérés (action RH/DG,
  /// sans rapport avec l'auteur du message).
  feedbacksModeres Feedback[] @relation("FeedbackModeratedBy")
}

model Role {
  id                             String           @id @default(cuid())
  name                           String           @unique
  description                    String?
  /// Accès à la console d'administration (`/admin/*`), voir `isAdmin()`
  /// dans `backend/src/permissions.ts`. Remplace l'ancienne comparaison
  /// littérale `role.name === "Admin"` — un rôle combiné (ex: "Admin /
  /// Collaborateur") peut désormais porter cet accès sans s'appeler
  /// "Admin". Indépendant du système de permissions par module
  /// (`RolePermission`) : cocher `estAdmin` ne donne AUCUNE permission
  /// métier (`treso.*`, `pointage.*`), exactement comme avant.
  estAdmin                       Boolean          @default(false)
  /// Éligibilité à être BÉNÉFICIAIRE d'une délégation individuelle de
  /// permission (voir CLAUDE.md "Délégation individuelle de permissions").
  /// Champ dédié plutôt qu'une comparaison sur le nom du rôle
  /// (`role.name === "Collaborateur"`) — même principe que `estAdmin`
  /// ci-dessus ("estAdmin remplace le nom de rôle") : un rôle combiné ou
  /// renommé peut porter cette éligibilité sans s'appeler littéralement
  /// "Collaborateur". Indépendant de `estAdmin` et de `RolePermission` :
  /// ne donne AUCUN droit, contrôle uniquement qui peut apparaître comme
  /// bénéficiaire sélectionnable sur `/delegations`.
  peutEtreBeneficiaireDelegation Boolean          @default(false)
  /// FeedbackApp (voir CLAUDE.md "FeedbackApp") — détermine si les User
  /// portant ce rôle apparaissent comme destinataires proposables sur
  /// `/feedback/nouveau`. Champ dédié plutôt qu'une comparaison sur le nom
  /// du rôle (`role.name === "Admin"`) — même principe que `estAdmin`/
  /// `peutEtreBeneficiaireDelegation` ci-dessus : un rôle combiné (ex:
  /// "Admin / Collaborateur", qui porte `estAdmin: true` mais représente un
  /// vrai employé) reste proposable, alors que le rôle "Admin" (compte
  /// technique, pas un employé à évaluer) ne l'est pas. `DEFAULT true` :
  /// n'importe quel rôle propose ses comptes par défaut, seul un rôle
  /// explicitement marqué `false` en est exclu — pas un invariant de
  /// sécurité critique comme `estAdmin` (figé à la création) : librement
  /// modifiable à tout moment depuis `/admin/roles`, même principe que
  /// `peutEtreBeneficiaireDelegation`.
  peutRecevoirFeedback           Boolean          @default(true)
  users                          User[]
  permissions                    RolePermission[]
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  label       String
  isActive    Boolean      @default(true)
  permissions Permission[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  roles       RolePermission[]
  delegations PermissionDelegation[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// Délégation individuelle d'une permission Trésorerie/Pointage RH à un
/// compte utilisateur DÉJÀ EXISTANT — aucune création de compte ici (voir
/// CLAUDE.md "Délégation individuelle de permissions"). Accordée par un
/// utilisateur qui possède lui-même cette permission via son propre rôle
/// (`session.rolePermissions`, jamais via une délégation qu'il aurait
/// lui-même reçue — interdit toute chaîne de délégation en cascade, vérifié
/// dans `accorderDelegationAction`).
///
/// **L'accès effectif du bénéficiaire est recalculé DYNAMIQUEMENT à chaque
/// session** (voir `getSession()`, `frontend/src/lib/auth.ts`) : une ligne
/// `estActive: true` ne suffit pas — le donneur doit ENCORE posséder cette
/// permission via son rôle au moment de la vérification. Si le rôle du
/// donneur change et perd cette permission, le bénéficiaire perd
/// automatiquement l'accès délégué correspondant, sans révocation manuelle.
///
/// **Jamais d'édition silencieuse** (même principe que `RetourCaisse.estAnnule`/
/// `Reglement.estAnnule`, voir "Règles métier impératives") : une révocation
/// ne supprime ni ne réécrit la ligne, elle la marque `estActive: false` avec
/// `revokedAt`/`revokedById`. Un nouvel octroi après révocation crée une
/// NOUVELLE ligne (jamais de réactivation de l'ancienne) : l'historique
/// complet de tous les octrois/révocations reste intégralement
/// reconstituable, jamais réécrit.
model PermissionDelegation {
  id             String     @id @default(cuid())
  beneficiaireId String
  beneficiaire   User       @relation("DelegationBeneficiaire", fields: [beneficiaireId], references: [id])
  donneurId      String
  donneur        User       @relation("DelegationDonneur", fields: [donneurId], references: [id])
  permissionId   String
  permission     Permission @relation(fields: [permissionId], references: [id])

  estActive   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("DelegationRevoquePar", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([beneficiaireId])
  @@index([donneurId])
  @@index([permissionId])
}

model HistoriqueEntry {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  titre     String
  message   String
  lien      String?
  estLue    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// MODULE 1 — TRÉSORERIE
// ============================================================

/// Refonte V1 (cahier des charges réécrit) : remplace l'ancien enum à 5
/// valeurs. Les statuts intermédiaires (PARTIELLEMENT_VALIDEE,
/// VALIDEE_NON_REGLEE, PARTIELLEMENT_REGLEE, REGLEE, EN_ATTENTE_REGULARISATION,
/// REGULARISEE) ne sont pas encore produits par la logique applicative
/// actuelle (celle-ci reste, pour l'instant, mappée sur les anciennes
/// transitions EN_ATTENTE_VALIDATION -> VALIDEE -> CLOTUREE — voir CLAUDE.md,
/// section "Refonte V1 en cours") : ils sont posés ici en fondation pour les
/// phases B à H (validation partielle, règlement adapté, régularisation).
enum StatutDemande {
  BROUILLON
  EN_ATTENTE_VALIDATION
  VALIDEE
  PARTIELLEMENT_VALIDEE
  VALIDEE_NON_REGLEE
  PARTIELLEMENT_REGLEE
  REGLEE
  REJETEE
  EN_ATTENTE_REGULARISATION
  REGULARISEE
  CLOTUREE
}

/// Statut de validation d'une `LigneDemande` — Tâche "Validation ligne par
/// ligne" (voir CLAUDE.md) : remplace, pour toute demande ayant au moins
/// une ligne, la saisie manuelle d'un montant partiel par une décision
/// individuelle par ligne d'article. `EN_ATTENTE` par défaut, jamais
/// dévalidée une fois `VALIDEE`/`REJETEE` (même principe qu'ailleurs dans
/// le module : aucune fonction de "dévalidation" nulle part).
enum StatutLigneDemande {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

/// Type de bénéficiaire d'une Demande — distinct du Demandeur (créateur).
/// Rempli uniquement pour COLLABORATEUR/STAGIAIRE ayant un compte
/// (`beneficiaireUserId`) ; sinon le nom est saisi librement
/// (`beneficiaireNom`), y compris pour ENTREPRISE ("SIM ASSURANCES CI").
enum BeneficiaireType {
  COLLABORATEUR
  STAGIAIRE
  FOURNISSEUR
  ENTREPRISE
}

/// Phase F (saisie directe, cahier des charges section 11) : une demande
/// STANDARD suit le circuit habituel (créée par le bénéficiaire ou pour son
/// compte) ; une DEPENSE_DIRECTE est saisie par un utilisateur habilité
/// (Finance, `treso.saisir_depense_directe`) sans intervention du
/// bénéficiaire — le créateur (`Demande.createur`) et le bénéficiaire
/// (`Demande.beneficiaireType`/`beneficiaireUserId`/`beneficiaireNom`,
/// Phase A) sont alors deux personnes distinctes par construction. Une fois
/// créée, une DEPENSE_DIRECTE suit EXACTEMENT le même circuit qu'une
/// demande STANDARD (validation, règlement, fonds remis, clôture) — ce
/// champ ne sert qu'à distinguer l'origine de la création, jamais à
/// dévier la logique des phases suivantes.
enum TypeDemande {
  STANDARD
  DEPENSE_DIRECTE
}

/// Nature d'une dépense saisie directement (Phase F, section 11) —
/// renseignée uniquement si `Demande.typeDemande = DEPENSE_DIRECTE`.
enum NatureDepenseDirecte {
  PRIME_STAGE
  DOTATION_CARBURANT
  DEPENSE_ENTREPRISE
  DEPENSE_COLLECTIVE
  AUTRE
}

enum ModeReglement {
  CAISSE
  BANQUE
}

enum TypeJustification {
  FACTURE
  RECU
  TICKET
  SANS_PIECE
}

model Categorie {
  id       String  @id @default(cuid())
  label    String  @unique
  /// Soft-delete : une catégorie désactivée n'apparaît plus dans les
  /// sélecteurs de nouvelle catégorisation ni les filtres de reporting,
  /// mais reste affichée normalement sur les demandes qui la référencent
  /// déjà (jamais de suppression définitive — Categorie/Objet sont
  /// potentiellement référencés par des Demande existantes).
  isActive Boolean @default(true)
  objets   Objet[]

  /// Budget partagé de la NATURE de dépense que représente cette catégorie
  /// (ex: "Informatique"), pas d'une demande ni d'un service précis — voir
  /// CLAUDE.md "Budget partagé par Catégorie". `null` = aucune limite
  /// définie, aucun contrôle appliqué pour cette catégorie. Décompté au
  /// RÈGLEMENT (pas à la validation) via `getMontantConsommeCategorie`
  /// (`src/lib/tresorerie.ts`) — depuis "Catégorisation par ligne" :
  /// somme des `ReglementCategorieAllocation.montant` de cette catégorie
  /// dont le `Reglement` est confirmé et non annulé (allocation EXPLICITE
  /// choisie par Finance à chaque règlement, jamais un apportionnement
  /// calculé). Aucun renouvellement automatique périodique : un montant
  /// total consommable jusqu'à épuisement, à réajuster manuellement par
  /// l'Admin (`admin/categories`).
  budgetAlloue Decimal? @db.Decimal(14, 2)

  demandes             Demande[]                      @relation("DemandeCategorie")
  /// Lignes de demande catégorisées directement (voir CLAUDE.md
  /// "Catégorisation par ligne") — distinct de `demandes` ci-dessus, qui
  /// ne couvre que les `DEPENSE_DIRECTE` depuis cette tâche.
  lignesDemande        LigneDemande[]                 @relation("LigneDemandeCategorie")
  allocationsReglement ReglementCategorieAllocation[]
}

model Objet {
  id            String         @id @default(cuid())
  label         String
  /// Voir Categorie.isActive — même principe de soft-delete.
  isActive      Boolean        @default(true)
  categorieId   String
  categorie     Categorie      @relation(fields: [categorieId], references: [id])
  demandes      Demande[]
  /// Voir `Categorie.lignesDemande` (CLAUDE.md "Catégorisation par ligne").
  lignesDemande LigneDemande[]
}

model Demande {
  id                   String        @id @default(cuid())
  reference            String        @unique
  /// Montant demandé (nom de champ conservé pour limiter la casse — voir
  /// CLAUDE.md "Refonte V1"). Distinct de `montantValide` ci-dessous.
  montant              Decimal       @db.Decimal(14, 2)
  description          String
  /// Version ORIGINALE de `description`, immuable une fois posée — voir
  /// CLAUDE.md "Libellé de demande modifiable avec traçabilité permanente".
  /// `null` tant que `description` n'a JAMAIS été modifiée depuis la
  /// création (dans ce cas `description` EST la version originale) ;
  /// renseignée UNE SEULE FOIS, à la toute première modification par
  /// Finance (copie de la valeur d'alors), jamais réécrite ensuite même si
  /// `description` est modifiée à nouveau — `description` porte donc
  /// toujours la version COURANTE, `descriptionOriginale` la version de
  /// départ. Le Collaborateur créateur voit toujours cette version
  /// (jamais `description` si elle diverge) ; Finance voit les deux côte à
  /// côte dès qu'elles divergent.
  descriptionOriginale String?
  commentaire          String?
  statut               StatutDemande @default(EN_ATTENTE_VALIDATION)

  /// Phase F (saisie directe) — voir le commentaire de l'enum
  /// `TypeDemande`. `natureDepenseDirecte` n'est renseignée que si
  /// `typeDemande = DEPENSE_DIRECTE`, jamais pour une demande STANDARD.
  typeDemande          TypeDemande           @default(STANDARD)
  natureDepenseDirecte NatureDepenseDirecte?

  /// Cumul du montant validé à date — nul tant qu'aucune validation
  /// (même partielle) n'a eu lieu. Peut être mis à jour par plusieurs
  /// validations successives (validation complémentaire sur le reliquat,
  /// phase B "validation partielle" — pas encore implémentée).
  montantValide Decimal? @db.Decimal(14, 2)

  /// Bénéficiaire de la dépense, distinct du Demandeur (`createur`) — peut
  /// être différent (ex: le collaborateur demande pour un stagiaire, un
  /// fournisseur, ou l'entreprise elle-même).
  beneficiaireType   BeneficiaireType
  /// Renseigné uniquement si `beneficiaireType` = COLLABORATEUR ou
  /// STAGIAIRE ET que la personne a un compte dans le système.
  beneficiaireUserId String?
  beneficiaireUser   User?            @relation("DemandeBeneficiaire", fields: [beneficiaireUserId], references: [id])
  /// Renseigné si le bénéficiaire n'est pas un utilisateur du système
  /// (nom du fournisseur/prestataire, ou "SIM ASSURANCES CI" pour ENTREPRISE).
  beneficiaireNom    String?

  /// Catégorie d'achat, choisie à la création dans le formulaire "Demande
  /// d'Achat" (réactivée : le cahier des charges V1 l'avait sortie du flux
  /// principal, elle y revient comme champ d'en-tête — voir CLAUDE.md
  /// "Formulaire Demande d'Achat"). C'est cette catégorie, PAS le
  /// demandeur ni son service, qui porte le budget partagé
  /// (`Categorie.budgetAlloue` — voir CLAUDE.md "Budget partagé par
  /// Catégorie") : deux demandeurs différents catégorisant leurs demandes
  /// dans la même Catégorie tapent dans la même enveloppe. `objetId` reste
  /// nullable, non utilisé par ce formulaire (toujours renseigné par
  /// l'ancien écran de catégorisation Finance, Ticket 2).
  categorieId String?
  categorie   Categorie? @relation("DemandeCategorie", fields: [categorieId], references: [id])
  objetId     String?
  objet       Objet?     @relation(fields: [objetId], references: [id])

  /// Champs d'en-tête du formulaire "Demande d'Achat".
  /// `devise` : code ISO (XOF par défaut, EUR, USD).
  dateLivraisonSouhaitee DateTime?
  devise                 String    @default("XOF")

  /// Lignes d'articles (Libellé / Nombre / Prix unitaire). `montant` ci-dessus
  /// est la somme des (quantite × prixUnitaire) — jamais saisi directement.
  lignes LigneDemande[]

  motifRejet   String?
  motifCloture String?

  /// Rejet du reliquat non encore validé d'une demande `PARTIELLEMENT_VALIDEE`
  /// (Finance ou DG, `treso.valider_demande`) — voir CLAUDE.md "Rejet du
  /// reliquat". N'affecte JAMAIS `montantValide` ni le statut : la part déjà
  /// validée reste acquise et suit son cours normal (règlement, clôture).
  /// Bloque uniquement toute future `validerComplementaireAction` sur cette
  /// demande, une fois `true`.
  reliquatRejete     Boolean @default(false)
  motifRejetReliquat String?

  /// Verrou de clôture (Ticket 7, indépendant du circuit de validation
  /// partielle/complémentaire des Phases B/C — celui-ci reste inchangé et
  /// continue de débloquer le RÈGLEMENT via `montantValide` seul). Une
  /// demande ne peut être CLÔTURÉE (totale ou partielle) que si le DG a
  /// donné cette approbation, même si Finance a déjà tout réglé.
  validationCompleteParDG Boolean   @default(false)
  dgApprobateurId         String?
  dgApprobateur           User?     @relation("DgApprobateurValidationComplete", fields: [dgApprobateurId], references: [id])
  dgApprouveAt            DateTime?

  createurId String
  createur   User   @relation("DemandeCreateur", fields: [createurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces        PieceJointe[]
  reglements    Reglement[]
  journalCaisse JournalCaisse[]

  @@index([createurId])
  @@index([statut])
  @@index([beneficiaireUserId])
}

/// Stockage local sur disque (`./uploads/`, hors dépôt git — voir
/// `api/treso/pieces-jointes/upload/route.ts`). `url` est un nom de
/// fichier généré côté serveur (jamais dérivé d'une entrée utilisateur),
/// résolu par la route de téléchargement.
model PieceJointe {
  id              String         @id @default(cuid())
  url             String
  /// Renseigné pour toute pièce rattachée à une Demande (y compris quand
  /// elle est en réalité attachée à une seule ligne de dépense,
  /// `depenseLigneId` ci-dessous, plutôt qu'à la demande elle-même —
  /// dérivé du contexte au moment de l'upload via
  /// `retourCaisse.reglement.demandeId`). **Nullable depuis "Pièce jointe
  /// obligatoire sur le solde d'ouverture" (voir CLAUDE.md)** : une pièce
  /// rattachée à une écriture `JournalCaisse` du solde d'ouverture
  /// (`journalCaisseId` ci-dessous) n'a, par nature, aucune demande
  /// d'origine — même raisonnement que `JournalCaisse.demandeId`,
  /// assoupli pour la même raison.
  demandeId       String?
  demande         Demande?       @relation(fields: [demandeId], references: [id])
  /// Renseigné uniquement si cette pièce est attachée à une ligne de
  /// dépense précise d'un retour de caisse, plutôt qu'à la demande
  /// elle-même (formulaire de création / dépense directe). `@unique` : une
  /// seule pièce jointe par ligne. `onDelete: Cascade` : si la ligne est
  /// supprimée (modification d'un retour avant réception), sa pièce jointe
  /// disparaît avec elle plutôt que de rester orpheline en base (le
  /// fichier lui-même reste sur disque — V1 volontairement simple, pas de
  /// tâche de nettoyage des fichiers orphelins).
  depenseLigneId  String?        @unique
  depenseLigne    DepenseLigne?  @relation(fields: [depenseLigneId], references: [id], onDelete: Cascade)
  /// Renseigné uniquement pour une pièce jointe attachée à une écriture
  /// `JournalCaisse` du cycle "solde d'ouverture" (`definirSoldeOuvertureAction`/
  /// `corrigerSoldeOuvertureAction`) — le seul cas de pièce jointe sans
  /// Demande d'origine. `@unique` : une seule pièce par écriture.
  journalCaisseId String?        @unique
  journalCaisse   JournalCaisse? @relation(fields: [journalCaisseId], references: [id])
  createdAt       DateTime       @default(now())
}

/// Ligne d'article d'une Demande d'Achat ("Tableau des articles" du
/// formulaire de création). Le `montant` de la Demande est la somme des
/// (quantite × prixUnitaire) de ses lignes — recalculé côté serveur,
/// jamais saisi directement (même principe que le solde de caisse).
///
/// **Validation ligne par ligne** (voir CLAUDE.md "Validation ligne par
/// ligne") — pour toute demande ayant AU MOINS une ligne,
/// `validerLignesAction` est l'UNIQUE mécanisme de décision (remplace
/// entièrement `validerTotalementAction`/`validerPartiellementAction`/
/// `validerComplementaireAction`/`rejeterReliquatAction` pour ce cas —
/// ces quatre actions restent réservées aux demandes SANS ligne, ex:
/// `DEPENSE_DIRECTE`). Décision UNIQUE ET COMPLÈTE en un seul geste
/// (Option A2 du rapport de diagnostic) : jamais de notion de "reliquat"
/// à traiter plus tard une fois les lignes tranchées, jamais de
/// dévalidation.
model LigneDemande {
  id           String  @id @default(cuid())
  libelle      String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(14, 2)

  /// Version ORIGINALE de `libelle`, immuable une fois posée — même
  /// mécanique exacte que `Demande.descriptionOriginale` (voir CLAUDE.md
  /// "Description du besoin modifiable avec traçabilité permanente") :
  /// `null` tant que `libelle` n'a JAMAIS été modifié depuis la création
  /// (il fait alors office des deux versions à la fois) ; renseignée UNE
  /// SEULE FOIS, à la toute première modification par Finance, jamais
  /// réécrite ensuite. Le Collaborateur créateur voit toujours cette
  /// version (jamais `libelle` si elle diverge) ; Finance voit les deux
  /// côte à côte dès qu'elles divergent.
  libelleOriginal String?

  /// `EN_ATTENTE` par défaut, posée UNE SEULE FOIS par
  /// `validerLignesAction` (décision unique et complète, jamais de
  /// dévalidation ensuite).
  statutValidation StatutLigneDemande @default(EN_ATTENTE)
  /// Obligatoire si `statutValidation = REJETEE` (min 3 caractères,
  /// revérifié côté serveur), sinon toujours `null`.
  motifRejet       String?
  /// Auteur et date de la décision (validée OU rejetée) — `null` tant que
  /// `statutValidation = EN_ATTENTE`.
  decideParId      String?
  decidePar        User?              @relation("LigneDemandeDecideur", fields: [decideParId], references: [id])
  decideAt         DateTime?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id])

  /// Catégorisation par ligne (voir CLAUDE.md "Catégorisation par ligne") —
  /// même mécanique exacte que `Demande.categorieId`/`objetId` (nullable,
  /// même relations), mais portée par CHAQUE ligne plutôt que par la
  /// demande entière : une demande à plusieurs lignes peut désormais avoir
  /// une catégorie différente par ligne (ex: "Transport" et "Matériel" sur
  /// la même demande). Réservé aux demandes `STANDARD` (qui ont des
  /// lignes) — `Demande.categorieId`/`objetId` restent, eux, l'unique
  /// mécanisme pour `DEPENSE_DIRECTE` (0 ligne, jamais concernée par ces
  /// deux champs). Modifiable uniquement tant que
  /// `statutValidation = EN_ATTENTE` (`categoriserLigneAction`) — même
  /// principe que "Catégorie/objet modifiables uniquement avant
  /// validation", relu à l'échelle de la ligne plutôt que de la demande.
  categorieId String?
  categorie   Categorie? @relation("LigneDemandeCategorie", fields: [categorieId], references: [id])
  objetId     String?
  objet       Objet?     @relation(fields: [objetId], references: [id])

  createdAt DateTime @default(now())
}

model Reglement {
  id              String        @id @default(cuid())
  montant         Decimal       @db.Decimal(14, 2)
  mode            ModeReglement
  estConfirme     Boolean       @default(false)
  estAnnule       Boolean       @default(false)
  motifAnnulation String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id])

  auteurId String
  auteur   User   @relation("ReglementAuteur", fields: [auteurId], references: [id])

  retours RetourCaisse[]

  /// Allocation budgétaire explicite par Catégorie (voir CLAUDE.md
  /// "Catégorisation par ligne" / "Allocation budgétaire explicite par
  /// règlement") — Option 2 du diagnostic (PAS un apportionnement
  /// proportionnel calculé) : Finance répartit elle-même, de façon
  /// EXPLICITE, le montant de ce règlement entre chaque Catégorie
  /// concernée par la demande. Toujours au moins UNE allocation dès que le
  /// règlement porte sur une demande catégorisée (même une demande à une
  /// seule catégorie en crée une, à 100%, de façon transparente pour
  /// Finance) — jamais optionnel, jamais un calcul dérivé recalculé à la
  /// volée. La somme des `montant` de ces allocations doit TOUJOURS égaler
  /// exactement `Reglement.montant` (revérifié côté serveur à chaque
  /// écriture, jamais uniquement côté client).
  allocations ReglementCategorieAllocation[]

  createdAt  DateTime  @default(now())
  confirmeAt DateTime?
}

/// Une ligne = la part explicite de `Reglement.montant` que Finance a
/// choisi d'attribuer à UNE Catégorie précise — voir le commentaire de
/// `Reglement.allocations` ci-dessus. `getMontantConsommeCategorie`
/// (`backend/src/tresorerie.ts`) est désormais l'UNIQUE fonction qui lit
/// cette table (somme des `montant` des allocations dont le `Reglement`
/// est confirmé et non annulé) — jamais une deuxième lecture parallèle.
model ReglementCategorieAllocation {
  id          String    @id @default(cuid())
  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id])
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  montant     Decimal   @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  /// Au plus une allocation par (règlement, catégorie) — jamais deux lignes
  /// pour la même catégorie sur le même règlement (la répartition
  /// additionne déjà tout ce qui revient à une catégorie dans UNE seule
  /// ligne).
  @@unique([reglementId, categorieId])
}

/// Fonds remis (cahier des charges sections 8-9, Phase D) : un retour de
/// caisse ne stocke plus un montant dépensé agrégé unique, mais une liste de
/// `DepenseLigne` détaillées.
model RetourCaisse {
  id                String         @id @default(cuid())
  /// CALCULÉ AUTOMATIQUEMENT, jamais saisi manuellement (voir
  /// `getMontantARetourner` dans src/lib/tresorerie.ts) : montant du
  /// règlement lié moins la somme des `DepenseLigne` déclarées. Choix
  /// documenté dans CLAUDE.md "Refonte V1 en cours" / Phase D — le cahier
  /// des charges (section 9.3 vs 9.5) est en tension entre "l'utilisateur
  /// enregistre un montant à retourner" et "le solde ne doit pas être
  /// modifiable manuellement" ; tranché en faveur du calcul automatique,
  /// cohérent avec le principe déjà appliqué au solde de caisse
  /// (`getSoldeCaisse`) qu'aucun solde financier ne se saisit à la main.
  montantARetourner Decimal        @db.Decimal(14, 2)
  estReceptionne    Boolean        @default(false)
  depenses          DepenseLigne[]

  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id])

  declarantId String
  declarant   User   @relation("RetourDeclarant", fields: [declarantId], references: [id])

  receptionneParId String?
  receptionnePar   User?   @relation("RetourReceptionnaire", fields: [receptionneParId], references: [id])

  createdAt     DateTime  @default(now())
  receptionneAt DateTime?

  /// Date du retour physique de l'espèce, saisie par le collaborateur dans
  /// le formulaire SIMPLIFIÉ ("Retour simple : date + montant", voir
  /// CLAUDE.md "Retour de caisse optionnel — formulaire simplifié") —
  /// distincte de `createdAt` (horodatage de la déclaration elle-même, qui
  /// peut être postérieure de quelques jours au retour physique). Toujours
  /// `null` pour une déclaration via le formulaire détaillé (chaque
  /// `DepenseLigne` porte déjà sa propre date), même précédent que
  /// `Reglement.confirmeAt` (Ticket 9) pour la même distinction
  /// évènement-réel / horodatage-d'écriture.
  dateRetour DateTime?

  /// `true` uniquement pour un retour créé par l'Assistant Finance
  /// (`declarerRetourAssistantAction`, voir CLAUDE.md "L'Assistant Finance
  /// déclare les dépenses sur toute demande, retour ou pas") plutôt que par
  /// le collaborateur lui-même (`creerRetourCaisseAction`) — dans ce cas,
  /// `declarantId` porte l'id de l'Assistant, pas du collaborateur.
  /// Distingue les deux origines dans l'historique/l'affichage, jamais
  /// utilisé comme condition de calcul (`getDepensesDeclarees`/
  /// `getRetoursRecus`/etc. ne font aucune distinction).
  creeParAssistant Boolean @default(false)

  /// Renseigné UNIQUEMENT pour un retour créé par l'Assistant Finance sur
  /// une demande déjà `CLOTUREE` (Tâche "Réouverture exceptionnelle
  /// post-clôture pour retour de caisse oublié", voir CLAUDE.md) — motif
  /// obligatoire (min 10 caractères) justifiant cette correction
  /// exceptionnelle. `null` pour tout retour normal (déclaré par le
  /// collaborateur, ou par l'Assistant sur une demande NON clôturée). Sa
  /// seule présence autorise `receptionnerRetourAction` à s'exécuter
  /// malgré le statut `CLOTUREE` de la demande — aucune autre action
  /// (validation, règlement, catégorisation, clôture) n'est réactivée par
  /// ce champ.
  motifReouvertureExceptionnelle String?
}

/// Une ligne de dépense détaillée d'un `RetourCaisse` (cahier des charges
/// section 8-9) : remplace l'ancien montant dépensé agrégé unique du
/// Ticket 5 — une dépense réelle par ligne (montant, objet, date, nature,
/// justificatif, commentaire), pas un total.
model DepenseLigne {
  id            String            @id @default(cuid())
  montant       Decimal           @db.Decimal(14, 2)
  objet         String
  date          DateTime
  nature        String?
  justification TypeJustification
  commentaire   String?

  /// Motif obligatoire saisi par Finance quand ELLE marque cette ligne
  /// `SANS_PIECE` en traitant le retour (`marquerDepenseNonJustifieeAction`)
  /// — distinct de `commentaire`, qui reste la justification donnée par le
  /// collaborateur déclarant (obligatoire de son côté si SANS_PIECE dès la
  /// déclaration). `null` tant que Finance n'est jamais intervenue sur
  /// cette ligne, y compris si le collaborateur l'a lui-même déclarée
  /// SANS_PIECE. Jamais réinitialisé automatiquement : voir
  /// `marquerDepenseNonJustifieeAction` pour la seule écriture possible.
  motifNonJustifie      String?
  motifNonJustifiePar   User?     @relation("MotifNonJustifiePar", fields: [motifNonJustifieParId], references: [id])
  motifNonJustifieParId String?
  motifNonJustifieAt    DateTime?

  retourCaisseId String
  retourCaisse   RetourCaisse @relation(fields: [retourCaisseId], references: [id])

  /// Pièce jointe optionnelle (une par ligne — voir `PieceJointe.depenseLigneId`,
  /// côté 1:1 unique). Champ virtuel (aucune colonne ici) : la relation
  /// inverse de `PieceJointe.depenseLigne`.
  pieceJointe PieceJointe?

  createdAt DateTime @default(now())
}

/// Section 13 du cahier des charges (traçabilité) : chaque écriture doit
/// pouvoir répondre à "quelle demande concernée" et "quel utilisateur" —
/// `demandeId` remonte depuis le `Reglement`/`RetourCaisse` d'origine
/// (via `refId`) au moment de la création de l'écriture (jamais recalculé
/// après coup), `userId` est l'utilisateur qui a déclenché l'opération
/// précise (auteur du règlement pour une SORTIE, `receptionneParId` pour
/// une ENTRÉE de retour, l'utilisateur ayant annulé pour une ENTRÉE
/// compensatoire d'annulation).
model JournalCaisse {
  id        String   @id @default(cuid())
  type      String
  montant   Decimal  @db.Decimal(14, 2)
  source    String
  refId     String
  createdAt DateTime @default(now())

  /// Date RÉELLE de l'opération, quand elle diverge de `createdAt` (date de
  /// saisie dans le portail) — voir CLAUDE.md "Nouvelle alimentation de
  /// caisse". `null` pour toutes les autres sources (règlement, retour,
  /// solde d'ouverture), où `createdAt` fait foi.
  dateOperation DateTime?

  /// Nullable depuis "Solde d'ouverture de caisse" (voir CLAUDE.md) :
  /// toutes les écritures avant cette phase portaient une demande réelle
  /// (règlement/retour), mais une écriture `source = "solde_ouverture"` /
  /// "correction_solde_ouverture" / "annulation_solde_ouverture" ne se
  /// rattache à AUCUNE demande — le seul cas de mouvement de caisse sans
  /// demande d'origine.
  demandeId String?
  demande   Demande? @relation(fields: [demandeId], references: [id])

  userId String
  user   User   @relation("JournalCaisseUser", fields: [userId], references: [id])

  /// Pièce jointe obligatoire pour une écriture du cycle "solde
  /// d'ouverture" (voir CLAUDE.md "Pièce jointe obligatoire sur le solde
  /// d'ouverture") — champ virtuel (aucune colonne ici), relation inverse
  /// de `PieceJointe.journalCaisse`. Jamais renseigné pour les autres
  /// sources (règlement, retour) : ce grand livre reste par ailleurs
  /// immuable, aucune écriture n'est jamais éditée pour y ajouter une
  /// pièce a posteriori.
  pieceJointe PieceJointe?
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("Service")
}

// ============================================================
// MODULE 2 — POINTAGE RH
// ============================================================

enum TypePointage {
  ARRIVEE
  DEPART
}

enum SourcePointage {
  QR_CODE
  ORDINATEUR
  RH_EXCEPTIONNEL
  /// Pointage validé par géolocalisation GPS (fallback hors réseau Wi-Fi)
  GEOLOCALISATION
}

enum StatutAbsence {
  A_CONTROLER
  CONFIRMEE
  JUSTIFIEE
}

model ParametrageHoraire {
  id                    String   @id @default(cuid())
  heureDebutMatin       String
  heureFinMatin         String
  heureDebutApresMidi   String
  heureFinApresMidi     String
  isActive              Boolean  @default(true)
  /// Activer le pointage par géolocalisation GPS comme fallback réseau
  geolocalisationActive Boolean  @default(false)
  /// Latitude GPS du bureau (point de référence pour le calcul de distance)
  bureauLatitude        Float?   @default(5.3628189)
  /// Longitude GPS du bureau
  bureauLongitude       Float?   @default(-3.9374753)
  /// Rayon autorisé en mètres autour du bureau (min: 30, max: 200, défaut: 50)
  rayonAutorise         Int      @default(50)
  updatedAt             DateTime @updatedAt
}

model Pointage {
  id                String         @id @default(cuid())
  type              TypePointage
  source            SourcePointage
  heure             DateTime
  heurePrevue       String?
  estRetard         Boolean        @default(false)
  minutesRetard     Int?
  estDepartAnticipe Boolean        @default(false)
  motif             String?
  ipAddress         String?

  /// Latitude GPS du collaborateur au moment du pointage (mode géoloc)
  geoLatitude  Float?
  /// Longitude GPS du collaborateur au moment du pointage (mode géoloc)
  geoLongitude Float?
  /// Précision GPS en mètres fournie par le navigateur
  geoPrecision Float?
  /// Distance calculée en mètres entre le collaborateur et le bureau
  geoDistance  Int?

  userId String
  user   User   @relation("PointageEmploye", fields: [userId], references: [id])

  effectueParId String?
  effectuePar   User?   @relation("PointageEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())

  corrections CorrectionPointage[]

  @@index([userId, heure])
}

model CorrectionPointage {
  id             String @id @default(cuid())
  ancienneValeur String
  nouvelleValeur String
  motif          String

  pointageId String
  pointage   Pointage @relation(fields: [pointageId], references: [id])

  effectueParId String
  effectuePar   User   @relation("CorrectionEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())
}

model Absence {
  id     String        @id @default(cuid())
  date   DateTime
  statut StatutAbsence @default(A_CONTROLER)
  motif  String?

  userId String
  user   User   @relation("AbsenceEmploye", fields: [userId], references: [id])

  controleParId String?
  controlePar   User?   @relation("AbsenceControlePar", fields: [controleParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model JourFerie {
  id        String   @id @default(cuid())
  date      DateTime @unique
  libelle   String
  createdAt DateTime @default(now())
}

enum SourceAbsenceAutorisee {
  PERMISSION
  CONGE
}

/// V2: Permissions et Congés créent une plage d'absence autorisée.
/// Le calcul de retard et le CRON tiendront compte de ces plages.
model PlageAbsenceAutorisee {
  id          String                 @id @default(cuid())
  date        DateTime
  heureDebut  String // ex: "08:00"
  heureFin    String // ex: "12:00"
  source      SourceAbsenceAutorisee
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ============================================================
// FEEDBACKAPP — messages constructifs anonymes sur un employé
// ============================================================
//
// RÈGLE ABSOLUE, PRIORITAIRE SUR TOUT LE RESTE (voir CLAUDE.md "FeedbackApp
// : anonymat total") : AUCUNE colonne ne doit JAMAIS être ajoutée à
// `Feedback` pour identifier l'auteur d'un message, sous quelque forme que
// ce soit — ni id, ni IP, ni session, ni empreinte navigateur, ni horodatage
// précis. Toute évolution future de ce modèle doit être relue au regard de
// cette règle avant d'être ajoutée.

enum FeedbackSource {
  /// Soumis depuis la page publique, sans compte (n'importe qui).
  PUBLIC
  /// Soumis par un employé connecté au portail (Tranche B, pas encore
  /// implémentée à ce stade — la colonne existe déjà pour éviter une
  /// migration supplémentaire plus tard).
  INTERNAL
}

/// Nature de l'avis — détermine sa visibilité (voir CLAUDE.md "FeedbackApp
/// — notation structurée") : `COLLABORATION` est toujours PRIVÉ (visible
/// uniquement du destinataire et des comptes `feedback.moderer`),
/// `CONDITIONS_TRAVAIL` est toujours PUBLIC. Orthogonal à `FeedbackSource`
/// (qui distingue QUI a soumis — anonyme ou employé connecté), jamais
/// confondu : la visibilité dépend de `type`, jamais de `source`.
enum FeedbackType {
  /// Avis sur un collaborateur nommé (`recipientId` obligatoire) — privé.
  COLLABORATION
  /// Avis sur les conditions de travail générales de l'entreprise
  /// (`recipientId` toujours `null`, aucun destinataire) — public.
  CONDITIONS_TRAVAIL
}

model Feedback {
  id String @id @default(uuid())

  /// 20 à 500 caractères, revalidé côté serveur (zod) à chaque écriture —
  /// aucune contrainte de longueur au niveau de la colonne elle-même,
  /// cohérent avec le reste du projet (toute validation de format/longueur
  /// vit en zod, jamais dans une contrainte SQL). Depuis l'introduction de
  /// la notation structurée, ce texte n'est JAMAIS tapé librement par
  /// l'utilisateur : généré côté serveur à partir de `ratings` (voir
  /// `generateFeedbackComment`, `backend/src/feedback-comment.ts`) —
  /// défense supplémentaire contre l'identification par style d'écriture.
  content String

  /// Nullable : obligatoire pour `type: COLLABORATION`, toujours `null`
  /// pour `type: CONDITIONS_TRAVAIL` (avis sur l'entreprise en général,
  /// aucun destinataire) — revalidé côté serveur selon `type` à chaque
  /// écriture, jamais une simple convention.
  recipientId String?
  /// Réutilise le `User` existant du portail — AUCUNE nouvelle table
  /// "employees" séparée (voir CLAUDE.md).
  recipient   User?   @relation("FeedbackRecipient", fields: [recipientId], references: [id])

  source FeedbackSource

  /// `@default(COLLABORATION)` : préserve la validité des lignes déjà
  /// existantes (toutes des avis sur un collaborateur nommé, avant
  /// l'introduction de `CONDITIONS_TRAVAIL`) sans migration de données —
  /// voir CLAUDE.md "FeedbackApp — notation structurée".
  type FeedbackType @default(COLLABORATION)

  /// Réponses brutes structurées (clé de question → valeur), pour
  /// permettre des statistiques agrégées plus tard — en complément de
  /// `content` (le texte assemblé), jamais en remplacement. Nullable :
  /// `null` pour toute ligne antérieure à la notation structurée. RÈGLE
  /// ABSOLUE inchangée (voir plus haut) : ces clés/valeurs ne portent
  /// jamais, même indirectement, de donnée permettant de reconstituer
  /// l'auteur (uniquement des notes/choix sur des questions fixes,
  /// jamais un identifiant, une IP, un texte libre saisi par l'auteur).
  ratings Json?

  /// DATE SEULE — colonne SQL `DATE` (`@db.Date`), jamais `TIMESTAMP` :
  /// aucune heure/minute/seconde n'est physiquement stockable, contrainte
  /// posée au niveau du SCHÉMA plutôt que par simple convention
  /// applicative (défense en profondeur pour la règle d'anonymat — voir
  /// CLAUDE.md). Valeur du jour au moment de l'écriture (`DEFAULT
  /// CURRENT_DATE`), jamais recalculée ni modifiable après coup.
  submittedAt DateTime @default(now()) @db.Date

  isModerated     Boolean @default(false)
  /// Motif de la modération (ex: message retiré) — nullable, jamais
  /// obligatoire tant qu'`isModerated` est `false`.
  motifModeration String?

  /// Traçabilité de l'ACTION DE MODÉRATION elle-même (qui côté RH/DG a
  /// modéré, quand) — SANS RAPPORT avec l'auteur du message, dont
  /// l'anonymat reste total. Nullable : `null` tant que le message n'a
  /// jamais été modéré.
  moderatedById String?
  moderatedBy   User?     @relation("FeedbackModeratedBy", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?

  @@index([recipientId])
  @@index([source])
  @@index([isModerated])
  @@index([type])
}
