// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SOCLE PORTAIL
// ============================================================

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  /// Service/département de l'utilisateur (ex: "Commercial", "Finance",
  /// "Direction") — facultatif, utilisé comme axe de filtre par le
  /// reporting Trésorerie (Ticket 10). Simple champ texte libre en V1,
  /// pas de table de référence dédiée : le volume de services distincts
  /// reste faible pour une application interne.
  service      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  demandesCreees      Demande[]         @relation("DemandeCreateur")
  demandesBeneficiees Demande[]         @relation("DemandeBeneficiaire")
  reglementsFaits     Reglement[]       @relation("ReglementAuteur")
  retoursDeclares     RetourCaisse[]    @relation("RetourDeclarant")
  retoursReceptionnes RetourCaisse[]    @relation("RetourReceptionnaire")
  historique          HistoriqueEntry[]

  pointagesEffectues    Pointage[]           @relation("PointageEmploye")
  pointagesRealises     Pointage[]           @relation("PointageEffectuePar")
  correctionsEffectuees CorrectionPointage[] @relation("CorrectionEffectuePar")
  absencesDeclarees     Absence[]            @relation("AbsenceEmploye")
  absencesControlees    Absence[]            @relation("AbsenceControlePar")
}

model Role {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  users       User[]
  permissions RolePermission[]
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  label       String
  isActive    Boolean      @default(true)
  permissions Permission[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model HistoriqueEntry {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ============================================================
// MODULE 1 — TRÉSORERIE
// ============================================================

/// Refonte V1 (cahier des charges réécrit) : remplace l'ancien enum à 5
/// valeurs. Les statuts intermédiaires (PARTIELLEMENT_VALIDEE,
/// VALIDEE_NON_REGLEE, PARTIELLEMENT_REGLEE, REGLEE, EN_ATTENTE_REGULARISATION,
/// REGULARISEE) ne sont pas encore produits par la logique applicative
/// actuelle (celle-ci reste, pour l'instant, mappée sur les anciennes
/// transitions EN_ATTENTE_VALIDATION -> VALIDEE -> CLOTUREE — voir CLAUDE.md,
/// section "Refonte V1 en cours") : ils sont posés ici en fondation pour les
/// phases B à H (validation partielle, règlement adapté, régularisation).
enum StatutDemande {
  BROUILLON
  EN_ATTENTE_VALIDATION
  VALIDEE
  PARTIELLEMENT_VALIDEE
  VALIDEE_NON_REGLEE
  PARTIELLEMENT_REGLEE
  REGLEE
  REJETEE
  EN_ATTENTE_REGULARISATION
  REGULARISEE
  CLOTUREE
}

/// Type de bénéficiaire d'une Demande — distinct du Demandeur (créateur).
/// Rempli uniquement pour COLLABORATEUR/STAGIAIRE ayant un compte
/// (`beneficiaireUserId`) ; sinon le nom est saisi librement
/// (`beneficiaireNom`), y compris pour ENTREPRISE ("SIM ASSURANCES CI").
enum BeneficiaireType {
  COLLABORATEUR
  STAGIAIRE
  FOURNISSEUR
  ENTREPRISE
}

enum ModeReglement {
  CAISSE
  BANQUE
}

enum TypeJustification {
  FACTURE
  RECU
  TICKET
  SANS_PIECE
}

model Categorie {
  id       String    @id @default(cuid())
  label    String    @unique
  /// Soft-delete : une catégorie désactivée n'apparaît plus dans les
  /// sélecteurs de nouvelle catégorisation ni les filtres de reporting,
  /// mais reste affichée normalement sur les demandes qui la référencent
  /// déjà (jamais de suppression définitive — Categorie/Objet sont
  /// potentiellement référencés par des Demande existantes).
  isActive Boolean   @default(true)
  objets   Objet[]
  demandes Demande[]
}

model Objet {
  id          String    @id @default(cuid())
  label       String
  /// Voir Categorie.isActive — même principe de soft-delete.
  isActive    Boolean   @default(true)
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  demandes    Demande[]
}

model Demande {
  id          String        @id @default(cuid())
  reference   String        @unique
  /// Montant demandé (nom de champ conservé pour limiter la casse — voir
  /// CLAUDE.md "Refonte V1"). Distinct de `montantValide` ci-dessous.
  montant     Decimal       @db.Decimal(14, 2)
  description String
  commentaire String?
  statut      StatutDemande @default(EN_ATTENTE_VALIDATION)

  /// Cumul du montant validé à date — nul tant qu'aucune validation
  /// (même partielle) n'a eu lieu. Peut être mis à jour par plusieurs
  /// validations successives (validation complémentaire sur le reliquat,
  /// phase B "validation partielle" — pas encore implémentée).
  montantValide Decimal? @db.Decimal(14, 2)

  /// Bénéficiaire de la dépense, distinct du Demandeur (`createur`) — peut
  /// être différent (ex: le collaborateur demande pour un stagiaire, un
  /// fournisseur, ou l'entreprise elle-même).
  beneficiaireType   BeneficiaireType
  /// Renseigné uniquement si `beneficiaireType` = COLLABORATEUR ou
  /// STAGIAIRE ET que la personne a un compte dans le système.
  beneficiaireUserId String?
  beneficiaireUser   User?            @relation("DemandeBeneficiaire", fields: [beneficiaireUserId], references: [id])
  /// Renseigné si le bénéficiaire n'est pas un utilisateur du système
  /// (nom du fournisseur/prestataire, ou "SIM ASSURANCES CI" pour ENTREPRISE).
  beneficiaireNom    String?

  /// Concept Catégorie/Objet/Budget retiré du cahier des charges V1 —
  /// champs conservés en base (nullables, non utilisés par le flux
  /// principal) le temps de décider de leur sort avec le maître de stage.
  /// Voir CLAUDE.md "Refonte V1 en cours".
  categorieId      String?
  categorie        Categorie? @relation(fields: [categorieId], references: [id])
  objetId          String?
  objet            Objet?     @relation(fields: [objetId], references: [id])
  budgetDisponible Decimal?   @db.Decimal(14, 2)

  motifRejet   String?
  motifCloture String?

  createurId String
  createur   User   @relation("DemandeCreateur", fields: [createurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces     PieceJointe[]
  reglements Reglement[]
}

model PieceJointe {
  id        String   @id @default(cuid())
  url       String
  demandeId String
  demande   Demande  @relation(fields: [demandeId], references: [id])
  createdAt DateTime @default(now())
}

model Reglement {
  id              String        @id @default(cuid())
  montant         Decimal       @db.Decimal(14, 2)
  mode            ModeReglement
  estConfirme     Boolean       @default(false)
  estAnnule       Boolean       @default(false)
  motifAnnulation String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id])

  auteurId String
  auteur   User   @relation("ReglementAuteur", fields: [auteurId], references: [id])

  retours RetourCaisse[]

  createdAt  DateTime  @default(now())
  confirmeAt DateTime?
}

/// Fonds remis (cahier des charges sections 8-9, Phase D) : un retour de
/// caisse ne stocke plus un montant dépensé agrégé unique, mais une liste de
/// `DepenseLigne` détaillées.
model RetourCaisse {
  id String @id @default(cuid())
  /// CALCULÉ AUTOMATIQUEMENT, jamais saisi manuellement (voir
  /// `getMontantARetourner` dans src/lib/tresorerie.ts) : montant du
  /// règlement lié moins la somme des `DepenseLigne` déclarées. Choix
  /// documenté dans CLAUDE.md "Refonte V1 en cours" / Phase D — le cahier
  /// des charges (section 9.3 vs 9.5) est en tension entre "l'utilisateur
  /// enregistre un montant à retourner" et "le solde ne doit pas être
  /// modifiable manuellement" ; tranché en faveur du calcul automatique,
  /// cohérent avec le principe déjà appliqué au solde de caisse
  /// (`getSoldeCaisse`) qu'aucun solde financier ne se saisit à la main.
  montantARetourner Decimal        @db.Decimal(14, 2)
  estReceptionne    Boolean        @default(false)
  depenses          DepenseLigne[]

  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id])

  declarantId String
  declarant   User   @relation("RetourDeclarant", fields: [declarantId], references: [id])

  receptionneParId String?
  receptionnePar   User?   @relation("RetourReceptionnaire", fields: [receptionneParId], references: [id])

  createdAt     DateTime  @default(now())
  receptionneAt DateTime?
}

/// Une ligne de dépense détaillée d'un `RetourCaisse` (cahier des charges
/// section 8-9) : remplace l'ancien montant dépensé agrégé unique du
/// Ticket 5 — une dépense réelle par ligne (montant, objet, date, nature,
/// justificatif, commentaire), pas un total.
model DepenseLigne {
  id            String            @id @default(cuid())
  montant       Decimal           @db.Decimal(14, 2)
  objet         String
  date          DateTime
  nature        String?
  justification TypeJustification
  commentaire   String?

  retourCaisseId String
  retourCaisse   RetourCaisse @relation(fields: [retourCaisseId], references: [id])

  createdAt DateTime @default(now())
}

model JournalCaisse {
  id        String   @id @default(cuid())
  type      String
  montant   Decimal  @db.Decimal(14, 2)
  source    String
  refId     String
  createdAt DateTime @default(now())
}

// ============================================================
// MODULE 2 — POINTAGE RH
// ============================================================

enum TypePointage {
  ARRIVEE
  DEPART
}

enum SourcePointage {
  QR_CODE
  ORDINATEUR
  RH_EXCEPTIONNEL
}

enum StatutAbsence {
  A_CONTROLER
  CONFIRMEE
  JUSTIFIEE
}

model ParametrageHoraire {
  id                  String   @id @default(cuid())
  heureDebutMatin     String
  heureFinMatin       String
  heureDebutApresMidi String
  heureFinApresMidi   String
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model Pointage {
  id            String         @id @default(cuid())
  type          TypePointage
  source        SourcePointage
  heure         DateTime
  estRetard     Boolean        @default(false)
  minutesRetard Int?
  motif         String?

  userId String
  user   User   @relation("PointageEmploye", fields: [userId], references: [id])

  effectueParId String?
  effectuePar   User?   @relation("PointageEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())

  corrections CorrectionPointage[]
}

model CorrectionPointage {
  id             String @id @default(cuid())
  ancienneValeur String
  nouvelleValeur String
  motif          String

  pointageId String
  pointage   Pointage @relation(fields: [pointageId], references: [id])

  effectueParId String
  effectuePar   User   @relation("CorrectionEffectuePar", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())
}

model Absence {
  id     String        @id @default(cuid())
  date   DateTime
  statut StatutAbsence @default(A_CONTROLER)
  motif  String?

  userId String
  user   User   @relation("AbsenceEmploye", fields: [userId], references: [id])

  controleParId String?
  controlePar   User?   @relation("AbsenceControlePar", fields: [controleParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
