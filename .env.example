# ==================================================================
# PORTAIL SIM ASSURANCES — VARIABLES D'ENVIRONNEMENT (.env.example)
# ==================================================================
# Copiez ce fichier vers ".env" (jamais commité — voir .gitignore) et
# remplissez les valeurs avant de lancer le projet, que ce soit en
# développement local (`npm run dev`) ou via Docker Compose.
#
# Docker Compose lit AUTOMATIQUEMENT un fichier ".env" placé à la racine du
# projet pour interpoler les variables ${...} de docker-compose.yml — c'est
# donc le MÊME fichier ".env" qui sert aux deux usages (dev local direct et
# `docker compose up`), pas la peine d'en maintenir deux séparés.

# ------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------

# Dev local direct (npm run dev, sans Docker) : chaîne de connexion complète
# vers votre PostgreSQL local.
#   DATABASE_URL="postgresql://user:password@localhost:5432/sim_portail"
#
# Avec Docker Compose : DATABASE_URL est calculée automatiquement par
# docker-compose.yml à partir de POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB ci-dessous (pointant vers le service "db", jamais
# "localhost") — inutile de la définir ici dans ce cas, sauf si vous
# lancez aussi des commandes Prisma en dehors des conteneurs (ex:
# `npx prisma studio` depuis votre machine, via un port exposé de "db").
DATABASE_URL=

# Utilisés uniquement par docker-compose.yml, pour construire DATABASE_URL
# côté conteneur "app" et initialiser le conteneur "db" (POSTGRES_USER/
# POSTGRES_DB ont une valeur par défaut "sim_portail" si absents ;
# POSTGRES_PASSWORD est OBLIGATOIRE, Compose refuse de démarrer sans elle).
POSTGRES_USER=sim_portail
POSTGRES_PASSWORD=
POSTGRES_DB=sim_portail

# ------------------------------------------------------------------
# 2. Authentification & Sécurité (Auth.js / NextAuth v5)
# ------------------------------------------------------------------

# Secret de signature des JWT et sessions — OBLIGATOIRE en production.
#
# ATTENTION : ne réutilisez JAMAIS le secret de développement local pour la
# production. Générez un secret dédié, robuste, différent pour chaque
# environnement (dev/staging/prod) :
#   openssl rand -base64 32
# (ou sous Node : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# URL publique de l'application. En développement local direct, Auth.js
# déduit l'URL depuis l'hôte de la requête. Avec Docker Compose ou un proxy
# inverse (Nginx, Traefik), recommandé pour garantir des redirections exactes.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------
# 3. Tâches Planifiées (CRON) & Rattrapage des Absences
# ------------------------------------------------------------------

# Jeton secret protégeant les routes CRON du portail (ex: /api/cron/absences).
# Tout appel externe (service cron hébergeur, Vercel Cron, GitHub Actions, curl)
# DOIT inclure l'en-tête HTTP : `Authorization: Bearer <CRON_SECRET>`.
# En l'absence de ce header valide, la route renvoie un statut 401 Unauthorized.
# Exemple pour générer un jeton : openssl rand -hex 24
CRON_SECRET=

# Date de démarrage officiel du système de pointage (format AAAA-MM-JJ).
# Valeur par défaut dans le code : "2026-09-07".
# Cette date borne le rattrapage automatique des absences : aucun collaborateur
# ne sera marqué comme absent pour les jours antérieurs à cette date charnière.
SYSTEM_START_DATE=2026-09-07

# ------------------------------------------------------------------
# 4. Pointage de Présence & Réseau Entreprise
# ------------------------------------------------------------------

# Liste d'adresses IP publiques ou sous-réseaux autorisés pour certifier
# que le collaborateur pointe depuis les locaux de SIM Assurances (séparées par des virgules).
# Ex: ALLOWED_OFFICE_IPS="197.234.218.10,160.155.0.0/24"
# Si vide ou non défini, le système autorise le réseau local de dev ou bascule
# automatiquement en mode géolocalisation GPS selon le paramétrage actif.
ALLOWED_OFFICE_IPS=

# ------------------------------------------------------------------
# 5. Service de Messagerie (SMTP)
# ------------------------------------------------------------------

# Configuration SMTP pour l'envoi des courriels (réinitialisation de mot de passe,
# invitations nouveaux collaborateurs, alertes et notifications).
#
# SI CES VARIABLES SONT LAISSÉES VIDES :
# Le portail fonctionne en mode SIMULATION (dev) :
# - Aucun crash du serveur.
# - Le contenu du mail et le lien direct sont affichés dans les logs console.
# - Une notification interne est créée dans le portail pour tester en 1 clic.
#
# POUR ACTIVER L'ENVOI RÉEL :
# Renseignez les identifiants SMTP de votre messagerie institutionnelle
# (ex: Microsoft 365, Google Workspace, cPanel ou serveur dédié SIM Assurances) :
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIM Assurances <noreply@sim-assurances.ci>"
SMTP_SECURE=false

# ------------------------------------------------------------------
# 6. Compte Super-Administrateur Initial (Optionnel / Script seed)
# ------------------------------------------------------------------

# Utilisé par le script `npm run set-admin` (ou `backend/prisma/set-admin.ts`)
# pour provisionner ou mettre à jour un compte administrateur d'amorçage.
ADMIN_EMAIL=admin@sim-assurances.ci
ADMIN_PASSWORD=
ADMIN_NAME="Administrateur SIM"
