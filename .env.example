# Copiez ce fichier vers ".env" (jamais commité — voir .gitignore) et
# remplissez les valeurs avant de lancer le projet, que ce soit en
# développement local (`npm run dev`) ou via Docker Compose.
#
# Docker Compose lit AUTOMATIQUEMENT un fichier ".env" placé à la racine du
# projet pour interpoler les variables ${...} de docker-compose.yml — c'est
# donc le MÊME fichier ".env" qui sert aux deux usages (dev local direct et
# `docker compose up`), pas la peine d'en maintenir deux séparés.

# ------------------------------------------------------------------
# Base de données
# ------------------------------------------------------------------

# Dev local direct (npm run dev, sans Docker) : connexion complète vers
# votre PostgreSQL local.
#   DATABASE_URL="postgresql://user:password@localhost:5432/sim_portail"
#
# Avec Docker Compose : DATABASE_URL est calculée automatiquement par
# docker-compose.yml à partir de POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB ci-dessous (pointant vers le service "db", jamais
# "localhost") — inutile de la définir ici dans ce cas, sauf si vous
# lancez aussi des commandes Prisma en dehors des conteneurs (ex:
# `npx prisma studio` depuis votre machine, via un port exposé de "db").
DATABASE_URL=

# Utilisés uniquement par docker-compose.yml, pour construire DATABASE_URL
# côté conteneur "app" et initialiser le conteneur "db" (POSTGRES_USER/
# POSTGRES_DB ont une valeur par défaut "sim_portail" si absents ;
# POSTGRES_PASSWORD est OBLIGATOIRE, Compose refuse de démarrer sans elle).
POSTGRES_USER=sim_portail
POSTGRES_PASSWORD=
POSTGRES_DB=sim_portail

# ------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ------------------------------------------------------------------

# Secret de signature des JWT de session — OBLIGATOIRE, Compose refuse de
# démarrer le conteneur "app" sans elle.
#
# ATTENTION : ne réutilisez JAMAIS le secret de développement local pour la
# production. Générez un secret dédié, robuste, différent pour chaque
# environnement (dev/staging/prod) :
#   openssl rand -base64 32
# (ou, sans openssl : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# URL publique de l'application. En développement local direct, inutile
# (Auth.js déduit l'URL depuis la requête). Avec Docker Compose, recommandé
# pour éviter des soucis de redirection derrière le mappage de port —
# ajustez si l'app est servie sur un autre domaine/port en production.
AUTH_URL=http://localhost:3000
